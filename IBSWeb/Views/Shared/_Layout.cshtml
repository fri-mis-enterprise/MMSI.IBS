@using IBS.Services.AccessControl
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IAccessControlService AccessControl

@{
    var selectedCompany = string.Empty;

    if (SignInManager.IsSignedIn(User))
    {
        selectedCompany = User.Claims.FirstOrDefault(c => c.Type == "Company")?.Value;
    }

    var userName = UserManager.GetUserName(User);
    var userId = UserManager.GetUserId(User);

    ViewBag.AppVersion = "2.1.4"; // Incrementing version for the layout update

    // Helper function to check if user has MSAP access
    async Task<bool> HasMsapAccess()
    {
        if (string.IsNullOrEmpty(userId)) return false;
        return await AccessControl.HasMsapAccessAsync(userId);
    }

    // Helper function to check MSAP Import access
    async Task<bool> HasMsapImportAccess()
    {
        if (string.IsNullOrEmpty(userId)) return false;
        return await AccessControl.HasMsapImportAccessAsync(userId);
    }

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IBS</title>
    <link id="favicon-light" href="/svg/ibs-icon-black.svg" rel="shortcut icon" type="image/svg+xml" />
    <link id="favicon-dark" href="/svg/ibs-icon-white.svg" rel="shortcut icon" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css">
    <link rel="stylesheet" href="~/IBSWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" /> <!--Select2 plug ins-->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.1/css/dataTables.dataTables.css" /> <!--Data tables plug ins-->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/buttons/2.1.0/css/buttons.dataTables.min.css"> <!-- DataTables Buttons CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/select/3.1.3/css/select.dataTables.css" /><!--Data table pug-in-->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <!-- Modern Redesign Dependencies -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Hanken+Grotesk:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/modern-ui.css" asp-append-version="true" />

    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            vertical-align: middle;
        }
    </style>

    @if (SignInManager.IsSignedIn(User))
    {
        <link rel="stylesheet" href="~/css/quick-access-sidebar.css" asp-append-version="true" />
        <script src="~/js/quick-access-sidebar.js" asp-append-version="true" defer></script>
    }
</head>
<body data-selected-company="@selectedCompany">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3 fixed-top">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/svg/ibs-logo-white.svg" class="ms-4" alt="IBSWeb" width="45" height="45"/>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="User" asp-controller="Home" asp-action="Index">Home</a>
                            </li>

                            @if (!User.IsInRole("PortCoordinator"))
                                {
                                    @if (await HasMsapAccess())
                                    {
                                        <li class="nav-item dropdown">
                                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">MSAP</a>
                                            <ul class="dropdown-menu">
                                                <li class="nav-item">
                                                    <a class="dropdown-item text-dark" asp-area="User" title="Manage Job Orders" asp-controller="JobOrder" asp-action="Index">Job Orders</a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li class="nav-item">
                                                    <a class="dropdown-item text-dark" title="Create, Tariff, and Approve Dispatch Tickets" asp-area="User" asp-controller="DispatchTicket" asp-action="Index">Dispatch Tickets</a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li class="nav-item">
                                                    <a class="dropdown-item text-dark" asp-area="User" title="Dispatch Ticket Billings" asp-controller="Billing" asp-action="Index">Billing</a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li class="nav-item">
                                                    <a class="dropdown-item text-dark" asp-area="User" title="Billing Collection" asp-controller="Collection" asp-action="Index">Collection</a>
                                                </li>
                                                @if (await HasMsapImportAccess())
                                                {
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li class="nav-item">
                                                        <a class="dropdown-item text-dark" asp-area="User" title="MSAP Data Import" asp-controller="MsapImport" asp-action="Index">MSAP Import</a>
                                                    </li>
                                                }
                                                <li><hr class="dropdown-divider"></li>
                                                <li class="nav-item">
                                                    <a class="dropdown-item text-dark" asp-area="User" title="Vessel Arrival Planning & Resource Scheduling" asp-controller="VesselPlanning" asp-action="Index">Vessel Planning</a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li class="nav-item">
                                                    <a class="dropdown-item text-dark" asp-area="User" title="Tugboat Monitoring & Scheduling" asp-controller="TugboatMonitoring" asp-action="Index">Tugboat Monitoring</a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li class="nav-item">
                                                    <a class="dropdown-item text-dark" asp-area="User" asp-controller="MaritimeReport" asp-action="Index"> MMSI Reports</a>
                                                </li>
                                            </ul>
                                        </li>
                                    }
                                }

                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Master File</a>
                                        <ul class="dropdown-menu">
                                            <li><h6 class="dropdown-header">General</h6></li>
                                            <li><a class="dropdown-item text-dark" asp-area="Admin" asp-controller="User" asp-action="Index">User</a></li>
                                            <li><a class="dropdown-item text-dark" asp-area="Admin" asp-controller="AppRole" asp-action="Index">Role</a></li>
                                            <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="Employee" asp-action="Index">Employee</a></li>
                                            <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="UserAccess" asp-action="Index">User Access</a></li>

                                            <li><hr class="dropdown-divider"></li>
                                            <li><h6 class="dropdown-header">Accounting</h6></li>
                                            <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="ChartOfAccount" asp-action="Index">Chart of Accounts</a></li>
                                            <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="PaymentTerms" asp-action="Index">Payment Terms</a></li>
                                            <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="BankAccount" asp-action="Index">Bank Account</a></li>
                                        </ul>
                                    </li>
                                }

                            @if (await HasMsapAccess())
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">MSAP References</a>
                                    <ul class="dropdown-menu" style="max-height: 80vh; overflow-y: auto;">
                                        <li><h6 class="dropdown-header">Maritime & MSAP</h6></li>
                                        <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="MaritimeService" asp-action="Index"> Activities/Services</a></li>
                                        <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="Port" asp-action="Index"> Ports</a></li>
                                        <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="Principal" asp-action="Index"> Principals</a></li>
                                        <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="TariffRate" asp-action="Index"> Tariff Rates</a></li>
                                        <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="Terminal" asp-action="Index"> Terminals</a></li>
                                        <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="TugMaster" asp-action="Index"> Tug Masters</a></li>
                                        <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="TugboatOwner" asp-action="Index"> Tugboat Company/Owner</a></li>
                                        <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="Tugboat" asp-action="Index"> Tugboats</a></li>
                                        <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="Vessel" asp-action="Index"> Vessels</a></li>

                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">Sales & MSAP</h6></li>
                                        <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="Customer" asp-action="Index">Customer</a></li>
                                        <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="Supplier" asp-action="Index">Supplier</a></li>
                                        <li><a class="dropdown-item text-dark" asp-area="User" asp-controller="Service" asp-action="Index">Service</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                        <!-- Notification Icon and Dropdown -->
                        <div class="nav-item dropdown ms-auto">
                            <a href="@Url.Action("Index", "Notification", new { area = "User" })" class="nav-link text-light position-relative">
                                <i class="bi bi-bell-fill"></i>
                                <span id="notificationCount" class="badge bg-danger position-absolute top-0 start-100 translate-middle">0</span>
                            </a>
                        </div>
                        <partial name="_LoginPartial" />
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="@(ViewData["IsFullWidth"] is true ? "container-fluid p-0" : "container")" style="padding-top:5rem !important">
        <main role="main">
            <input type="hidden" id="hfUsername" value="@userName" />
            @RenderBody()
        </main>
    </div>

    <footer b-q5eydxz0xc class="border-top footer bg-primary text-light">
        <div class="container text-center">
            &copy; 2024 - MMSI <i class="bi bi-r-circle"></i> &middot; @($"v{ViewBag.AppVersion}")
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script><!--select 2 scripts-->
    <script src="https://cdn.datatables.net/2.0.1/js/dataTables.js"></script><!--data tables scripts-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script><!--sweet alert scripts-->
    <script src="~/js/modern-alert.js" asp-append-version="true"></script>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/notification.js"></script>
    <script src="~/js/spinner.js"></script>
    <script src="~/js/modern-select.js" asp-append-version="true"></script>
    <script src="~/js/modern-table.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/select/3.1.3/js/dataTables.select.js"></script>
    <script src="https://cdn.datatables.net/select/3.1.3/js/select.dataTables.js"></script>

    <!-- Notification partial (must be after SweetAlert2) -->
    <partial name="_Notification" />

    @await RenderSectionAsync("Scripts", required: false)
    <script>
    $(document).ready(function () {
        // Check if the user is logged in
        if ($('#hfUsername').length && $('#hfUsername').val() !== "") {
            // Function to fetch and update notification count
            function updateNotificationCount() {
                $.ajax({
                    url: '@Url.Action("GetNotificationCount", "Notification", new { area = "User" })',
                    type: 'GET',
                    success: function (count) {
                        $('#notificationCount').text(count);
                    },
                    error: function () {
                        console.error("Error fetching notification count");
                    }
                });
            }

            // Initial load
            updateNotificationCount();

            // Optional: Poll every 30 seconds to update count
            setInterval(updateNotificationCount, 30000); // 30,000 ms = 30 seconds
        }
    });
    </script>
    <script>
        const darkModeMediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

        function updateFavicon(e) {
            const faviconLight = document.getElementById('favicon-light');
            const faviconDark = document.getElementById('favicon-dark');

            if (e.matches) {
                faviconDark.rel = 'shortcut icon';
                faviconLight.rel = '';
            } else {
                faviconDark.rel = '';
                faviconLight.rel = 'shortcut icon';
            }
        }

        // Initial check
        updateFavicon(darkModeMediaQuery);

        // Listen for changes
        darkModeMediaQuery.addEventListener('change', updateFavicon);
    </script>
</body>
</html>
