@* _ModernNavbar.cshtml
   Opt-in modern mega-menu navbar partial.
   Rendered in _Layout.cshtml alongside the classic Bootstrap navbar.
   Visibility is controlled by modern-navbar.js + localStorage.
   This partial assumes the same @inject / @using context as _Layout.cshtml.
*@
@using IBS.Models.Enums
@using IBS.Services.AccessControl
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IAccessControlService AccessControl

@{
    var userName   = UserManager.GetUserName(User);
    var userId     = UserManager.GetUserId(User);
    var company    = User.Claims.FirstOrDefault(c => c.Type == "Company")?.Value ?? string.Empty;
    var stationCode = User.Claims.FirstOrDefault(c => c.Type == "StationCode")?.Value ?? string.Empty;

    async Task<bool> ModernHasMsapAccess()
    {
        if (string.IsNullOrEmpty(userId)) return false;
        return await AccessControl.HasAnyAccessAsync(userId,
            ProcedureEnum.CreateDispatchTicket,
            ProcedureEnum.EditDispatchTicket,
            ProcedureEnum.DeleteDispatchTicket,
            ProcedureEnum.SetTariff,
            ProcedureEnum.ApproveTariff,
            ProcedureEnum.CreateBilling,
            ProcedureEnum.CreateCollection,
            ProcedureEnum.CreateJobOrder,
            ProcedureEnum.EditJobOrder,
            ProcedureEnum.DeleteJobOrder,
            ProcedureEnum.CloseJobOrder);
    }

    async Task<bool> ModernHasMsapImportAccess()
    {
        if (string.IsNullOrEmpty(userId)) return false;
        return await AccessControl.HasMsapImportAccessAsync(userId);
    }

    async Task<bool> ModernHasServiceRequestAccess()
    {
        if (string.IsNullOrEmpty(userId)) return false;
        return await AccessControl.HasServiceRequestAccessAsync(userId);
    }
}

<!-- Modern Navbar (opt-in) — hidden by default; JS activates via localStorage -->
<div id="mnav-overlay"></div>
<header id="modern-navbar" role="banner" aria-label="Modern navigation">

    <!-- ── Brand ── -->
    <a class="mnav-brand" asp-area="" asp-controller="Home" asp-action="Index">
        <img src="~/svg/ibs-logo-white.svg" alt="IBS" />
    </a>

    @if (SignInManager.IsSignedIn(User))
    {
        <!-- ── Desktop navigation ── -->
        <nav class="mnav-nav-area" aria-label="Main menu">
            <ul class="mnav-list" role="menubar">

                <!-- Home -->
                <li class="mnav-item" role="none">
                    <a class="mnav-trigger"
                       asp-area="User" asp-controller="Home" asp-action="Index"
                       role="menuitem">
                        Home
                    </a>
                </li>

                @if (!User.IsInRole("PortCoordinator") && await ModernHasMsapAccess())
                {
                    <!-- MSAP mega menu -->
                    <li class="mnav-item" data-mega role="none">
                        <button class="mnav-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
                            MSAP
                            <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
                        </button>
                        <div class="mnav-mega" style="--mnav-cols:2; min-width:480px;" role="menu">
                            <div class="mnav-mega-grid">
                                <!-- Col 1 -->
                                <div>
                                    <div class="mnav-section-label">Operations</div>
                                    <div class="mnav-link-list">
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="JobOrder" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">assignment</span>
                                            <div>
                                                <div class="mnav-link-title">Job Orders</div>
                                                <div class="mnav-link-sub">Create &amp; track job orders</div>
                                            </div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="DispatchTicket" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">confirmation_number</span>
                                            <div>
                                                <div class="mnav-link-title">Dispatch Tickets</div>
                                                <div class="mnav-link-sub">Tariff &amp; approval workflow</div>
                                            </div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="Billing" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">receipt_long</span>
                                            <div>
                                                <div class="mnav-link-title">Billing</div>
                                                <div class="mnav-link-sub">Dispatch ticket invoices</div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                                <!-- Col 2 -->
                                <div>
                                    <div class="mnav-section-label">Finance &amp; Reports</div>
                                    <div class="mnav-link-list">
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="Collection" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">payments</span>
                                            <div>
                                                <div class="mnav-link-title">Collection</div>
                                                <div class="mnav-link-sub">Billing payments</div>
                                            </div>
                                        </a>
                                        @if (await ModernHasMsapImportAccess())
                                        {
                                            <a class="mnav-mega-link"
                                               asp-area="User" asp-controller="MsapImport" asp-action="Index"
                                               role="menuitem">
                                                <span class="material-symbols-outlined">upload_file</span>
                                                <div>
                                                    <div class="mnav-link-title">MSAP Import</div>
                                                    <div class="mnav-link-sub">Bulk data ingestion</div>
                                                </div>
                                            </a>
                                        }
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="MaritimeReport" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">analytics</span>
                                            <div>
                                                <div class="mnav-link-title">MMSI Reports</div>
                                                <div class="mnav-link-sub">Analytics &amp; exports</div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                }

                @if (await ModernHasServiceRequestAccess())
                {
                    <li class="mnav-item" role="none">
                        <a class="mnav-trigger"
                           asp-area="User" asp-controller="ServiceRequest" asp-action="Index"
                           title="Submit and track your service requests"
                           role="menuitem">
                            Service Requests
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <!-- Master File mega menu -->
                    <li class="mnav-item" data-mega role="none">
                        <button class="mnav-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
                            Master File
                            <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
                        </button>
                        <div class="mnav-mega" style="--mnav-cols:2; min-width:480px;" role="menu">
                            <div class="mnav-mega-grid">
                                <div>
                                    <div class="mnav-section-label">Users &amp; Access</div>
                                    <div class="mnav-link-list">
                                        <a class="mnav-mega-link"
                                           asp-area="Admin" asp-controller="User" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">person</span>
                                            <div>
                                                <div class="mnav-link-title">User</div>
                                                <div class="mnav-link-sub">Manage accounts</div>
                                            </div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="Admin" asp-controller="AppRole" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">security</span>
                                            <div>
                                                <div class="mnav-link-title">Role</div>
                                                <div class="mnav-link-sub">Define permissions</div>
                                            </div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="UserAccess" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">key</span>
                                            <div>
                                                <div class="mnav-link-title">User Access</div>
                                                <div class="mnav-link-sub">Module restrictions</div>
                                            </div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="Employee" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">badge</span>
                                            <div>
                                                <div class="mnav-link-title">Employee</div>
                                                <div class="mnav-link-sub">Staff records</div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                                <div>
                                    <div class="mnav-section-label">Accounting</div>
                                    <div class="mnav-link-list">
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="ChartOfAccount" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">account_balance</span>
                                            <div>
                                                <div class="mnav-link-title">Chart of Accounts</div>
                                                <div class="mnav-link-sub">Ledgers &amp; Journals</div>
                                            </div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="PaymentTerms" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">schedule</span>
                                            <div>
                                                <div class="mnav-link-title">Payment Terms</div>
                                                <div class="mnav-link-sub">Terms &amp; conditions</div>
                                            </div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="BankAccount" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">account_balance_wallet</span>
                                            <div>
                                                <div class="mnav-link-title">Bank Account</div>
                                                <div class="mnav-link-sub">Bank &amp; payment profiles</div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                }

                @if (await ModernHasMsapAccess())
                {
                    <!-- MSAP References mega menu -->
                    <li class="mnav-item" data-mega role="none">
                        <button class="mnav-trigger" role="menuitem" aria-haspopup="true" aria-expanded="false">
                            MSAP References
                            <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
                        </button>
                        <div class="mnav-mega" style="--mnav-cols:2; min-width:560px;" role="menu">
                            <div class="mnav-mega-grid">
                                <div>
                                    <div class="mnav-section-label">Maritime &amp; MSAP</div>
                                    <div class="mnav-link-list">
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="MaritimeService" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">anchor</span>
                                            <div><div class="mnav-link-title">Activities / Services</div></div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="Port" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">location_city</span>
                                            <div><div class="mnav-link-title">Ports</div></div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="Principal" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">corporate_fare</span>
                                            <div><div class="mnav-link-title">Principals</div></div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="TariffRate" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">price_change</span>
                                            <div><div class="mnav-link-title">Tariff Rates</div></div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="Terminal" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">dock</span>
                                            <div><div class="mnav-link-title">Terminals</div></div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="TugMaster" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">engineering</span>
                                            <div><div class="mnav-link-title">Tug Masters</div></div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="TugboatOwner" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">business</span>
                                            <div><div class="mnav-link-title">Tugboat Company / Owner</div></div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="Tugboat" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">directions_boat</span>
                                            <div><div class="mnav-link-title">Tugboats</div></div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="Vessel" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">sailing</span>
                                            <div><div class="mnav-link-title">Vessels</div></div>
                                        </a>
                                    </div>
                                </div>
                                <div>
                                    <div class="mnav-section-label">Sales &amp; MSAP</div>
                                    <div class="mnav-link-list">
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="Customer" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">person</span>
                                            <div><div class="mnav-link-title">Customer</div></div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="Supplier" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">local_shipping</span>
                                            <div><div class="mnav-link-title">Supplier</div></div>
                                        </a>
                                        <a class="mnav-mega-link"
                                           asp-area="User" asp-controller="MaritimeService" asp-action="Index"
                                           role="menuitem">
                                            <span class="material-symbols-outlined">settings_suggest</span>
                                            <div><div class="mnav-link-title">Service</div></div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                }

            </ul>
        </nav>

        <!-- ── Right zone ── -->
        <div class="mnav-right">
            <!-- Search -->
            <div class="mnav-search-wrap">
                <span class="material-symbols-outlined mnav-search-icon" aria-hidden="true">search</span>
                <input class="mnav-search" type="search" placeholder="Press / to search..." aria-label="Search IBS" />
            </div>

            <!-- Notifications -->
            <a class="mnav-icon-btn"
               asp-area="User" asp-controller="Notification" asp-action="Index"
               title="Notifications" aria-label="View notifications">
                <span class="material-symbols-outlined">notifications</span>
                <span id="mnav-notif-count" class="mnav-badge" style="display:none">0</span>
            </a>

            <!-- Docs / Manual -->
            <a class="mnav-icon-btn"
               asp-area="User" asp-controller="Docs" asp-action="Index"
               title="User Manual" aria-label="User Manual">
                <span class="material-symbols-outlined">help</span>
            </a>

            <div class="mnav-divider" aria-hidden="true"></div>

            <!-- Toggle back to classic (so user can switch from modern side) -->
            <button class="mnav-toggle-btn" data-mnav-toggle title="Switch back to the classic navigation bar">
                <span class="material-symbols-outlined" aria-hidden="true">toggle_on</span>
                <span class="mnav-toggle-label">Modern Nav</span>
            </button>

            <div class="mnav-divider" aria-hidden="true"></div>

            <!-- User info -->
            <div class="mnav-user">
                <div class="mnav-user-text">
                    <div class="mnav-user-name">@(userName ?? "User")</div>
                    @if (!string.IsNullOrEmpty(company))
                    {
                        <div class="mnav-user-role">@company.ToUpper() @stationCode?.ToUpper()</div>
                    }
                </div>
                <!-- Logout form trigger (avatar click) -->
                <form id="mnav-logout-form"
                      asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                      style="margin:0">
                    <button type="submit"
                            class="mnav-avatar-btn"
                            style="background:none;border:none;padding:0;cursor:pointer;"
                            title="Logout @userName">
                        <span class="material-symbols-outlined"
                              style="font-size:34px;color:rgba(255,255,255,.8);vertical-align:middle;">
                            account_circle
                        </span>
                    </button>
                </form>
            </div>
        </div>
    }
</header>
