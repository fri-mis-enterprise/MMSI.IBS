@{
    ViewData["Title"] = ViewBag.Title ?? "User Manual";
    ViewData["IsFullWidth"] = true;
    var sidebar = ViewBag.Sidebar as List<(string Slug, string Title)> ?? [];
    var activeSlug = ViewBag.ActiveSlug as string ?? "index";
}

<style>
    .docs-layout {
        display: flex;
        gap: 0;
        min-height: calc(100vh - 5rem);
        margin: -1rem 0 0 0;
        margin-top: -1.5rem;
    }
    .docs-sidebar {
        width: 260px;
        flex-shrink: 0;
        background: #f8f9fa;
        border-right: 1px solid #dee2e6;
        padding: 1.5rem 0;
        overflow-y: auto;
        position: sticky;
        top: 5rem;
        height: calc(100vh - 5rem);
    }
    .docs-sidebar-title {
        font-size: .85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #6c757d;
        padding: 0 1.25rem .75rem;
        border-bottom: 1px solid #dee2e6;
        margin-bottom: .5rem;
    }
    .docs-sidebar-item {
        display: block;
        padding: .5rem 1.25rem;
        color: #495057;
        text-decoration: none;
        font-size: .9rem;
        border-left: 3px solid transparent;
        transition: all .15s;
    }
    .docs-sidebar-item:hover {
        background: #e9ecef;
        color: #0d6efd;
    }
    .docs-sidebar-item.active {
        background: #e9ecef;
        color: #0d6efd;
        border-left-color: #0d6efd;
        font-weight: 600;
    }
    .docs-content {
        flex: 1;
        padding: 2rem 3rem;
        overflow-x: auto;
    }
    .docs-content h1 { font-size: 2rem; margin-top: 0; margin-bottom: 1rem; font-weight: 700; }
    .docs-content h2 { font-size: 1.5rem; margin-top: 2rem; border-bottom: 1px solid #eee; padding-bottom: .5rem; }
    .docs-content h3 { font-size: 1.2rem; margin-top: 1.5rem; }
    .docs-content h4 { font-size: 1.1rem; margin-top: 1.25rem; }
    .docs-content p { line-height: 1.7; margin-bottom: 1rem; }
    .docs-content table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
    .docs-content th, .docs-content td { border: 1px solid #dee2e6; padding: .5rem .75rem; text-align: left; }
    .docs-content th { background: #f8f9fa; font-weight: 600; }
    .docs-content code { background: #f0f0f0; padding: .15em .4em; border-radius: 3px; font-size: .875em; }
    .docs-content pre { background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 6px; padding: 1rem; overflow-x: auto; }
    .docs-content pre code { background: none; padding: 0; }
    .docs-content ul, .docs-content ol { margin-bottom: 1rem; padding-left: 1.5rem; }
    .docs-content li { margin-bottom: .25rem; }
    .docs-content blockquote { border-left: 4px solid #0d6efd; padding: .5rem 1rem; margin: 1rem 0; background: #f8f9fa; border-radius: 0 6px 6px 0; }
    .docs-content hr { margin: 2rem 0; border-color: #dee2e6; }
    .docs-content a { color: #0d6efd; }
    .docs-content a:hover { text-decoration: underline; }
    .docs-content strong { font-weight: 600; }
    .docs-content img { max-width: 100%; height: auto; display: block; margin: 1rem 0; border: 1px solid #dee2e6; border-radius: 6px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    @@media (max-width: 768px) {
        .docs-sidebar { display: none; }
        .docs-content { padding: 1.5rem; }
    }
</style>

<div class="docs-layout">
    <nav class="docs-sidebar">
        <div class="docs-sidebar-title">User Manual</div>
        @foreach (var item in sidebar)
        {
            var isActive = item.Slug == activeSlug;
            <a class="docs-sidebar-item@(isActive ? " active" : "")"
               asp-action="@(item.Slug == "index" ? "Index" : "Show")"
               asp-route-slug="@(item.Slug == "index" ? null : item.Slug)">
                <span class="material-symbols-outlined" style="font-size:1.1rem;margin-right:.5rem;vertical-align:middle;">@GetIcon(item.Slug)</span>
                @item.Title
            </a>
        }
    </nav>
    <main class="docs-content">
        @Html.Raw(Model)
    </main>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
    <script>
        document.querySelectorAll('.docs-content pre code.language-mermaid').forEach(el => {
            var pre = el.parentElement;
            var wrapper = document.createElement('div');
            wrapper.className = 'mermaid';
            wrapper.textContent = el.textContent;
            pre.replaceWith(wrapper);
        });
        if (document.querySelector('.mermaid')) {
            mermaid.initialize({
                theme: 'base',
                themeVariables: { edgeLabelBackground: '#ffffff' }
            });
            mermaid.run({ querySelector: '.mermaid' });
        }
    </script>
}

@functions {
    static string GetIcon(string slug) => slug switch
    {
        "index" => "menu_book",
        "user-login" => "login",
        "job-order" => "assignment",
        "dispatch-ticket" => "confirmation_number",
        "billing" => "receipt_long",
        "collection" => "payments",
        "service-request" => "support",
        "master-files" => "database",
        "admin" => "admin_panel_settings",
        "import-export" => "file_upload",
        "reports" => "bar_chart",
        "notifications-audit" => "notifications",
        _ => "description"
    };
}
