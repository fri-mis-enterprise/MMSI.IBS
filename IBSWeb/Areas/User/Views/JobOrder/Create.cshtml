@model IBS.Models.MSAP.ViewModels.JobOrderViewModel

@{
    ViewData["Title"] = "Create Job Order";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <form asp-action="Create" method="post" id="jobOrderForm">
        <main class="modern-container">
            <!-- Header Section -->
            <div class="flex-stack">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="modern-label">MSAP</span>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <a class="modern-label" style="text-decoration:none;" asp-action="Index">Job Orders</a>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <span class="modern-label" style="color: var(--on-surface)">New Job Order</span>
                    </div>
                    <h1 class="modern-headline-lg">Create Job Order</h1>
                </div>
                <div class="flex gap-2">
                    <button type="button" class="modern-btn-primary" onclick="confirmCreate()">
                        <span class="material-symbols-outlined">save</span> Create Job Order
                    </button>
                    <a asp-action="Index" class="modern-btn-secondary">
                        <span class="material-symbols-outlined">cancel</span> Cancel
                    </a>
                </div>
            </div>

            <div class="modern-grid">
                <!-- Left Column: Primary Logistics & Remarks (col-8) -->
                <section class="modern-col-8 flex flex-column" style="gap: 1.5rem;">
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">anchor</span>
                            <h2 class="modern-headline-md">Logistics & Vessel Details</h2>
                        </div>
                        <div class="modern-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>
                            
                            <div class="modern-grid">
                                <div class="modern-col-8">
                                    <label class="modern-label">Customer <span class="text-error">*</span></label>
                                    <div class="input-group" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl); overflow: hidden;">
                                        <span class="input-group-text bg-white border-0">
                                            <span class="material-symbols-outlined text-sm">search</span>
                                        </span>
                                        <input type="text" id="CustomerSearch" class="form-control border-0" placeholder="Type to search customers..." autocomplete="off">
                                        <input type="hidden" asp-for="CustomerId" id="CustomerId" />
                                    </div>
                                    <span id="customerError" class="text-error text-xs" style="display:none">Please select a customer</span>
                                    <div id="CustomerSearchResults" class="modern-dropdown-menu w-full shadow-lg"></div>
                                    <span asp-validation-for="CustomerId" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-4">
                                    <label asp-for="Date" class="modern-label">Order Date</label>
                                    <input asp-for="Date" type="date" class="form-control" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" />
                                    <span asp-validation-for="Date" class="text-error text-xs"></span>
                                </div>
                            </div>

                            <div class="modern-grid mt-2">
                                <div class="modern-col-4">
                                    <label asp-for="VesselId" class="modern-label">Vessel</label>
                                    <div id="VesselContainer">
                                        <select asp-for="VesselId" asp-items="@Model.Vessels" class="js-modern-select" id="VesselSelect" data-placeholder="-- Select Vessel --">
                                            <option value="">-- Select Vessel --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="VesselId" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-4">
                                    <label asp-for="PortId" class="modern-label">Port</label>
                                    <div id="PortContainer">
                                        <select asp-for="PortId" asp-items="@Model.Ports" class="js-modern-select" id="PortId" data-placeholder="-- Select Port --">
                                            <option value="">-- Select Port --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="PortId" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-4">
                                    <label asp-for="TerminalId" class="modern-label">Terminal</label>
                                    <div id="TerminalContainer">
                                        <select asp-for="TerminalId" asp-items="@Model.Terminals" class="js-modern-select" id="TerminalId" data-placeholder="-- Select Terminal --">
                                            <option value="">-- Select Terminal --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="TerminalId" class="text-error text-xs"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modern-card" style="flex: 1;">
                        <div class="modern-card-header-info" style="background-color: var(--surface-container-low); color: var(--on-surface);">
                            <span class="material-symbols-outlined">notes</span>
                            <h2 class="modern-headline-md">Remarks</h2>
                        </div>
                        <div class="modern-card-body" style="height: 100%;">
                            <textarea asp-for="Remarks" class="form-control" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl); height: 100%; min-height: 150px;" placeholder="Additional notes or special instructions..."></textarea>
                            <span asp-validation-for="Remarks" class="text-error text-xs"></span>
                        </div>
                    </div>
                </section>

                <!-- Right Column: Metadata & Timing (col-4) -->
                <section class="modern-col-4 flex flex-column" style="gap: 1.5rem;">
                    <div class="modern-card">
                        <div class="modern-card-header-info" style="background-color: var(--surface-container-low); color: var(--on-surface);">
                            <span class="material-symbols-outlined">description</span>
                            <h2 class="modern-headline-md">References</h2>
                        </div>
                        <div class="modern-card-body">
                            <div>
                                <label asp-for="COSNumber" class="modern-label">COS Number</label>
                                <input asp-for="COSNumber" class="form-control" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" placeholder="Optional" maxlength="20" />
                                <span asp-validation-for="COSNumber" class="text-error text-xs"></span>
                            </div>
                            <div class="mt-3">
                                <label asp-for="VoyageNumber" class="modern-label">Voyage Number</label>
                                <input asp-for="VoyageNumber" class="form-control" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" placeholder="Optional" maxlength="100" />
                                <span asp-validation-for="VoyageNumber" class="text-error text-xs"></span>
                            </div>
                        </div>
                    </div>

                    <div class="modern-card">
                        <div class="modern-card-header-info" style="background-color: var(--surface-container-high); color: var(--on-surface);">
                            <span class="material-symbols-outlined">schedule</span>
                            <h2 class="modern-headline-md">Planned Schedule</h2>
                        </div>
                        <div class="modern-card-body">
                            <div class="flex flex-column" style="gap: 1.25rem;">
                                <div>
                                    <label asp-for="PlannedStartTime" class="modern-label">Planned Arrival/Start</label>
                                    <input asp-for="PlannedStartTime" type="datetime-local" class="form-control timeline-input" id="PlannedStartTime" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" />
                                    <span asp-validation-for="PlannedStartTime" class="text-error text-xs"></span>
                                </div>
                                <div>
                                    <label asp-for="PlannedEndTime" class="modern-label">Planned Departure/End</label>
                                    <input asp-for="PlannedEndTime" type="datetime-local" class="form-control timeline-input" id="PlannedEndTime" style="border: 1px solid var(--outline-variant); border-radius: var(--radius-xl);" />
                                    <span asp-validation-for="PlannedEndTime" class="text-error text-xs"></span>
                                    <div id="durationWarning" class="text-error text-xs mt-1" style="display: none;">
                                        <span class="material-symbols-outlined text-xs" style="vertical-align: middle;">warning</span> End time must be after start time.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // ── Customer Live Search ───────────────────────────────────────
            let customerSearchTimeout;
            const $customerSearch = $("#CustomerSearch");
            const $customerResults = $("#CustomerSearchResults");
            const $customerId = $("#CustomerId");

            async function performCustomerSearch(searchTerm) {
                try {
                    const res = await fetch(`@Url.Action("SearchCustomers", "JobOrder", new { area = "User" })?term=${encodeURIComponent(searchTerm)}`);
                    const data = await res.json();
                    $customerResults.empty();
                    if (Array.isArray(data) && data.length > 0) {
                        data.forEach(item => {
                            $customerResults.append(
                                $('<a href="#" class="modern-dropdown-item">')
                                    .data('customer', item)
                                    .html(`<span class="material-symbols-outlined">person</span> ${item.name}`)
                            );
                        });
                        $customerResults.addClass('show');
                        
                        // Positioning fixed logic for live search too
                        const rect = $customerSearch[0].getBoundingClientRect();
                        $customerResults.css({
                            'position': 'fixed',
                            'top': (rect.bottom + 4) + 'px',
                            'left': rect.left + 'px',
                            'width': rect.width + 'px',
                            'z-index': '9999'
                        });
                    } else if (searchTerm.length > 0) {
                        $customerResults.append('<div class="modern-dropdown-item text-muted italic">No customers found</div>');
                        $customerResults.addClass('show');
                    } else {
                        $customerResults.removeClass('show');
                    }
                } catch {
                    $customerResults.empty().removeClass('show');
                }
            }

            $customerSearch.on('input', function () {
                clearTimeout(customerSearchTimeout);
                const searchTerm = $(this).val().trim();
                if (searchTerm.length === 0) {
                    $customerId.val('');
                    $customerResults.removeClass('show');
                    return;
                }
                customerSearchTimeout = setTimeout(() => performCustomerSearch(searchTerm), 200);
            });

            $customerSearch.on('focus', function () {
                const searchTerm = $(this).val().trim();
                if (searchTerm.length > 0) performCustomerSearch(searchTerm);
            });

            $customerResults.on('click', 'a', function (e) {
                e.preventDefault();
                const customer = $(this).data('customer');
                if (!customer) return;

                $customerSearch.val(customer.name);
                $customerId.val(customer.value);
                $customerResults.removeClass('show');
                $("#customerError").hide();
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('#CustomerSearch, #CustomerSearchResults').length) {
                    $customerResults.removeClass('show');
                }
            });

            // ── Planned Duration Validation ────────────────────────────────
            function validatePlannedTimes() {
                const startVal = $("#PlannedStartTime").val();
                const endVal = $("#PlannedEndTime").val();
                if (!startVal || !endVal) return;

                const start = new Date(startVal);
                const end = new Date(endVal);
                const $warning = $("#durationWarning");
                const $submitBtn = $("button[type='submit']");

                if (!isNaN(start) && !isNaN(end)) {
                    if (end <= start) {
                        $warning.show();
                        $submitBtn.prop("disabled", true).css('opacity', '0.5');
                    } else {
                        $warning.hide();
                        $submitBtn.prop("disabled", false).css('opacity', '1');
                    }
                }
            }

            $(".timeline-input").on("change input", validatePlannedTimes);

            // ── Port-Terminal Cascade ──────────────────────────────────────
            $('#PortId').on('change', function () {
                var portId = $(this).val();
                var terminalSelect = $('#TerminalId');

                terminalSelect.empty().append('<option value="">-- Select Terminal --</option>');
                terminalSelect.trigger('change');

                if (!portId) return;

                $.ajax({
                    url: '@Url.Action("ChangeTerminal", "JobOrder")',
                    type: 'GET',
                    data: { portId: portId },
                    success: function (data) {
                        $.each(data, function (i, item) {
                            terminalSelect.append($('<option>', {
                                value: item.value,
                                text: item.text
                            }));
                        });
                        terminalSelect.trigger('change');
                    }
                });
            });
        });

        function confirmCreate() {
            const form = document.getElementById("jobOrderForm");
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            var customerId = $("#CustomerId").val();
            if (!customerId || customerId === "0") {
                $("#customerError").show();
                return;
            }

            ModernAlert.confirm({
                title: 'Create Job Order?',
                text: "Please ensure all details are correct before proceeding.",
                icon: 'question',
                confirmText: 'Yes, create it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    ModernAlert.showLoading("Creating job order...");
                    form.submit();
                }
            });
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
