@model IBS.Models.MSAP.ViewModels.JobOrderViewModel

@{
    ViewData["Title"] = "Create Job Order";
}

<link rel="stylesheet" href="~/css/index-style.css">

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center p-3">
            <h5 class="m-0"><i class="bi bi-plus-circle"></i> Create New Job Order</h5>
            <a asp-action="Index" class="btn btn-outline-light">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <!-- Date -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Date" class="form-label fw-bold"></label>
                        <input asp-for="Date" type="date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>

                    <!-- Customer -->
                    <div class="col-12 col-md-6 position-relative">
                        <label class="form-label fw-bold">Customer <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="CustomerSearch" class="form-control border-start-0" placeholder="Type to search customers..." autocomplete="off">
                            <input type="hidden" asp-for="CustomerId" id="CustomerId" />
                        </div>
                        <div id="CustomerSearchResults" class="list-group position-absolute w-100 shadow d-none" style="z-index: 1050; max-height: 250px; overflow-y: auto;"></div>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>

                    <!-- Vessel -->
                    <div class="col-12 col-md-6">
                        <label asp-for="VesselId" class="form-label fw-bold"></label>
                        <select asp-for="VesselId" asp-items="@Model.Vessels" class="form-select js-select2" required id="VesselSelect">
                            <option value="">-- Select Vessel --</option>
                        </select>
                        <span asp-validation-for="VesselId" class="text-danger"></span>
                    </div>

                    <!-- Port & Terminal -->
                    <div class="col-12 col-md-6">
                        <label asp-for="PortId" class="form-label fw-bold"></label>
                        <select asp-for="PortId" asp-items="@Model.Ports" class="form-select js-select2" id="PortId">
                            <option value="">-- Select Port --</option>
                        </select>
                        <span asp-validation-for="PortId" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="TerminalId" class="form-label fw-bold"></label>
                        <select asp-for="TerminalId" asp-items="@Model.Terminals" class="form-select js-select2" id="TerminalId">
                            <option value="">-- Select Terminal --</option>
                        </select>
                        <span asp-validation-for="TerminalId" class="text-danger"></span>
                    </div>

                    <!-- References -->
                    <div class="col-12 col-md-6">
                        <label asp-for="COSNumber" class="form-label fw-bold"></label>
                        <input asp-for="COSNumber" class="form-control" placeholder="Optional" maxlength="20" />
                        <span asp-validation-for="COSNumber" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="VoyageNumber" class="form-label fw-bold"></label>
                        <input asp-for="VoyageNumber" class="form-control" placeholder="Optional" maxlength="100" />
                        <span asp-validation-for="VoyageNumber" class="text-danger"></span>
                    </div>

                    <!-- Planning -->
                    <div class="col-12 col-md-3">
                        <label asp-for="PlannedStartTime" class="form-label fw-bold"></label>
                        <input asp-for="PlannedStartTime" type="datetime-local" class="form-control timeline-input" id="PlannedStartTime" />
                        <span asp-validation-for="PlannedStartTime" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-3">
                        <label asp-for="PlannedEndTime" class="form-label fw-bold"></label>
                        <input asp-for="PlannedEndTime" type="datetime-local" class="form-control timeline-input" id="PlannedEndTime" />
                        <span asp-validation-for="PlannedEndTime" class="text-danger"></span>
                        <div id="durationWarning" class="text-danger small mt-1" style="display: none;">
                            <i class="bi bi-exclamation-triangle-fill"></i> End time must be after start time.
                        </div>
                    </div>

                    <div class="col-12 col-md-3">
                        <label asp-for="RequiredTugCount" class="form-label fw-bold"></label>
                        <input asp-for="RequiredTugCount" type="number" class="form-control" min="1" max="10" />
                        <span asp-validation-for="RequiredTugCount" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="PreferredTugboatId" class="form-label fw-bold"></label>
                        <select asp-for="PreferredTugboatId" asp-items="@Model.Tugboats" class="form-select js-select2">
                            <option value="">-- No Preferred Tugboat --</option>
                        </select>
                        <span asp-validation-for="PreferredTugboatId" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="IsConfirmed" class="form-check-input" type="checkbox">
                            <label asp-for="IsConfirmed" class="form-check-label fw-bold">
                                Is Confirmed
                            </label>
                        </div>
                    </div>

                    <!-- Remarks -->
                    <div class="col-12">
                        <label asp-for="Remarks" class="form-label fw-bold"></label>
                        <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Remarks" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Create Job Order
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.js-select2').select2({
                width: '100%'
            });

            // ── Customer Live Search ───────────────────────────────────────
            let customerSearchTimeout;
            const $customerSearch = $("#CustomerSearch");
            const $customerResults = $("#CustomerSearchResults");
            const $customerId = $("#CustomerId");

            async function performCustomerSearch(searchTerm) {
                try {
                    const res = await fetch(`@Url.Action("SearchCustomers", "JobOrder", new { area = "User" })?term=${encodeURIComponent(searchTerm)}`);
                    const data = await res.json();
                    $customerResults.empty();
                    if (Array.isArray(data) && data.length > 0) {
                        data.forEach(item => {
                            $customerResults.append(
                                $('<a href="#" class="list-group-item list-group-item-action py-2">')
                                    .data('customer', item)
                                    .html(`<span>${item.name}</span>`)
                            );
                        });
                    } else {
                        $customerResults.append($('<div class="list-group-item py-2 text-muted"><em>No customers found</em></div>'));
                    }
                    $customerResults.removeClass('d-none');
                } catch {
                    $customerResults.empty().addClass('d-none');
                }
            }

            $customerSearch.on('input', function () {
                clearTimeout(customerSearchTimeout);
                const searchTerm = $(this).val().trim();
                if (searchTerm.length === 0) $customerId.val('');
                customerSearchTimeout = setTimeout(() => performCustomerSearch(searchTerm), 150);
            });

            $customerSearch.on('focus', function () {
                performCustomerSearch($(this).val().trim());
            });

            $customerResults.on('click', 'a', function (e) {
                e.preventDefault();
                const customer = $(this).data('customer');
                if (!customer) return;

                $customerSearch.val(customer.name);
                $customerId.val(customer.value);
                $customerResults.empty().addClass('d-none');
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('#CustomerSearch, #CustomerSearchResults').length) {
                    $customerResults.addClass('d-none');
                }
            });

            // ── Planned Duration Validation ────────────────────────────────
            function validatePlannedTimes() {
                const start = new Date($("#PlannedStartTime").val());
                const end = new Date($("#PlannedEndTime").val());
                const $warning = $("#durationWarning");
                const $submitBtn = $("button[type='submit']");

                if (!isNaN(start) && !isNaN(end)) {
                    if (end <= start) {
                        $warning.show();
                        $submitBtn.prop("disabled", true);
                    } else {
                        $warning.hide();
                        $submitBtn.prop("disabled", false);
                    }
                } else {
                    $warning.hide();
                    $submitBtn.prop("disabled", false);
                }
            }

            $(".timeline-input").on("change input", validatePlannedTimes);

            // ── Port-Terminal Cascade ──────────────────────────────────────
            $('#PortId').on('change', function () {
                var portId = $(this).val();
                var terminalSelect = $('#TerminalId');

                terminalSelect.empty().append('<option value="">-- Select Terminal --</option>');
                terminalSelect.trigger('change');

                if (!portId) return;

                $.ajax({
                    url: '@Url.Action("ChangeTerminal", "JobOrder")',
                    type: 'GET',
                    data: { portId: portId },
                    success: function (data) {
                        $.each(data, function (i, item) {
                            terminalSelect.append($('<option>', {
                                value: item.value,
                                text: item.text
                            }));
                        });
                        terminalSelect.trigger('change');
                    }
                });
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
