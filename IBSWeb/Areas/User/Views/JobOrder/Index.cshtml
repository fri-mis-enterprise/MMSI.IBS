@model IEnumerable<IBS.Models.MSAP.JobOrder>

@{
    ViewData["Title"] = "Job Orders";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <main class="modern-container">
        <!-- Header Section -->
        <div class="flex-stack">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label" style="color: var(--on-surface-variant)">MSAP</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">Job Orders</span>
                </div>
                <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2">
                <a asp-action="Create" class="modern-btn-primary">
                    <span class="material-symbols-outlined">add_circle</span>
                    CREATE JOB ORDER
                </a>
            </div>
        </div>

        <!-- Table Card -->
        <div class="modern-card">
            <div class="modern-card-header-action">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">list_alt</span>
                    <h2 class="modern-headline-md">Recent Orders</h2>
                </div>
            </div>
            <div class="modern-card-body">
                <table class="modern-table" id="jobOrdersTable">
                        <thead>
                            <tr>
                                <th>Job Order #</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Vessel</th>
                                <th>COS #</th>
                                <th>Voyage #</th>
                                <th class="text-center">Tickets</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="font-bold">
                                        <a asp-action="Details" asp-route-id="@item.JobOrderId" style="text-decoration:none; color: var(--primary)">
                                            @item.JobOrderNumber
                                        </a>
                                    </td>
                                    <td style="color: var(--on-surface-variant)">@item.Date.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <div style="max-width: 250px; overflow: hidden; text-overflow: ellipsis;" title="@item.Customer?.CustomerName">
                                            @item.Customer?.CustomerName
                                        </div>
                                    </td>
                                    <td class="font-bold uppercase">
                                        <div style="max-width: 200px; overflow: hidden; text-overflow: ellipsis;" title="@item.Vessel?.VesselName">
                                            @item.Vessel?.VesselName
                                        </div>
                                    </td>
                                    <td style="color: var(--on-surface-variant)">@(item.COSNumber ?? "-")</td>
                                    <td style="color: var(--on-surface-variant)">@(item.VoyageNumber)</td>
                                    <td class="text-center">
                                        <span class="modern-badge-sm" style="background-color: var(--surface-container-low); color: var(--on-surface-variant)">
                                            @item.DispatchTickets.Count
                                        </span>
                                    </td>
                                    <td>
                                        <span class="modern-badge-sm @(item.Status == SD.JobOrderStatus.Open ? "status-open" : "status-closed")">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="relative inline-block text-left dropdown-container">
                                            <button type="button" class="modern-btn-dropdown dropdown-trigger">
                                                ACTIONS <span class="material-symbols-outlined" style="font-size:16px">arrow_drop_down</span>
                                            </button>
                                            <!-- Dropdown Menu -->
                                            <div class="modern-dropdown-menu dropdown-menu">
                                                <a class="modern-dropdown-item" asp-action="Details" asp-route-id="@item.JobOrderId">
                                                    <span class="material-symbols-outlined">visibility</span> View Details
                                                </a>
                                                <a class="modern-dropdown-item" asp-action="Edit" asp-route-id="@item.JobOrderId">
                                                    <span class="material-symbols-outlined">edit</span> Edit Order
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Dropdown toggle logic
            $(document).on('click', '.dropdown-trigger', function(e) {
                e.stopPropagation();
                const $trigger = $(this);
                const $menu = $trigger.siblings('.modern-dropdown-menu');
                
                $('.modern-dropdown-menu').not($menu).removeClass('show');
                $menu.toggleClass('show');
                
                if ($menu.hasClass('show')) {
                    const rect = $trigger[0].getBoundingClientRect();
                    const menuWidth = $menu.outerWidth();
                    
                    $menu.css({
                        'position': 'fixed',
                        'top': (rect.bottom + 4) + 'px',
                        'left': (rect.right - menuWidth) + 'px',
                        'z-index': '9999'
                    });

                    const menuHeight = $menu.outerHeight();
                    if (rect.bottom + menuHeight > window.innerHeight) {
                        $menu.css('top', (rect.top - menuHeight - 4) + 'px');
                    }
                }
            });

            $(document).on('click', function() {
                $('.modern-dropdown-menu').removeClass('show');
            });

            // DataTable Initialization
            const urlParams = new URLSearchParams(window.location.search);
            const searchTerm = urlParams.get('q') || '';

            let table = $('#jobOrdersTable').DataTable({
                responsive: false, // Use our own scroll container
                order: [[0, 'desc']],
                pageLength: 25,
                language: {
                    search: "",
                    searchPlaceholder: "Search orders...",
                    lengthMenu: "_MENU_ per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                },
                search: {
                    search: searchTerm
                },
                dom: '<"flex-stack mb-2"lf><"modern-table-container"t><"flex-stack mt-2"ip>',
                initComplete: function() {
                    // Custom styles are now handled by modern-ui.css
                }
            });

            table.on('search.dt', function () {
                const query = table.search();
                const url = new URL(window.location);
                if (query) {
                    url.searchParams.set('q', query);
                } else {
                    url.searchParams.delete('q');
                }
                window.history.replaceState({}, '', url);
            });
        });
    </script>
}
