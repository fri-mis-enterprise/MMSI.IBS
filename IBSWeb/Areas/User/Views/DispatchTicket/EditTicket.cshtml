@model ServiceRequestViewModel

@{
    ViewData["Title"] = "Edit Dispatch Ticket";
    var filterType = ViewBag.FilterType as string;
}

<style>
    .form-control, .form-select, .input-group-text {
        border: 1px solid #ced4da !important;
    }
    .form-control:focus, .form-select:focus {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }
    .sticky-panel {
        position: sticky;
        top: 20px;
        z-index: 1000;
    }
</style>

<div class="container-fluid mt-4">
    <!-- Header Card -->
    <div class="card shadow border-0 mb-4">
        <div class="card-header bg-secondary bg-gradient text-white d-flex justify-content-between align-items-center p-3">
            <h5 class="m-0"><i class="bi bi-pencil-square me-2"></i>Edit Ticket: @Model.DispatchNumber</h5>
            <div class="d-flex gap-2">
                @if (Model.JobOrderId.HasValue)
                {
                    <a asp-controller="JobOrder" asp-action="Details" asp-route-id="@Model.JobOrderId.Value" class="btn btn-light btn-sm">
                        <i class="bi bi-arrow-left"></i> Back to Job Order
                    </a>
                }
                else
                {
                    <a asp-action="Index" asp-route-filterType="@filterType" class="btn btn-light btn-sm">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                }
            </div>
        </div>
    </div>

    <form id="myForm" method="post" enctype="multipart/form-data" class="row g-4">
        <input type="hidden" name="filterType" value="@filterType" />
        <input asp-for="DispatchTicketId" type="hidden">
        <input asp-for="JobOrderId" type="hidden">

        <div class="col-lg-8">
            <!-- I. Basic & Reference Information -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-dark text-white p-3">
                    <h6 class="m-0"><i class="bi bi-info-circle me-2"></i>I. Reference Information</h6>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Date" type="date" value="@(Model.Date.ToString("yyyy-MM-dd"))" class="form-control" placeholder="Date">
                                <label for="Date">Date Today <span class="text-danger">*</span></label>
                                <span asp-validation-for="Date" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="DispatchNumber" class="form-control" placeholder="Enter Dispatch #" maxlength="20" required>
                                <label for="DispatchNumber">Dispatch/Mooring # <span class="text-danger">*</span></label>
                                <span asp-validation-for="DispatchNumber" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="COSNumber" class="form-control" placeholder="Optional" maxlength="10">
                                <label for="COSNumber">COS # (Optional)</label>
                                <span asp-validation-for="COSNumber" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="VoyageNumber" class="form-control" placeholder="Optional" maxlength="20">
                                <label for="VoyageNumber">Voyage # (Optional)</label>
                                <span asp-validation-for="VoyageNumber" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- II. Service Details -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-dark text-white p-3">
                    <h6 class="m-0"><i class="bi bi-geo-alt me-2"></i>II. Service Details</h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            @if (Model.JobOrderId.HasValue)
                            {
                                <div class="form-floating">
                                    <input type="text" class="form-control bg-light" value="@(Model.Customers?.FirstOrDefault(c => c.Value == Model.CustomerId.ToString())?.Text ?? "Selected Customer")" readonly placeholder="Customer">
                                    <label>Customer <span class="text-danger">*</span></label>
                                    <input type="hidden" asp-for="CustomerId" />
                                </div>
                            }
                            else
                            {
                                <div class="form-floating">
                                    <select id="CustomerId" asp-for="CustomerId" asp-items="@Model.Customers" class="form-select js-select2" required>
                                        <option value="">-- Select Customer --</option>
                                    </select>
                                    <label for="CustomerId">Customer <span class="text-danger">*</span></label>
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            @if (Model.JobOrderId.HasValue)
                            {
                                <div class="form-floating">
                                    <input type="text" class="form-control bg-light" value="@(Model.Vessels?.FirstOrDefault(v => v.Value == Model.VesselId.ToString())?.Text ?? "Selected Vessel")" readonly placeholder="Vessel">
                                    <label>Vessel <span class="text-danger">*</span></label>
                                    <input type="hidden" asp-for="VesselId" />
                                </div>
                            }
                            else
                            {
                                <div class="form-floating">
                                    <select asp-for="VesselId" asp-items="@Model.Vessels" class="form-select js-select2" required>
                                        <option value="">-- Select Vessel --</option>
                                    </select>
                                    <label for="VesselId">Vessel <span class="text-danger">*</span></label>
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="ServiceId" asp-items="@Model.Services" class="form-select js-select2" required>
                                    <option value="">-- Select Service --</option>
                                </select>
                                <label for="ServiceId">Activity/Service Type <span class="text-danger">*</span></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="PortId" id="PortSelect" asp-items="@Model.Ports" class="form-select js-select2" required>
                                    <option value="">-- Select Port --</option>
                                </select>
                                <label for="PortId">Port <span class="text-danger">*</span></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select id="TerminalSelect" asp-items="@Model.Terminals" asp-for="TerminalId" class="form-select js-select2" required>
                                    <option value="">-- Select Terminal --</option>
                                </select>
                                <label for="TerminalId">Terminal <span class="text-danger">*</span> <span id="terminalLoading" class="spinner-border spinner-border-sm text-secondary ms-1" style="display:none;" role="status"></span></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- III. Provider Details -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-dark text-white p-3">
                    <h6 class="m-0"><i class="bi bi-person-badge me-2"></i>III. Provider Details</h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="TugBoatId" asp-items="@Model.Tugboats" class="form-select js-select2" required>
                                    <option value="">-- Select Tugboat --</option>
                                </select>
                                <label for="TugBoatId">Tugboat/Service provider <span class="text-danger">*</span></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="TugMasterId" asp-items="@Model.TugMasters" class="form-select js-select2" required>
                                    <option value="">-- Select Tug Master --</option>
                                </select>
                                <label for="TugMasterId">Master on Duty <span class="text-danger">*</span></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- IV. Remarks -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-dark text-white p-3">
                    <h6 class="m-0"><i class="bi bi-chat-left-text me-2"></i>IV. Remarks</h6>
                </div>
                <div class="card-body p-4">
                    <div class="form-floating">
                        <textarea asp-for="Remarks" class="form-control" placeholder="Remarks" style="height: 100px"></textarea>
                        <label for="Remarks">Remarks (Optional)</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Timeline & Duration -->
            <div class="card shadow border-0 mb-4 sticky-panel">
                <div class="card-header bg-primary text-white p-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0"><i class="bi bi-clock-history me-2"></i>Timeline</h6>
                    <span id="durationBadge" class="badge bg-light text-primary fs-6 border border-primary">0.00 hrs</span>
                </div>
                <div class="card-body p-3">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="small fw-bold text-muted mb-1">Start Date & Time <span class="text-danger">*</span></label>
                            <div class="input-group mb-2">
                                <input type="date" asp-for="DateLeft" value="@(Model.DateLeft?.ToString("yyyy-MM-dd"))" class="form-control timeline-input" required>
                                <input type="time" asp-for="TimeLeft" value="@(Model.TimeLeft?.ToString("HH:mm"))" class="form-control timeline-input" required>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="small fw-bold text-muted mb-1">End Date & Time <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="date" asp-for="DateArrived" value="@(Model.DateArrived?.ToString("yyyy-MM-dd"))" class="form-control timeline-input" required>
                                <input type="time" asp-for="TimeArrived" value="@(Model.TimeArrived?.ToString("HH:mm"))" class="form-control timeline-input" required>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Media Uploads -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-primary text-white p-3">
                    <h6 class="m-0"><i class="bi bi-camera me-2"></i>Media Attachments</h6>
                </div>
                <div class="card-body p-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Dispatch Ticket Image</label>
                        <input class="form-control form-control-sm" id="imageUpload" name="imageFile" type="file" accept="image/*">
                        @if (!string.IsNullOrEmpty(Model.ImageName))
                        {
                            <div class="mt-2 d-flex gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm flex-grow-1" id="viewImage"><i class="bi bi-eye"></i> View</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" id="deleteImageConfirm"><i class="bi bi-trash"></i></button>
                            </div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Operation Video</label>
                        <input class="form-control form-control-sm" id="videoUpload" name="videoFile" type="file" accept="video/*">
                        @if (!string.IsNullOrEmpty(Model.VideoName))
                        {
                            <div class="mt-2 d-flex gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm flex-grow-1 view-video" data-videolink="@Model.VideoSignedUrl"><i class="bi bi-play"></i> Play</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" id="deleteVideoConfirm"><i class="bi bi-trash"></i></button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="d-grid gap-2">
                <button class="btn btn-primary btn-lg shadow-sm" type="submit" id="submitButton">
                    <i class="bi bi-save me-2"></i>Save Changes
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Select2 Initialization
            $('.js-select2').select2({
                theme: 'bootstrap-5',
                width: '100%'
            });

            // Image Preview
            $('#viewImage').on('click', function () {
                Swal.fire({
                    imageUrl: '@Html.Raw(Model.ImageSignedUrl)',
                    imageAlt: "Dispatch Ticket",
                    showConfirmButton: false,
                    background: 'transparent',
                    width: 'auto'
                });
            });

            // Video Player
            $('.view-video').on('click', function () {
                const link = $(this).data('videolink');
                Swal.fire({
                    html: `<video width="100%" height="auto" controls autoplay><source src="${link}" type="video/mp4"></video>`,
                    showConfirmButton: false,
                    background: 'transparent',
                    width: '70%'
                });
            });

            // Port/Terminal Cascading Dropdown
            $('#PortSelect').on('change', function () {
                const portId = $(this).val();
                if (!portId) return;
                
                $('#terminalLoading').show();
                $.get('@Url.Action("ChangeTerminal", "DispatchTicket")', { portId: portId }, function (data) {
                    const $select = $('#TerminalSelect');
                    $select.empty().append('<option value="">-- Select Terminal --</option>');
                    $.each(data, function (i, item) {
                        $select.append($('<option>', { value: item.value, text: item.text }));
                    });
                    $select.trigger('change');
                }).always(() => $('#terminalLoading').hide());
            });

            // Duration Calculation
            function calculateDuration() {
                const startD = $('#DateLeft').val();
                const startT = $('#TimeLeft').val();
                const endD = $('#DateArrived').val();
                const endT = $('#TimeArrived').val();

                if (startD && startT && endD && endT) {
                    const start = new Date(`${startD}T${startT}`);
                    const end = new Date(`${endD}T${endT}`);
                    if (!isNaN(start) && !isNaN(end)) {
                        const diff = (end - start) / 3600000;
                        const $badge = $('#durationBadge');
                        if (diff < 0) {
                            $badge.text("Invalid").removeClass('bg-light text-primary').addClass('bg-danger text-white');
                        } else {
                            $badge.text(diff.toFixed(2) + " hrs").removeClass('bg-danger text-white').addClass('bg-light text-primary');
                        }
                    }
                }
            }
            $('.timeline-input').on('change input', calculateDuration);
            calculateDuration();

            // Deletion Actions
            $('#deleteImageConfirm').on('click', function() {
                Swal.fire({ title: 'Delete image?', icon: 'warning', showCancelButton: true }).then(r => {
                    if (r.isConfirmed) window.location.href = '@Url.Action("DeleteImage", new { id = Model.DispatchTicketId, filterType = filterType })';
                });
            });
            $('#deleteVideoConfirm').on('click', function() {
                Swal.fire({ title: 'Delete video?', icon: 'warning', showCancelButton: true }).then(r => {
                    if (r.isConfirmed) window.location.href = '@Url.Action("DeleteVideo", new { id = Model.DispatchTicketId, filterType = filterType })';
                });
            });

            // Form Submit Confirmation
            $('#myForm').on('submit', function(e) {
                const hasExisting = '@(string.IsNullOrEmpty(Model.ImageName) ? "" : "yes")' || '@(string.IsNullOrEmpty(Model.VideoName) ? "" : "yes")';
                const hasNew = $('#imageUpload')[0].files.length || $('#videoUpload')[0].files.length;
                if (hasExisting && hasNew) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Replace existing files?',
                        text: 'This will overwrite your current attachments.',
                        icon: 'question',
                        showCancelButton: true
                    }).then(r => { if (r.isConfirmed) this.submit(); });
                }
            });
        });
    </script>
}
