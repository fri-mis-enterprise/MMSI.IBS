@model TariffViewModel

@{
    ViewData["Title"] = "Dispatch Ticket - Edit Tariff";
    var filterType = ViewBag.FilterType as string;
}

<style>
    .form-control, .form-select, .input-group-text {
        border: 1px solid #ced4da !important;
    }
    .form-control:focus, .form-select:focus {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }
    .sticky-panel {
        position: sticky;
        top: 20px;
        max-height: calc(100vh - 150px);
    }
</style>

<div class="container-fluid mt-4">
    <!-- Header Card -->
    <div class="card shadow border-0 mb-4">
        <div class="card-header bg-secondary bg-gradient text-white d-flex justify-content-between align-items-center p-3">
            <h5 class="m-0"><i class="bi bi-pencil-square me-2"></i>Edit Tariff: @Model.DispatchNumber</h5>
            <div class="d-flex gap-2">
                @if (Model.JobOrderId.HasValue)
                {
                    <a asp-controller="JobOrder" asp-action="Details" asp-route-id="@Model.JobOrderId.Value" class="btn btn-light btn-sm">
                        <i class="bi bi-arrow-left"></i> Back to Job Order
                    </a>
                }
                else
                {
                    <a asp-action="Index" asp-route-filterType="@filterType" class="btn btn-light btn-sm">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                }
            </div>
        </div>
    </div>

    <form id="myForm" method="post" asp-action="EditTariff" asp-controller="DispatchTicket" asp-area="User">
        <input type="hidden" name="filterType" value="@filterType" />
        <input type="hidden" asp-for="DispatchNumber">
        <input asp-for="DispatchTicketId" id="DispatchTicketId" type="hidden" />
        <input asp-for="JobOrderId" type="hidden" />
        <input asp-for="CustomerId" id="CustomerId" type="hidden" />

        <div class="row g-4">
            <!-- Left Panel: Dispatch Details (35%) -->
            <div class="col-lg-4 col-md-5">
                <div class="card shadow border-0 sticky-panel">
                    <div class="card-header bg-primary text-white p-3">
                        <h6 class="m-0"><i class="bi bi-info-circle me-2"></i>Dispatch Details</h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="mb-3">
                            <label class="text-muted small fw-bold mb-1">Customer</label>
                            <div class="fw-bold text-primary">@Model.CustomerName</div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small fw-bold mb-1">Vessel</label>
                            <div class="fw-bold">@Model.VesselName (@Model.VesselType)</div>
                        </div>
                        
                        <hr class="my-2">
                        
                        <div class="mb-3">
                            <label class="text-muted small fw-bold mb-1">Timeline</label>
                            <div class="small">
                                <div><i class="bi bi-calendar-event me-1"></i> Date: @Model.Date</div>
                                <div class="text-success"><i class="bi bi-play-circle me-1"></i> Start: @Model.DateLeft @Model.TimeLeft</div>
                                <div class="text-danger"><i class="bi bi-stop-circle me-1"></i> End: @Model.DateArrived @Model.TimeArrived</div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small fw-bold mb-1">Location</label>
                            <div class="small">@Model.PortName - @Model.TerminalName</div>
                        </div>

                        <hr class="my-2">

                        <div class="d-flex justify-content-between align-items-center">
                            <label class="text-muted small fw-bold">Total Duration:</label>
                            <span class="badge bg-primary fs-6">@Model.TotalHours?.ToString("N2") hours</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Panel: Tariff Calculation (65%) -->
            <div class="col-lg-8 col-md-7">
                <div class="card shadow border-0 mb-4">
                    <div class="card-header bg-white p-3">
                        <h5 class="m-0 text-primary"><i class="bi bi-calculator me-2"></i>Tariff Calculation</h5>
                    </div>
                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Dispatch Configuration -->
                        <div class="mb-4">
                            <h6 class="text-secondary border-bottom pb-2 mb-3 fw-bold small text-uppercase">1. Dispatch Service</h6>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="small fw-bold text-muted mb-2 d-block">Charge Type</label>
                                    <div class="btn-group w-100" role="group">
                                        <input type="radio" class="btn-check" name="chargeType" id="dispatchHour" value="Per hour" autocomplete="off" @(Model.DispatchChargeType == null || Model.DispatchChargeType == "Per hour" ? "checked" : "")>
                                        <label class="btn btn-outline-secondary" for="dispatchHour">Per Hour</label>

                                        <input type="radio" class="btn-check" name="chargeType" id="dispatchMove" value="Per move" autocomplete="off" @(Model.DispatchChargeType == "Per move" ? "checked" : "")>
                                        <label class="btn btn-outline-secondary" for="dispatchMove">Per Move</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Dispatch Rate</label>
                                    <input asp-for="DispatchRate" id="DispatchRate" step="0.01" type="number" class="form-control" placeholder="0.00">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Discount (%)</label>
                                    <input asp-for="DispatchDiscount" id="DispatchDiscount" step="0.01" type="number" class="form-control" placeholder="0.00">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Billing Amount</label>
                                    <input asp-for="DispatchBillingAmount" id="DispatchBillingAmount" class="form-control bg-light" readonly placeholder="0.00">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Net Revenue</label>
                                    <input asp-for="DispatchNetRevenue" id="DispatchNetRevenue" class="form-control bg-light fw-bold text-success" readonly placeholder="0.00">
                                </div>
                            </div>
                        </div>

                        <!-- BAF Configuration -->
                        <div class="mb-4">
                            <h6 class="text-secondary border-bottom pb-2 mb-3 fw-bold small text-uppercase">2. BAF (Bunker Adjustment Factor)</h6>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="small fw-bold text-muted mb-2 d-block">Charge Type</label>
                                    <div class="btn-group w-100" role="group">
                                        <input type="radio" class="btn-check" name="chargeType2" id="bafHour" value="Per hour" autocomplete="off" @(Model.BAFChargeType == null || Model.BAFChargeType == "Per hour" ? "checked" : "")>
                                        <label class="btn btn-outline-secondary" for="bafHour">Per Hour</label>

                                        <input type="radio" class="btn-check" name="chargeType2" id="bafMove" value="Per move" autocomplete="off" @(Model.BAFChargeType == "Per move" ? "checked" : "")>
                                        <label class="btn btn-outline-secondary" for="bafMove">Per Move</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">BAF Rate</label>
                                    <input asp-for="BAFRate" id="BAFRate" step="0.01" type="number" class="form-control" placeholder="0.00">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Discount (%)</label>
                                    <input asp-for="BAFDiscount" id="BAFDiscount" step="0.01" type="number" class="form-control" placeholder="0.00">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Billing Amount</label>
                                    <input asp-for="BAFBillingAmount" id="BAFBillingAmount" class="form-control bg-light" readonly placeholder="0.00">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Net Revenue</label>
                                    <input asp-for="BAFNetRevenue" id="BAFNetRevenue" class="form-control bg-light fw-bold text-success" readonly placeholder="0.00">
                                </div>
                            </div>
                        </div>

                        <!-- AP Other Tugs -->
                        @if (Model.IsTugboatCompanyOwned == false)
                        {
                            <div class="mb-4">
                                <h6 class="text-danger border-bottom pb-2 mb-3 fw-bold small text-uppercase">3. Outsourced Tug Details</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Tug Provider</label>
                                        <input class="form-control bg-light" id="TugProvider" value="@Model.TugboatOwnerName" readonly>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">AP Other Tugs (Expense)</label>
                                        <input asp-for="ApOtherTugs" id="ApOtherTugs" type="number" step="0.01" class="form-control border-danger" placeholder="0.00">
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Summary Section -->
                        <div class="p-4 border rounded bg-primary bg-opacity-10 border-primary mt-4">
                            <div class="row g-3 text-center">
                                <div class="col-md-6 border-end border-primary">
                                    <label class="form-label fw-bold small text-muted d-block">TOTAL BILLING</label>
                                    <input asp-for="TotalBilling" id="TotalBilling" class="form-control-plaintext bg-transparent fw-bold fs-4 text-primary text-center" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted d-block">TOTAL NET REVENUE</label>
                                    <input asp-for="TotalNetRevenue" id="TotalNetRevenue" class="form-control-plaintext bg-transparent fw-bold fs-4 text-success text-center" readonly>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                            <button class="btn btn-primary px-5 shadow-sm" type="submit" id="submitButton">
                                <i class="bi bi-save me-2"></i> Update Tariff
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function parseNumber(value) {
            if (!value || value === '') return 0;
            return parseFloat(value.toString().replace(/,/g, '')) || 0;
        }

        function formatNumber(value) {
            return parseFloat(value).toFixed(2);
        }

        $(document).ready(function () {
            const dispatchRateInput = $('#DispatchRate');
            const bafRateInput = $('#BAFRate');
            const dispatchDiscountInput = $('#DispatchDiscount');
            const bafDiscountInput = $('#BAFDiscount');
            const totalHours = @(Model.TotalHours ?? 0);

            function ValueChange() {
                const dispatchChargeType = $('input[name="chargeType"]:checked').val();
                const bafChargeType = $('input[name="chargeType2"]:checked').val();

                const dispatchRate = parseNumber(dispatchRateInput.val());
                const dispatchDiscountPercent = parseNumber(dispatchDiscountInput.val());
                const dispatchDiscountAmount = dispatchRate * (dispatchDiscountPercent / 100);

                const bafRate = parseNumber(bafRateInput.val());
                const bafDiscountPercent = parseNumber(bafDiscountInput.val());
                const bafDiscountAmount = bafRate * (bafDiscountPercent / 100);

                let dispatchRevenue = 0;
                let dispatchBilling = 0;
                let bafRevenue = 0;
                let bafBilling = 0;

                // Dispatch Calculation
                if (dispatchChargeType === "Per hour") {
                    dispatchBilling = dispatchRate * totalHours;
                    dispatchRevenue = (dispatchRate - dispatchDiscountAmount) * totalHours;
                } else {
                    dispatchBilling = dispatchRate;
                    dispatchRevenue = dispatchRate - dispatchDiscountAmount;
                }

                // BAF Calculation
                if (bafChargeType === "Per hour") {
                    bafBilling = bafRate * totalHours;
                    bafRevenue = (bafRate - bafDiscountAmount) * totalHours;
                } else {
                    bafBilling = bafRate;
                    bafRevenue = bafRate - bafDiscountAmount;
                }

                $('#DispatchBillingAmount').val(formatNumber(dispatchBilling));
                $('#DispatchNetRevenue').val(formatNumber(dispatchRevenue));
                $('#BAFBillingAmount').val(formatNumber(bafBilling));
                $('#BAFNetRevenue').val(formatNumber(bafRevenue));

                const totalBilling = dispatchBilling + bafBilling;
                const totalRevenue = dispatchRevenue + bafRevenue;

                $('#TotalBilling').val(formatNumber(totalBilling));
                $('#TotalNetRevenue').val(formatNumber(totalRevenue));
            }

            $('input').on('input change', ValueChange);
            ValueChange();

            $('#submitButton').on('click', function (e) {
                e.preventDefault();
                const dispatchRate = parseNumber(dispatchRateInput.val());
                const bafRate = parseNumber(bafRateInput.val());

                if (dispatchRate === 0 && bafRate === 0) {
                    Swal.fire({ icon: "error", title: "Validation Error", text: "Dispatch or BAF rate must be set." });
                    return;
                }

                Swal.fire({
                    title: 'Update Tariff?',
                    text: 'Confirm your changes before updating.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Update'
                }).then((result) => {
                    if (result.isConfirmed) $('#myForm').submit();
                });
            });
        });
    </script>
}
