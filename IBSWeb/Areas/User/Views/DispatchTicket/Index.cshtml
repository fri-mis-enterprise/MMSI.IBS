@model IEnumerable<IBS.Models.MSAP.DispatchTicket>

@{
    ViewData["Title"] = "Dispatch Tickets";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <main class="modern-container">
        <!-- Header Section -->
        <div class="flex-stack">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label" style="color: var(--on-surface-variant)">MSAP</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">Dispatch Tickets</span>
                </div>
                <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2">
                <!-- Add New Button if needed in future -->
            </div>
        </div>

        <!-- Filter Group -->
        <div class="flex flex-wrap gap-2">
            <button id="filterAll" class="modern-btn-secondary active">ALL</button>
            <button id="filterForTariff" class="modern-btn-secondary">FOR TARIFF</button>
            <button id="filterForApproval" class="modern-btn-secondary">FOR APPROVAL</button>
            <button id="filterDisapproved" class="modern-btn-secondary">DISAPPROVED</button>
            <button id="filterForBilling" class="modern-btn-secondary">FOR BILLING</button>
            <button id="filterBilled" class="modern-btn-secondary">BILLED</button>
        </div>

        <!-- Table Card -->
        <div class="modern-card">
            <div class="modern-card-header-action">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">confirmation_number</span>
                    <h2 class="modern-headline-md">Ticket Registry</h2>
                </div>
            </div>
            <div class="modern-card-body">
                <div class="modern-table-container">
                    <table class="modern-table" id="paginatedTable">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>COS #</th>
                                <th>Ticket #</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Activity/Service</th>
                                <th>Port-Terminal</th>
                                <th>Tugboat</th>
                                <th>Customer</th>
                                <th>Vessel</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<style>
    .modern-btn-secondary.active {
        background-color: var(--primary);
        color: white;
        border-color: var(--primary);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            const previewUrl = '@Url.Action("Preview", "DispatchTicket")';
            const setTariffUrl = '@Url.Action("SetTariff", "DispatchTicket")';
            const editTariffUrl = '@Url.Action("EditTariff", "DispatchTicket")';
            const editTicketUrl = '@Url.Action("EditTicket", "DispatchTicket")';
            const filterType = '@ViewBag.FilterType';

            const urlParams = new URLSearchParams(window.location.search);
            const statusFilter = urlParams.get('status') || '';

            let table = $('#paginatedTable').DataTable({
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: [11] }
                ],
                processing: true,
                serverSide: true,
                stateDuration: 86400,
                language: {
                    search: "",
                    searchPlaceholder: "Search tickets...",
                    processing: `<div class="text-center p-3">
                                    <div class="spinner-border text-primary" role="status" style="width: 1.5rem; height: 1.5rem;"></div>
                                 </div>`
                },
                ajax: {
                    url: "@Url.Action("GetDispatchTicketLists", "DispatchTicket", new { area = "User" })",
                    type: "POST",
                    data: function (d) {
                        return $.extend({}, d, {
                            filterType: '@ViewBag.FilterType',
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        });
                    }
                },
                dom: '<"flex-stack mb-2"lf><"modern-table-container"t><"flex-stack mt-2"ip>',
                drawCallback: function () {
                    $('[data-bs-toggle="tooltip"]').tooltip();
                },
                columns: [
                    { data: "date" },
                    { data: "cosNumber" },
                    { data: "dispatchNumber" },
                    {
                        data: "dateLeft",
                        render: function(data, type, row) {
                            return `${row.dateLeft} ${row.timeLeft}`;
                        }
                    },
                    {
                        data: "dateArrived",
                        render: function(data, type, row) {
                            return `${row.dateArrived} ${row.timeArrived}`;
                        }
                    },
                    { data: "service.serviceName" },
                    {
                        data: null,
                        name: "terminal.port.portName",
                        render: function (data, type, row) {
                            const portName = row.terminal?.port?.portName ?? "";
                            const terminalName = row.terminal?.terminalName ?? "";
                            return portName || terminalName ? `${portName} - ${terminalName}` : "";
                        }
                    },
                    { data: "tugboat.tugboatName" },
                    {
                        data: "customer.customerName",
                        render: function(data, type, row) {
                            return row.customerId ? row.customer.customerName : `<span class="italic text-xs" style="color: var(--on-surface-variant)">(For Customer Assigning)</span>`;
                        }
                    },
                    { data: "vessel.vesselName" },
                    {
                        data: "status",
                        className: "text-center",
                        render: function(data, type, row) {
                            let statusClass = "";
                            if (row.status === "@SD.DispatchTicketStatus.ForTariff") statusClass = "status-tariff";
                            else if (row.status === "@SD.DispatchTicketStatus.ForApproval") statusClass = "status-approval";
                            else if (row.status === "@SD.DispatchTicketStatus.Disapproved") statusClass = "status-error";
                            else if (row.status === "@SD.DispatchTicketStatus.ForBilling") statusClass = "status-billing";
                            else if (row.status === "@SD.DispatchTicketStatus.Billed") statusClass = "status-confirmed";

                            return `<span class="modern-badge-sm ${statusClass}">${row.status}</span>`;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: function(data, type, row) {
                            let actions = `<div class="relative inline-block text-left dropdown-container">
                                            <button type="button" class="modern-btn-dropdown dropdown-trigger">
                                                ACTIONS <span class="material-symbols-outlined" style="font-size:16px">arrow_drop_down</span>
                                            </button>
                                            <div class="modern-dropdown-menu dropdown-menu">`;
                            
                            if (row.status !== "@SD.DispatchTicketStatus.ForTariff" && row.status !== "@SD.DispatchTicketStatus.ForApproval" && row.status !== "@SD.DispatchTicketStatus.Pending") {
                                actions += `<a class="modern-dropdown-item" href="${previewUrl}?id=${row.dispatchTicketId}">
                                                <span class="material-symbols-outlined">visibility</span> View Details
                                            </a>`;
                            }
                            
                            if (row.status === "@SD.DispatchTicketStatus.ForApproval") {
                                actions += `<a class="modern-dropdown-item" href="${previewUrl}?id=${row.dispatchTicketId}">
                                                <span class="material-symbols-outlined">visibility</span> View Details
                                            </a>`;
                                if (row.customerId !== null) {
                                    actions += `<a class="modern-dropdown-item" href="${editTariffUrl}?id=${row.dispatchTicketId}&filterType=${filterType}">
                                                    <span class="material-symbols-outlined">edit_note</span> Edit Tariff
                                                </a>`;
                                }
                                actions += `<a class="modern-dropdown-item" href="${editTicketUrl}?id=${row.dispatchTicketId}&filterType=${filterType}">
                                                <span class="material-symbols-outlined">edit</span> Edit Ticket
                                            </a>`;
                            }

                            if (row.status === "@SD.DispatchTicketStatus.ForTariff") {
                                if (row.customerId !== null) {
                                    actions += `<a class="modern-dropdown-item" href="${setTariffUrl}?id=${row.dispatchTicketId}&filterType=${filterType}">
                                                    <span class="material-symbols-outlined">payments</span> Set Tariff
                                                </a>`;
                                }
                                actions += `<a class="modern-dropdown-item" href="${editTicketUrl}?id=${row.dispatchTicketId}&filterType=${filterType}">
                                                <span class="material-symbols-outlined">edit</span> Edit Ticket
                                            </a>`;
                            }

                            if (row.status === "@SD.DispatchTicketStatus.Pending") {
                                actions += `<a class="modern-dropdown-item" href="${editTicketUrl}?id=${row.dispatchTicketId}&filterType=${filterType}">
                                                <span class="material-symbols-outlined">edit</span> Edit Ticket
                                            </a>`;
                            }
                            
                            actions += `</div></div>`;
                            return actions;
                        }
                    }
                ],
                initComplete: function(settings, json) {
                    if (statusFilter) {
                        this.api().column(10).search(statusFilter).draw();
                        updateFilterButtons(statusFilter);
                    }
                }
            });

            // Action dropdown positioning logic
            $(document).on('click', '.dropdown-trigger', function(e) {
                e.stopPropagation();
                const $trigger = $(this);
                const $menu = $trigger.siblings('.modern-dropdown-menu');
                
                $('.modern-dropdown-menu').not($menu).removeClass('show');
                $menu.toggleClass('show');
                
                if ($menu.hasClass('show')) {
                    const rect = $trigger[0].getBoundingClientRect();
                    const menuWidth = $menu.outerWidth();
                    $menu.css({
                        'position': 'fixed',
                        'top': (rect.bottom + 4) + 'px',
                        'left': (rect.right - menuWidth) + 'px',
                        'z-index': '9999'
                    });
                }
            });

            $(document).on('click', function() {
                $('.modern-dropdown-menu').removeClass('show');
            });

            function updateUrl(status) {
                const url = new URL(window.location);
                if (status) url.searchParams.set('status', status);
                else url.searchParams.delete('status');
                window.history.replaceState({}, '', url);
            }

            function updateFilterButtons(status) {
                $('.modern-btn-secondary').removeClass('active');
                if (!status) $('#filterAll').addClass('active');
                else if (status === "@SD.DispatchTicketStatus.ForTariff") $('#filterForTariff').addClass('active');
                else if (status === "@SD.DispatchTicketStatus.ForApproval") $('#filterForApproval').addClass('active');
                else if (status === "@SD.DispatchTicketStatus.Disapproved") $('#filterDisapproved').addClass('active');
                else if (status === "@SD.DispatchTicketStatus.ForBilling") $('#filterForBilling').addClass('active');
                else if (status === "@SD.DispatchTicketStatus.Billed") $('#filterBilled').addClass('active');
            }

            $('#filterAll').on('click', function() {
                table.columns().search('').draw();
                updateUrl('');
                updateFilterButtons('');
            });

            $('#filterForTariff').on('click', function() {
                const status = '@SD.DispatchTicketStatus.ForTariff';
                table.columns().search('');
                table.columns(10).search(status).draw();
                updateUrl(status);
                updateFilterButtons(status);
            });

            $('#filterForApproval').on('click', function() {
                const status = '@SD.DispatchTicketStatus.ForApproval';
                table.columns().search('');
                table.columns(10).search(status).draw();
                updateUrl(status);
                updateFilterButtons(status);
            });

            $('#filterDisapproved').on('click', function() {
                const status = '@SD.DispatchTicketStatus.Disapproved';
                table.columns().search('');
                table.columns(10).search(status).draw();
                updateUrl(status);
                updateFilterButtons(status);
            });

            $('#filterForBilling').on('click', function() {
                const status = '@SD.DispatchTicketStatus.ForBilling';
                table.columns().search('');
                table.columns(10).search(status).draw();
                updateUrl(status);
                updateFilterButtons(status);
            });

            $('#filterBilled').on('click', function() {
                const status = '@SD.DispatchTicketStatus.Billed';
                table.columns().search('');
                table.columns(10).search(status).draw();
                updateUrl(status);
                updateFilterButtons(status);
            });
        });
    </script>
}