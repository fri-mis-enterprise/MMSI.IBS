@model IEnumerable<BankAccount>

@{
    ViewData["Title"] = "Bank Account Master File";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center bg-secondary p-3 rounded shadow">
        <h2 class="text-white m-0">@ViewData["Title"]</h2>
        <a asp-area="User" asp-controller="BankAccount" asp-action="Create" class="btn btn-light">
            <i class="bi bi-plus-circle"></i> Create New Bank Account
        </a>
    </div>

    <div class="card shadow border-0 mt-3">
        <div class="card-body p-3">
            <div class="table-responsive" style="max-height: 70vh">
                <table class="table table-hover mb-0" id="paginatedTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-start">Code</th>
                            <th class="text-start">Bank</th>
                            <th class="text-start">Branch</th>
                            <th class="text-start">Account No</th>
                            <th class="text-start">Account Name</th>
                            <th class="text-start">Company</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.BankAccountCode</td>
                                <td>@item.Bank</td>
                                <td>@item.Branch</td>
                                <td>@item.AccountNo</td>
                                <td>@item.AccountName</td>
                                <td>@item.Company</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.BankAccountId" class="btn btn-primary btn-sm">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#paginatedTable').DataTable({
                "order": [[0, 'asc']]
            });
        });
    </script>
}
