@using System.Globalization
@{
    ViewData["Title"] = "MMSI Reports";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <main class="modern-container">
        <div class="flex-stack">
            <div>
                <h1 class="modern-headline-lg">MMSI Reports</h1>
                <p class="modern-label" style="color: var(--on-surface-variant)">Select a report to generate Excel</p>
            </div>
        </div>

        <div class="modern-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 1.5rem; margin-top: 1.5rem;">
            <!-- Report 1 -->
            <div class="modern-card">
                <div class="modern-card-body">
                    <div class="flex items-center gap-2 mb-3">
                        <span class="material-symbols-outlined text-primary">receipt_long</span>
                        <h2 class="modern-headline-md">Dispatch for Billing</h2>
                    </div>
                    <p class="modern-label mb-3" style="color: var(--on-surface-variant); font-size: 0.8rem;">Dispatch tickets ready for billing with tariff and BAF amounts.</p>
                    <form method="post" action="@Url.Action("DispatchForBilling", "MaritimeReport", new { area = "User" })" class="modern-grid" style="gap: 0.75rem;">
                        <div>
                            <label class="modern-label">From</label>
                            <input type="date" name="dateFrom" class="modern-input w-100" required>
                        </div>
                        <div>
                            <label class="modern-label">To</label>
                            <input type="date" name="dateTo" class="modern-input w-100" required>
                        </div>
                        <button type="submit" class="modern-btn-primary w-100" style="margin-top: 0.5rem;">
                            <span class="material-symbols-outlined" style="font-size: 18px;">download</span> Download Excel
                        </button>
                    </form>
                </div>
            </div>

            <!-- Report 2 -->
            <div class="modern-card">
                <div class="modern-card-body">
                    <div class="flex items-center gap-2 mb-3">
                        <span class="material-symbols-outlined text-primary">summarize</span>
                        <h2 class="modern-headline-md">Dispatch Ticket Summary</h2>
                    </div>
                    <p class="modern-label mb-3" style="color: var(--on-surface-variant); font-size: 0.8rem;">Detailed dispatch summary with billing and collection info.</p>
                    <form method="post" action="@Url.Action("DispatchTicketSummary", "MaritimeReport", new { area = "User" })" class="modern-grid" style="gap: 0.75rem;">
                        <div>
                            <label class="modern-label">From</label>
                            <input type="date" name="dateFrom" class="modern-input w-100" required>
                        </div>
                        <div>
                            <label class="modern-label">To</label>
                            <input type="date" name="dateTo" class="modern-input w-100" required>
                        </div>
                        <button type="submit" class="modern-btn-primary w-100" style="margin-top: 0.5rem;">
                            <span class="material-symbols-outlined" style="font-size: 18px;">download</span> Download Excel
                        </button>
                    </form>
                </div>
            </div>

            <!-- Report 3 -->
            <div class="modern-card">
                <div class="modern-card-body">
                    <div class="flex items-center gap-2 mb-3">
                        <span class="material-symbols-outlined text-primary">monitoring</span>
                        <h2 class="modern-headline-md">Sales Summary (AR Monitoring)</h2>
                    </div>
                    <p class="modern-label mb-3" style="color: var(--on-surface-variant); font-size: 0.8rem;">AR monitoring report with trip details per month.</p>
                    <form method="post" action="@Url.Action("SalesSummary", "MaritimeReport", new { area = "User" })" class="modern-grid" style="gap: 0.75rem;">
                        <div>
                            <label class="modern-label">Month</label>
                            <select name="month" class="modern-input w-100" required>
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m" selected="@(m == DateTime.Now.Month ? true : null)">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="modern-label">Year</label>
                            <select name="year" class="modern-input w-100" required>
                                @for (int y = DateTime.Now.Year - 5; y <= DateTime.Now.Year; y++)
                                {
                                    <option value="@y" selected="@(y == DateTime.Now.Year ? true : null)">@y</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="modern-btn-primary w-100" style="margin-top: 0.5rem;">
                            <span class="material-symbols-outlined" style="font-size: 18px;">download</span> Download Excel
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </main>
</div>
