@model CreateCollectionViewModel

@{
    ViewData["Title"] = "Edit Collection";
}

<link rel="stylesheet" href="~/css/form-style.css">

<style>
    .container {
        max-width: 100% !important;
        width: 100% !important;
    }

    .sticky-panel {
        /* Default for mobile: no sticky */
        position: relative;
        top: 0;
        max-height: none;
    }

    @@media (min-width: 992px) {
        .sticky-panel {
            position: sticky;
            top: 80px;
            max-height: calc(100vh - 140px);
            overflow-y: auto;
            padding-right: 5px;
        }
        
        .sticky-panel::-webkit-scrollbar {
            width: 4px;
        }
        .sticky-panel::-webkit-scrollbar-thumb {
            background: #e3e6f0;
            border-radius: 10px;
        }
    }

    .form-container-bottom {
        padding-bottom: 5rem;
    }

    .section-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0;
    }

    .card {
        border-radius: 0.25rem;
    }

    .summary-box {
        background-color: #f8f9fc;
        border-radius: 0.35rem;
        padding: 1rem;
        border: 1px solid #e3e6f0;
    }

    .summary-label {
        font-size: 0.75rem;
        color: #858796;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
    }

    .summary-value {
        font-size: 1.25rem;
        font-weight: 700;
        color: #4e73df;
    }

    .form-label-custom {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        color: #858796;
        margin-bottom: 0.25rem;
        display: block;
    }

    .required-star {
        color: #e74a3b;
    }

    #billingsTable thead th {
        background-color: #f8f9fc;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #4e73df;
    }
</style>

<div class="container-fluid mt-4 form-container-bottom">
    <form id="myForm" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="MsapCollectionId" id="CollectionId" type="hidden">
        <input asp-for="CustomerId" id="customerId" type="hidden">

        <!-- Header Card -->
        <div class="card shadow border-0 mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center p-3">
                <h5 class="m-0"><i class="bi bi-pencil-square me-2"></i> @ViewData["Title"]: @Model.MsapCollectionNumber</h5>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-light">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-light" id="submitButton">
                        <i class="bi bi-check-circle"></i> Update Collection
                    </button>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Information & Billings -->
            <div class="col-lg-8">
                <!-- Collection Information -->
                <div class="card shadow border-0 mb-4">
                    <div class="card-header bg-primary text-white p-3">
                        <h6 class="m-0 section-title"><i class="bi bi-info-circle me-2"></i>Collection Information</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-custom">Customer</label>
                                <input type="text" class="form-control bg-light" value="@Model.Customers?.FirstOrDefault(x => x.Value == Model.CustomerId.ToString())?.Text" readonly>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label-custom" id="statusLabel">Collection Receipt # <span class="required-star">*</span></label>
                                <input asp-for="MsapCollectionNumber" type="text" class="form-control" id="msapCollectionNumber">
                                <span asp-validation-for="MsapCollectionNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-2 d-flex align-items-end pb-1">
                                <div class="form-check form-switch mb-2">
                                    <input type="hidden" asp-for="IsUndocumented" id="IsUndocumented" />
                                    <input class="form-check-input" type="checkbox" id="isUndocumentedCheckbox" @(Model.IsUndocumented ? "checked" : "") disabled>
                                    <label class="form-check-label small fw-bold text-muted" for="isUndocumentedCheckbox">Undocumented</label>
                                </div>
                            </div>
                            
                            <!-- Customer Details Display -->
                            <div id="CustomerDetailsSection" class="col-12 d-none">
                                <div class="p-3 bg-light rounded border small">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <span class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Address:</span><br>
                                            <span id="CustomerAddress" class="fw-semibold">-</span>
                                        </div>
                                        <div class="col-md-3">
                                            <span class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">TIN:</span><br>
                                            <span id="CustomerTIN" class="fw-semibold">-</span>
                                        </div>
                                        <div class="col-md-3">
                                            <span class="text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Terms:</span><br>
                                            <span id="CustomerTerms" class="fw-semibold">-</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12"><hr class="my-2"></div>

                            <div class="col-md-4">
                                <label class="form-label-custom">Collection Date</label>
                                <input asp-for="Date" type="date" id="Date" class="form-control">
                                <span asp-validation-for="Date" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label-custom">Reference Number</label>
                                <input asp-for="ReferenceNo" type="text" class="form-control">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label-custom">Remarks</label>
                                <input asp-for="Remarks" type="text" class="form-control">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Billing Settlement -->
                <div class="card shadow border-0">
                    <div class="card-header bg-primary text-white p-3">
                        <h6 class="m-0 section-title"><i class="bi bi-list-check me-2"></i>Billing Settlement</h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="table-responsive">
                            <table id="billingsTable" class="table table-hover align-middle mb-0" style="width: 100%">
                                <thead>
                                    <tr>
                                        <th class="text-center" width="40"><input type="checkbox" id="selectAll" class="form-check-input"></th>
                                        <th>Billing #</th>
                                        <th class="text-center">Date</th>
                                        <th class="text-end">Gross</th>
                                        <th class="text-end">EWT</th>
                                        <th class="text-end">Net</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Populated via JS -->
                                </tbody>
                            </table>
                        </div>
                        
                        <!-- Hidden Select for Model Binding -->
                        <select asp-for="ToCollectBillings" id="hiddenBillingsSelect" multiple="multiple" style="display: none;"></select>
                    </div>
                </div>
            </div>

            <!-- Right Column: Payments & Summary (Sticky) -->
            <div class="col-lg-4">
                <div class="sticky-panel">
                    <!-- Payment Summary -->
                    <div class="card shadow border-0 mb-4">
                        <div class="card-header bg-primary text-white p-3">
                            <h6 class="m-0 section-title"><i class="bi bi-calculator me-2"></i>Payment Summary</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="summary-box mb-4">
                                <div class="row g-2 mb-3 text-center">
                                    <div class="col-6 border-end">
                                        <div class="summary-label">Total Gross</div>
                                        <div id="billingsTotal" class="fw-bold">₱ 0.00</div>
                                    </div>
                                    <div class="col-6">
                                        <div class="summary-label">Total EWT</div>
                                        <div id="ewtTotalDisplay" class="text-danger fw-bold">₱ 0.00</div>
                                    </div>
                                </div>
                                <hr class="my-2">
                                <div class="text-center py-2">
                                    <div class="summary-label">Net Amount to Collect</div>
                                    <div id="netAmountDisplay" class="summary-value">₱ 0.00</div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label-custom">Cash Payment</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">₱</span>
                                        <input asp-for="CashAmount" type="number" step="0.01" class="form-control fw-bold text-success" id="cashAmount">
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label-custom">Check Payment</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">₱</span>
                                        <input asp-for="CheckAmount" type="number" step="0.01" class="form-control fw-bold text-primary" id="checkAmount">
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label-custom">WVAT Withheld</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">₱</span>
                                        <input asp-for="WVAT" type="number" step="0.01" class="form-control" id="wvat">
                                    </div>
                                </div>
                                
                                <!-- Hidden technical fields -->
                                <input type="hidden" asp-for="Amount" id="amount">
                                <input type="hidden" asp-for="EWT" id="ewt">
                            </div>
                        </div>
                        <div class="card-footer bg-light py-3 border-top d-flex justify-content-between align-items-center">
                            <span class="summary-label">Total Input:</span>
                            <span id="manualTotalDisplay" class="h5 mb-0 fw-bold text-primary">₱ 0.00</span>
                        </div>
                    </div>

                    <!-- Deposit Details -->
                    <div class="card shadow border-0">
                        <div class="card-header bg-primary text-white p-3">
                            <h6 class="m-0 section-title"><i class="bi bi-bank me-2"></i>Deposit & Check Details</h6>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label-custom">Deposit To Bank</label>
                                    <select asp-for="BankId" id="BankId" asp-items="@Model.BankAccounts" class="form-select">
                                        <option value="">-- Select Bank --</option>
                                    </select>
                                </div>
                                
                                <div class="col-12 p-2 bg-light rounded small border" id="bankInfoPanel" style="display: none;">
                                    <div class="row g-1">
                                        <div class="col-4 text-muted">Bank:</div>
                                        <div class="col-8 fw-bold" id="displayBank"></div>
                                        <div class="col-4 text-muted">Acc #:</div>
                                        <div class="col-8 fw-bold" id="displayAccountNo"></div>
                                        <div class="col-4 text-muted">Name:</div>
                                        <div class="col-8 fw-bold" id="displayAccountName"></div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <label class="form-label-custom">Check # <span class="required-star">*</span></label>
                                    <input asp-for="CheckNumber" id="CheckNumber" type="text" class="form-control" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label-custom">Check Date <span class="required-star">*</span></label>
                                    <input asp-for="CheckDate" id="CheckDate" type="date" class="form-control" required>
                                </div>
                                <div class="col-12">
                                    <label class="form-label-custom">Date Deposited <span class="required-star">*</span></label>
                                    <input asp-for="DepositDate" id="DepositDate" type="date" class="form-control" required>
                                </div>

                                <div class="col-6 border-top pt-2">
                                    <label class="form-label-custom">Issuing Bank</label>
                                    <input asp-for="CheckBank" type="text" class="form-control">
                                </div>
                                <div class="col-6 border-top pt-2">
                                    <label class="form-label-custom">Issuing Branch</label>
                                    <input asp-for="CheckBranch" type="text" class="form-control">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts
{
    <script>
        $(document).ready(function () {
            let table;
            const customerId = $('#customerId').val();
            const collectionId = $('#CollectionId').val();
            
            initializeDataTable();
            setupEventListeners();

            // Initial state triggers
            handleCheckboxChanged();
            if (customerId) {
                fetchCustomerDetails(customerId);
                loadBillings(customerId, collectionId);
            }
            if ($('#BankId').val()) {
                handleBankChange();
            }
            
            calculateManualTotal();

            function initializeDataTable() {
                table = $('#billingsTable').DataTable({
                    paging: true,
                    info: true,
                    order: [[1, 'asc']],
                    lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                    dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                         "<'row'<'col-sm-12'tr>>" +
                         "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                    columns: [
                        {
                            data: 'msapBillingId',
                            orderable: false,
                            className: 'text-center',
                            render: function(data, type, row) {
                                const checked = row.isSelected ? 'checked' : '';
                                return `<input type="checkbox" class="bill-checkbox form-check-input" value="${data}" data-gross="${row.amount}" data-ewt="${row.ewt}" data-net="${row.net}" ${checked}>`;
                            }
                        },
                        { 
                            data: 'msapBillingNumber', 
                            className: 'fw-bold text-primary' 
                        },
                        {
                            data: 'date',
                            className: 'text-center small',
                            render: function(data) {
                                return data ? new Date(data).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) : '';
                            }
                        },
                        {
                            data: 'amount',
                            className: 'text-end fw-bold',
                            render: function(data) { return `₱ ${formatNumber(data)}`; }
                        },
                        {
                            data: 'ewt',
                            className: 'text-end text-danger',
                            render: function(data) { return `₱ ${formatNumber(data)}`; }
                        },
                        {
                            data: 'net',
                            className: 'text-end fw-bold text-success',
                            render: function(data) { return `₱ ${formatNumber(data)}`; }
                        }
                    ],
                    drawCallback: function() {
                        updateTotals();
                    }
                });
            }

            function setupEventListeners() {
                $('#isUndocumentedCheckbox').on('change', handleCheckboxChanged);
                $('#BankId').on('change', handleBankChange);

                $('#billingsTable tbody').on('click', 'tr', function(e) {
                    if (e.target.type !== 'checkbox') {
                        const $cb = $(this).find('.bill-checkbox');
                        $cb.prop('checked', !$cb.prop('checked')).trigger('change');
                    }
                });

                $('#billingsTable tbody').on('change', '.bill-checkbox', function() {
                    updateTotals();
                });

                $('#selectAll').on('change', function() {
                    $('.bill-checkbox').prop('checked', this.checked).trigger('change');
                });

                $('#cashAmount, #checkAmount, #wvat').on('input', function() {
                    calculateManualTotal();
                });
            }

            function fetchCustomerDetails(id) {
                $.ajax({
                    url: '@Url.Action("GetCustomerDetails", "Billing", new { area = "User" })',
                    method: "POST",
                    data: { customerId: id },
                    success: function (data) {
                        $("#CustomerDetailsSection").removeClass("d-none");
                        $("#CustomerAddress").text(data.address || '-');
                        $("#CustomerTIN").text(data.tinNo || '-');
                        $("#CustomerTerms").text(data.terms || '-');
                    }
                });
            }

            function handleBankChange() {
                const bankId = $('#BankId').val();
                if (bankId) {
                    $.ajax({
                        url: '@Url.Action("GetBankAccountDetails", "Collection", new { area = "User" })',
                        type: 'GET',
                        data: { bankId: bankId },
                        success: function (response) {
                            if (response.success) {
                                $('#bankInfoPanel').show();
                                $('#displayBank').text(response.bank.bank);
                                $('#displayAccountNo').text(response.bank.accountNo);
                                $('#displayAccountName').text(response.bank.accountName);
                            }
                        }
                    });
                } else {
                    $('#bankInfoPanel').hide();
                }
            }

            function handleCheckboxChanged() {
                const $checkbox = $('#isUndocumentedCheckbox');
                const $inputField = $('#msapCollectionNumber');
                const $statusLabel = $('#statusLabel');

                if ($checkbox.is(':checked')) {
                    $statusLabel.text('Undocumented Collection');
                    $inputField.prop({ required: false, readonly: true }).addClass('bg-light');
                } else {
                    $statusLabel.html('Collection Receipt # <span class="required-star">*</span>');
                    $inputField.prop({ required: true, readonly: false }).removeClass('bg-light');
                }
            }

            function loadBillings(cId, colId) {
                table.clear().draw();
                $.ajax({
                    url: '@Url.Action("GetUncollectedBillingsForTable", "Collection", new { area = "User" })',
                    type: 'GET',
                    data: { customerId: cId, collectionId: colId },
                    success: function (response) {
                        if (response.success) {
                            table.rows.add(response.data).draw();
                        }
                    }
                });
            }

            function updateTotals() {
                let grossTotal = 0, ewtTotal = 0, netTotal = 0;
                const $hiddenSelect = $('#hiddenBillingsSelect');
                $hiddenSelect.empty();

                $('.bill-checkbox:checked').each(function() {
                    const id = $(this).val();
                    const gross = parseFloat($(this).data('gross'));
                    const ewt = parseFloat($(this).data('ewt'));
                    const net = parseFloat($(this).data('net'));

                    grossTotal += gross;
                    ewtTotal += ewt;
                    netTotal += net;

                    $hiddenSelect.append(`<option value="${id}" selected>${id}</option>`);
                });

                $('#billingsTotal').text(`₱ ${formatNumber(grossTotal)}`);
                $('#ewtTotalDisplay').text(`₱ ${formatNumber(ewtTotal)}`);
                $('#netAmountDisplay').text(`₱ ${formatNumber(netTotal)}`);
                
                $('#ewt').val(ewtTotal.toFixed(2));
                
                calculateManualTotal();
            }

            function calculateManualTotal() {
                const cash = parseFloat($('#cashAmount').val()) || 0;
                const check = parseFloat($('#checkAmount').val()) || 0;
                const wvat = parseFloat($('#wvat').val()) || 0;
                
                const total = cash + check + wvat;
                
                $('#amount').val(total.toFixed(2));
                $('#manualTotalDisplay').text(`₱ ${formatNumber(total)}`);
                
                const netToMatch = parseFloat($('#netAmountDisplay').text().replace('₱ ', '').replace(/,/g, '')) || 0;
                if (Math.abs(total - netToMatch) > 0.01 && netToMatch > 0) {
                    $('#manualTotalDisplay').removeClass('text-primary text-success').addClass('text-danger');
                } else if (netToMatch > 0) {
                    $('#manualTotalDisplay').removeClass('text-primary text-danger').addClass('text-success');
                } else {
                    $('#manualTotalDisplay').removeClass('text-success text-danger').addClass('text-primary');
                }
            }
        });
    </script>
}
