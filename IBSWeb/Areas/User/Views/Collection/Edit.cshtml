@model CreateCollectionViewModel

@{
    ViewData["Title"] = "Collection - Edit";
}

<style>
    .container {
        max-width: 100% !important;
        width: 100% !important;
    }

    .section-header {
        font-size: 1rem;
        font-weight: 600;
        margin-top: 1.5rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
    }

    table {
        table-layout: auto !important;
        font-size: 0.85rem !important;
    }

    .card-body {
        margin: 5px !important;
        padding: 5px !important;
    }

    .totals-box {
        background-color: #f8f9fa;
        border-radius: 0.5rem;
        padding: 1rem;
        border: 1px solid #dee2e6;
    }
</style>

<link rel="stylesheet" href="~/css/form-style.css">

<div class="card shadow mt-4">

    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="col-12 text-center text-white">
            <h2 class="py-2">@ViewData["Title"]</h2>
        </div>
    </div>

    <div class="card-body">
        <div class="border-2 px-3">
            <form method="post" class="row">
                <div class="border-2 px-3">
                    <div asp-validation-summary="ModelOnly"></div>
                    <input asp-for="MsapCollectionId" value="@Model.MsapCollectionId" id="CollectionId" type="hidden">

                    <!-- I. Collection Information -->
                    <h5 class="section-header text-secondary border-bottom"><i class="bi bi-wallet2 me-2"></i>I. Collection Information</h5>
                    <div class="row">
                        <div class="form-group col-md-4 col-12 my-2">
                            <label class="control-label ps-1 pb-1">Customer<span class="required text-danger">*</span></label>
                            <input id="customerIsVatable" type="hidden">
                            <input name="CustomerId" value="@Model.CustomerId" type="hidden">
                            <select asp-for="CustomerId" id="customerId" asp-items="@Model.Customers" class="form-select js-select2 border-0 shadow ms-5 mt-4" style="width:100%" disabled>
                                <option value="">Select Customer</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger"></span>
                        </div>
                        <div class="form-floating col-md-4 col-6 my-2">
                            <input asp-for="MsapCollectionNumber" type="text" class="form-control border-0 shadow bg-light" id="MsapCollectionNumber" placeholder=" " readonly>
                            <label asp-for="MsapCollectionNumber" for="MsapCollectionNumber" class="ms-2" id="status">Collection Receipt #<span class="required text-danger">*</span></label>
                            <span asp-validation-for="MsapCollectionNumber" class="text-danger"></span>
                        </div>
                        <div class="form-check col-md-4 col-6 ps-2 my-2 text-start d-flex align-items-center justify-content-start">
                            <input asp-for="IsUndocumented" value="@Model.IsUndocumented" type="hidden">
                            <input class="form-check-input m-0 ms-2" type="checkbox" checked="@Model.IsUndocumented" id="isUndocumentedCheckbox" disabled>
                            <label class="text-decoration-underline form-check-label ps-1 h4 m-0" for="isUndocumentedCheckbox" style="font-size: 20px;">
                                Undocumented
                            </label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-floating col-md-4 col-6 my-2">
                            <input asp-for="Date" id="Date" type="date" class="form-control border-0 shadow">
                            <label asp-for="Date" for="Date" class="ms-2">Collection Date</label>
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>
                        <div class="form-floating col-md-4 col-6 my-2">
                            <input asp-for="ReferenceNo" type="text" class="form-control border-0 shadow" placeholder="Reference No">
                            <label asp-for="ReferenceNo" class="ms-2">Reference No</label>
                            <span asp-validation-for="ReferenceNo" class="text-danger"></span>
                        </div>
                        <div class="form-floating col-md-4 col-12 my-2">
                            <input asp-for="Remarks" type="text" class="form-control border-0 shadow" placeholder="Remarks">
                            <label asp-for="Remarks" class="ms-2">Remarks</label>
                            <span asp-validation-for="Remarks" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- II. Payment Details -->
                    <h5 class="section-header text-secondary border-bottom"><i class="bi bi-cash-stack me-2"></i>II. Payment Details</h5>
                    <div class="row">
                        <input type="hidden" id="undeductedAmount" value="@Model.Amount">
                        <input type="hidden" value="@Model.Amount" id="amount">
                        <div class="form-floating col-md-4 col-6 my-2">
                            <input type="number" step="0.01" class="form-control border-0 shadow" name="Amount" id="amountShow" value="@Model.Amount" placeholder=" " min="0">
                            <label class="ms-2">Amount</label>
                        </div>
                        <input type="hidden" value="@Model.EWT" id="ewt">
                        <div class="form-floating col-md-4 col-6 my-2">
                            <input type="number" step="0.01" class="form-control border-0 shadow" name="EWT" id="ewtShow" value="@Model.EWT" placeholder=" " min="0">
                            <label class="ms-2">EWT</label>
                        </div>
                        <div class="form-floating col-md-4 col-12 my-2">
                            <select asp-for="BankId" asp-items="@Model.BankAccounts" class="form-select border-0 shadow">
                                <option value="">--Select Bank--</option>
                            </select>
                            <label asp-for="BankId" class="ms-2">Deposit To Bank</label>
                        </div>
                    </div>
                    <div class="row">
                         <div class="form-floating col-md-4 col-6 my-2">
                            <input asp-for="WVAT" type="number" step="0.01" class="form-control border-0 shadow" id="wvat" value="@Model.WVAT">
                            <label asp-for="WVAT" class="ms-2">WVAT</label>
                        </div>
                    </div>

                    <!-- III. Deposit & Check Details -->
                    <h5 class="section-header text-secondary border-bottom"><i class="bi bi-bank me-2"></i>III. Deposit & Check Details</h5>
                    <div class="row">
                        <div class="form-floating col-md-4 col-6 my-2">
                            <input type="text" class="form-control border-0 shadow bg-light" id="displayBank" placeholder=" " readonly>
                            <label class="ms-2">Deposit Bank</label>
                        </div>
                        <div class="form-floating col-md-4 col-6 my-2">
                            <input type="text" class="form-control border-0 shadow bg-light" id="displayAccountNo" placeholder=" " readonly>
                            <label class="ms-2">Account Number</label>
                        </div>
                        <div class="form-floating col-md-4 col-12 my-2">
                            <input type="text" class="form-control border-0 shadow bg-light" id="displayAccountName" placeholder=" " readonly>
                            <label class="ms-2">Account Name</label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-floating col-md-4 col-6 my-2">
                            <input asp-for="CheckNumber" id="CheckNumber" type="text" class="form-control border-0 shadow" placeholder=" " required>
                            <label asp-for="CheckNumber" for="CheckNumber" class="ms-2">Check Number<span class="required text-danger">*</span></label>
                            <span asp-validation-for="CheckNumber" class="text-danger"></span>
                        </div>
                        <div class="form-floating col-md-4 col-6 my-2">
                            <input asp-for="CheckDate" id="CheckDate" type="date" class="form-control border-0 shadow" required>
                            <label asp-for="CheckDate" for="CheckDate" class="ms-2">Check Date<span class="required text-danger">*</span></label>
                            <span asp-validation-for="CheckDate" class="text-danger"></span>
                        </div>
                        <div class="form-floating col-md-4 col-12 my-2">
                            <input asp-for="DepositDate" id="DepositDate" type="date" class="form-control border-0 shadow" required>
                            <label asp-for="DepositDate" for="DepositDate" class="ms-2">Date Deposited<span class="required text-danger">*</span></label>
                            <span asp-validation-for="DepositDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- IV. Billing Settlement -->
                    <h5 class="section-header text-secondary border-bottom"><i class="bi bi-list-check me-2"></i>IV. Billing Settlement</h5>
                    <div class="row">
                        <div class="col-12 mt-3">
                            <div class="table-responsive">
                                <table id="billingsTable" class="table table-striped table-bordered" style="width: 100%">
                                    <thead>
                                    <tr>
                                        <th class="text-center"><input type="checkbox" id="selectAll"></th>
                                        <th class="text-center">BILLING NUMBER</th>
                                        <th class="text-center">DATE</th>
                                        <th class="text-center">GROSS AMOUNT</th>
                                        <th class="text-center">EWT</th>
                                        <th class="text-center">NET AMOUNT</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Hidden Select for Model Binding -->
                            <select asp-for="ToCollectBillings" id="hiddenBillingsSelect" multiple="multiple" style="display: none;"></select>

                            <div class="row pt-2 justify-content-end d-flex">
                                <div class="col-md-3 col-6 totals-box shadow-sm text-center">
                                    <label class="fw-bold">Total Selected (Gross):</label><br/>
                                    <span id="billingsTotal" class="text-primary fw-bold" style="font-size: 1.1rem;">₱ 0.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row justify-content-end mt-4 mb-3 gap-2">
                    <div class="text-center" style="width: 200px;">
                        <button class="btn btn-primary custom-btn w-100 shadow" type="submit" id="submitButton"><i class="bi bi-pencil-square"></i> Submit</button>
                    </div>
                    <div class="text-center" style="width: 200px;">
                        <a class="btn btn-outline-primary w-100 shadow" asp-controller="Collection" asp-action="Index">
                            <i class="bi bi-arrow-90deg-left"></i> Go Back
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $(document).ready(function () {
            let table;

            initializeDataTable();
            setupEventListeners();

            // Startup logic
            handleCheckboxChanged();
            if ($('#customerId').val()) {
                loadBillings($('#customerId').val(), $('#CollectionId').val());
            }
            if ($('#BankId').val()) {
                handleBankChange();
            }

            function initializeDataTable() {
                table = $('#billingsTable').DataTable({
                    paging: true,
                    info: true,
                    order: [[1, 'asc']],
                    lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                    columns: [
                        {
                            data: 'msapBillingId',
                            orderable: false,
                            className: 'text-center',
                            render: function(data, type, row) {
                                let checked = row.isSelected ? 'checked' : '';
                                return `<input type="checkbox" class="bill-checkbox" value="${data}" data-gross="${row.amount}" data-ewt="${row.ewt}" data-net="${row.net}" ${checked}>`;
                            }
                        },
                        { data: 'msapBillingNumber', className: 'text-center' },
                        {
                            data: 'date',
                            className: 'text-center',
                            render: function(data) {
                                return data ? new Date(data).toLocaleDateString() : '';
                            }
                        },
                        {
                            data: 'amount',
                            className: 'text-end',
                            render: function(data) { return `₱ ${formatNumber(data)}`; }
                        },
                        {
                            data: 'ewt',
                            className: 'text-end',
                            render: function(data) { return `₱ ${formatNumber(data)}`; }
                        },
                        {
                            data: 'net',
                            className: 'text-end',
                            render: function(data) { return `₱ ${formatNumber(data)}`; }
                        }
                    ],
                    drawCallback: function() {
                        updateTotals(); // Ensure totals are correct after table draw (especially on startup)
                    }
                });
            }

            function setupEventListeners() {
                $('#isUndocumentedCheckbox').on('change', handleCheckboxChanged);
                $('#BankId').on('change', handleBankChange);

                // Checkbox interaction
                $('#billingsTable tbody').on('change', '.bill-checkbox', function() {
                    updateSelectedBillings();
                });

                $('#selectAll').on('change', function() {
                    $('.bill-checkbox').prop('checked', this.checked);
                    updateSelectedBillings();
                });

                $('#amountShow, #ewtShow, #wvat').on('input', function() {
                    calculateManualTotal();
                });
            }

            function handleBankChange() {
                const bankId = $('#BankId').val();
                if (bankId) {
                    $.ajax({
                        url: '@Url.Action("GetBankAccountDetails", "Collection", new { area = "User" })',
                        type: 'GET',
                        data: { bankId: bankId },
                        success: function (response) {
                            if (response.success) {
                                $('#displayBank').val(response.bank);
                                $('#displayAccountNo').val(response.accountNo);
                                $('#displayAccountName').val(response.accountName);
                            }
                        }
                    });
                } else {
                    $('#displayBank, #displayAccountNo, #displayAccountName').val('');
                }
            }

            function handleCheckboxChanged() {
                const $checkbox = $('#isUndocumentedCheckbox');
                const $inputField = $('#MsapCollectionNumber');
                const $status = $('#status');

                if ($checkbox.is(':checked')) {
                    $status.text('Undocumented');
                    $inputField.prop({ required: false, readonly: true });
                } else {
                    $status.html('Collection Receipt #<span class="required text-danger">*</span>');
                    $inputField.prop({ required: true, readonly: false });
                }
            }

            function loadBillings(customerId, collectionId) {
                $.ajax({
                    url: '@Url.Action("GetUncollectedBillingsForTable", "Collection", new { area = "User" })',
                    type: 'GET',
                    data: { customerId: customerId, collectionId: collectionId },
                    success: function (response) {
                        if (response.success) {
                            table.clear().rows.add(response.data).draw();
                        }
                    }
                });
            }

            function updateSelectedBillings() {
                updateTotals();
            }

            function updateTotals() {
                let grossTotal = 0, ewtTotal = 0, netTotal = 0;
                const $hiddenSelect = $('#hiddenBillingsSelect');
                $hiddenSelect.empty();

                $('.bill-checkbox:checked').each(function() {
                    const id = $(this).val();
                    const gross = parseFloat($(this).data('gross'));
                    const ewt = parseFloat($(this).data('ewt'));
                    const net = parseFloat($(this).data('net'));

                    grossTotal += gross;
                    ewtTotal += ewt;
                    netTotal += net;

                    $hiddenSelect.append(`<option value="${id}" selected>${id}</option>`);
                });

                $('#billingsTotal').text(`₱ ${formatNumber(grossTotal)}`);
                // For edit mode, we might not want to auto-overwrite manual changes if the user already adjusted them,
                // but for consistency with the new flow, we update them.
                $('#ewt').val(ewtTotal.toFixed(2));
                $('#ewtShow').val(ewtTotal.toFixed(2));
                $('#amount').val(netTotal.toFixed(2));
                $('#amountShow').val(netTotal.toFixed(2));
            }

            function calculateManualTotal() {
                // Sync manual inputs to hidden fields
                $('#amount').val($('#amountShow').val());
                $('#ewt').val($('#ewtShow').val());
            }
        });
    </script>
}
