@model CreateCollectionViewModel

@{
    ViewData["Title"] = "Edit Collection";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <form id="myForm" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="MsapCollectionId" id="CollectionId" type="hidden">
        <input asp-for="CustomerId" id="customerId" type="hidden">

        <main class="modern-container">
            <!-- Header -->
            <div class="flex-stack">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="modern-label">MSAP</span>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <a class="modern-label" style="text-decoration:none;" asp-action="Index">Collections</a>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <span class="modern-label" style="color: var(--on-surface)">@Model.MsapCollectionNumber</span>
                    </div>
                    <h1 class="modern-headline-lg">Edit Collection Details</h1>
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="modern-btn-primary" id="submitButton">
                        <span class="material-symbols-outlined">save</span> UPDATE COLLECTION
                    </button>
                    <a class="modern-btn-secondary" asp-action="Index">
                        <span class="material-symbols-outlined">arrow_back</span> BACK
                    </a>
                </div>
            </div>

            <div class="modern-grid">
                <!-- Left Column: Logistics & Billings (col-8) -->
                <div class="modern-col-8 flex flex-column" style="gap: 1.5rem;">
                    <!-- Collection Info -->
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">info</span>
                            <h2 class="modern-headline-md">1. Collection Information</h2>
                        </div>
                        <div class="modern-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>
                            
                            <div class="modern-grid">
                                <div class="modern-col-8">
                                    <label class="modern-label">Customer</label>
                                    <input type="text" class="modern-input" style="background-color: var(--surface-container-low); font-weight: bold;" value="@Model.Customers?.FirstOrDefault(x => x.Value == Model.CustomerId.ToString())?.Text" readonly>
                                </div>
                                <div class="modern-col-4">
                                    <label class="modern-label">Collection Date</label>
                                    <input asp-for="Date" type="date" class="modern-input">
                                    <span asp-validation-for="Date" class="text-error text-xs"></span>
                                </div>
                            </div>

                            <!-- Customer Metadata -->
                            <div id="CustomerDetailsSection" class="border-t border-outline-variant pt-3 mt-3" style="display: none; gap: 1rem; flex-direction: column;">
                                <div class="modern-grid-compact">
                                    <div class="modern-col-6">
                                        <p class="modern-label">Address</p>
                                        <p id="CustomerAddress" class="modern-value-md">-</p>
                                    </div>
                                    <div class="modern-col-3">
                                        <p class="modern-label">TIN</p>
                                        <p id="CustomerTIN" class="modern-value-md font-bold">-</p>
                                    </div>
                                    <div class="modern-col-3">
                                        <p class="modern-label">Terms</p>
                                        <p id="CustomerTerms" class="modern-value-md font-bold">-</p>
                                    </div>
                                </div>
                            </div>

                            <div class="modern-grid mt-4 pt-4 border-t border-outline-variant">
                                <div class="modern-col-6">
                                    <label class="modern-label" id="statusLabel">Collection Receipt # <span class="text-error">*</span></label>
                                    <div class="flex items-center gap-2">
                                        <input asp-for="MsapCollectionNumber" type="text" class="modern-input" id="msapCollectionNumber">
                                        <div class="flex items-center gap-2 border border-outline-variant rounded-md px-3" style="height: 38px; min-width: 140px;">
                                            <input type="hidden" asp-for="IsUndocumented" id="IsUndocumented" />
                                            <input class="form-check-input" type="checkbox" id="isUndocumentedCheckbox" @(Model.IsUndocumented ? "checked" : "") disabled>
                                            <span class="text-xs font-bold opacity-70">UNDOCUMENTED</span>
                                        </div>
                                    </div>
                                    <span asp-validation-for="MsapCollectionNumber" class="text-error text-xs"></span>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label">Reference Number</label>
                                    <input asp-for="ReferenceNo" type="text" class="modern-input" placeholder="e.g. OR#, Check #">
                                </div>
                            </div>

                            <div class="mt-3">
                                <label class="modern-label">Remarks</label>
                                <textarea asp-for="Remarks" class="modern-input" style="min-height: 80px;" placeholder="Optional remarks..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Billing Settlement Table -->
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">receipt_long</span>
                            <h2 class="modern-headline-md">2. Billing Settlement</h2>
                        </div>
                        <div class="modern-card-body">
                            <div class="modern-table-container border border-outline-variant">
                                <table id="billingsTable" class="modern-table">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 48px;"><input type="checkbox" id="selectAll" class="form-check-input"></th>
                                            <th>BILLING #</th>
                                            <th class="text-center">DATE</th>
                                            <th class="text-right">GROSS</th>
                                            <th class="text-right">EWT</th>
                                            <th class="text-right">NET</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Populated via JS -->
                                    </tbody>
                                </table>
                            </div>
                            <!-- Hidden Select for Model Binding -->
                            <select asp-for="ToCollectBillings" id="hiddenBillingsSelect" multiple="multiple" style="display: none;"></select>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Payment & Deposit (col-4) -->
                <div class="modern-col-4 flex flex-column" style="gap: 1.5rem;">
                    <!-- Payment Summary -->
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">payments</span>
                            <h2 class="modern-headline-md">3. Payment Summary</h2>
                        </div>
                        <div class="modern-card-body">
                            <div class="financial-summary-card mb-4" style="flex-direction: column; gap: 0.75rem;">
                                <div class="financial-item">
                                    <span class="financial-label">Settlement Net</span>
                                    <span class="financial-value primary" id="netAmountDisplay">₱ 0.00</span>
                                </div>
                                <div class="financial-divider" style="width: 100%; height: 1px;"></div>
                                <div class="financial-item">
                                    <span class="financial-label">Total Input</span>
                                    <span class="financial-value secondary" id="manualTotalDisplay">₱ 0.00</span>
                                </div>
                            </div>

                            <div class="flex flex-column" style="gap: 1rem;">
                                <div>
                                    <label class="modern-label">Cash Payment</label>
                                    <div class="relative">
                                        <span class="absolute" style="left: 12px; top: 50%; transform: translateY(-50%); font-weight: bold; opacity: 0.5;">₱</span>
                                        <input asp-for="CashAmount" type="number" step="0.01" class="modern-input" style="padding-left: 30px; font-weight: bold; color: var(--primary);" id="cashAmount">
                                    </div>
                                </div>
                                <div>
                                    <label class="modern-label">Check Payment</label>
                                    <div class="relative">
                                        <span class="absolute" style="left: 12px; top: 50%; transform: translateY(-50%); font-weight: bold; opacity: 0.5;">₱</span>
                                        <input asp-for="CheckAmount" type="number" step="0.01" class="modern-input" style="padding-left: 30px; font-weight: bold; color: var(--primary);" id="checkAmount">
                                    </div>
                                </div>
                                <div>
                                    <label class="modern-label">WVAT Withheld</label>
                                    <div class="relative">
                                        <span class="absolute" style="left: 12px; top: 50%; transform: translateY(-50%); font-weight: bold; opacity: 0.5;">₱</span>
                                        <input asp-for="WVAT" type="number" step="0.01" class="modern-input" style="padding-left: 30px;" id="wvat">
                                    </div>
                                </div>

                                <div class="border-t border-outline-variant pt-3 modern-grid-compact">
                                    <div class="modern-col-6">
                                        <p class="modern-label">Gross Total</p>
                                        <p id="billingsTotal" class="modern-value-md font-bold">₱ 0.00</p>
                                    </div>
                                    <div class="modern-col-6">
                                        <p class="modern-label">Total EWT</p>
                                        <p id="ewtTotalDisplay" class="modern-value-md font-bold text-error">₱ 0.00</p>
                                    </div>
                                </div>
                                
                                <input type="hidden" asp-for="Amount" id="amount">
                                <input type="hidden" asp-for="EWT" id="ewt">
                            </div>
                        </div>
                    </div>

                    <!-- Deposit Details -->
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">account_balance</span>
                            <h2 class="modern-headline-md">4. Deposit & Check Details</h2>
                        </div>
                        <div class="modern-card-body">
                            <div class="flex flex-column" style="gap: 1rem;">
                                <div>
                                    <label class="modern-label">Deposit To Bank</label>
                                    <select asp-for="BankId" id="BankId" asp-items="@Model.BankAccounts" class="js-modern-select" data-placeholder="Select Bank Account...">
                                        <option value="">-- Select Bank --</option>
                                    </select>
                                </div>

                                <div id="bankInfoPanel" class="bg-surface-container-low p-3 rounded-md border border-outline-variant" style="display: none;">
                                    <div class="modern-grid-compact">
                                        <div class="modern-col-4 opacity-60 text-xs uppercase font-bold">Bank</div>
                                        <div class="modern-col-8 text-xs font-bold" id="displayBank"></div>
                                        <div class="modern-col-4 opacity-60 text-xs uppercase font-bold">Acc #</div>
                                        <div class="modern-col-8 text-xs font-bold" id="displayAccountNo"></div>
                                        <div class="modern-col-4 opacity-60 text-xs uppercase font-bold">Name</div>
                                        <div class="modern-col-8 text-xs font-bold" id="displayAccountName"></div>
                                    </div>
                                </div>

                                <div class="modern-grid-compact">
                                    <div class="modern-col-6">
                                        <label class="modern-label">Check # <span class="text-error">*</span></label>
                                        <input asp-for="CheckNumber" id="CheckNumber" type="text" class="modern-input" required>
                                    </div>
                                    <div class="modern-col-6">
                                        <label class="modern-label">Check Date <span class="text-error">*</span></label>
                                        <input asp-for="CheckDate" id="CheckDate" type="date" class="modern-input" required>
                                    </div>
                                </div>

                                <div>
                                    <label class="modern-label">Date Deposited <span class="text-error">*</span></label>
                                    <input asp-for="DepositDate" id="DepositDate" type="date" class="modern-input" required>
                                </div>

                                <div class="modern-grid-compact border-t border-outline-variant pt-3">
                                    <div class="modern-col-6">
                                        <label class="modern-label">Issuing Bank</label>
                                        <input asp-for="CheckBank" type="text" class="modern-input">
                                    </div>
                                    <div class="modern-col-6">
                                        <label class="modern-label">Issuing Branch</label>
                                        <input asp-for="CheckBranch" type="text" class="modern-input">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </form>
</div>

@section Scripts
{
    <script>
        $(document).ready(function () {
            let table;
            const customerId = $('#customerId').val();
            const collectionId = $('#CollectionId').val();
            
            initializeDataTable();
            setupEventListeners();

            // Initial state triggers
            handleCheckboxChanged();
            if (customerId) {
                fetchCustomerDetails(customerId);
                loadBillings(customerId, collectionId);
            }
            if ($('#BankId').val()) {
                handleBankChange();
            }
            
            calculateManualTotal();

            function initializeDataTable() {
                table = $('#billingsTable').DataTable({
                    paging: true,
                    info: true,
                    order: [[1, 'asc']],
                    dom: '<"modern-table-container"t><"flex-stack mt-2"ip>',
                    columns: [
                        {
                            data: 'msapBillingId',
                            orderable: false,
                            className: 'text-center',
                            defaultContent: '',
                            render: function(data, type, row) {
                                const checked = row.isSelected ? 'checked' : '';
                                return `<input type="checkbox" class="bill-checkbox form-check-input" value="${data}" data-gross="${row.amount}" data-ewt="${row.ewt}" data-net="${row.net}" ${checked} style="width: 18px; height: 18px; cursor: pointer;">`;
                            }
                        },
                        { 
                            data: 'msapBillingNumber', 
                            className: 'font-bold',
                            defaultContent: ''
                        },
                        {
                            data: 'date',
                            className: 'text-center',
                            defaultContent: '',
                            render: function(data) {
                                return data ? new Date(data).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }) : '-';
                            }
                        },
                        {
                            data: 'amount',
                            className: 'text-right font-bold',
                            defaultContent: '₱0.00',
                            render: function(data) { return `₱${formatNumber(data)}`; }
                        },
                        {
                            data: 'ewt',
                            className: 'text-right text-error',
                            defaultContent: '₱0.00',
                            render: function(data) { return `₱${formatNumber(data)}`; }
                        },
                        {
                            data: 'net',
                            className: 'text-right font-bold',
                            defaultContent: '₱0.00',
                            render: function(data) { return `₱${formatNumber(data)}`; }
                        }
                    ],
                    drawCallback: function() {
                        updateTotals();
                    }
                });
            }

            function setupEventListeners() {
                $('#BankId').on('change', handleBankChange);

                // Row click selects checkbox
                $('#billingsTable tbody').on('click', 'tr', function(e) {
                    if (e.target.type !== 'checkbox') {
                        const $cb = $(this).find('.bill-checkbox');
                        $cb.prop('checked', !$cb.prop('checked')).trigger('change');
                    }
                });

                $('#billingsTable tbody').on('change', '.bill-checkbox', function() {
                    updateTotals();
                });

                $('#selectAll').on('change', function() {
                    $('.bill-checkbox').prop('checked', this.checked).trigger('change');
                });

                $('#cashAmount, #checkAmount, #wvat').on('input', function() {
                    calculateManualTotal();
                });
                
                $('#submitButton').on('click', areYouSureToUpdate);
            }

            function fetchCustomerDetails(id) {
                $.ajax({
                    url: '@Url.Action("GetCustomerDetails", "Billing", new { area = "User" })',
                    method: "POST",
                    data: { customerId: id },
                    success: function (data) {
                        $("#CustomerDetailsSection").show().css('display', 'flex');
                        $("#CustomerAddress").text(data.address || '-');
                        $("#CustomerTIN").text(data.tinNo || '-');
                        $("#CustomerTerms").text(data.terms || '-');
                    }
                });
            }

            function handleBankChange() {
                const bankId = $('#BankId').val();
                if (bankId) {
                    $.ajax({
                        url: '@Url.Action("GetBankAccountDetails", "Collection", new { area = "User" })',
                        type: 'GET',
                        data: { bankId: bankId },
                        success: function (response) {
                            if (response.success) {
                                $('#bankInfoPanel').show();
                                $('#displayBank').text(response.bank.bank);
                                $('#displayAccountNo').text(response.bank.accountNo);
                                $('#displayAccountName').text(response.bank.accountName);
                            }
                        }
                    });
                } else {
                    $('#bankInfoPanel').hide();
                }
            }

            function handleCheckboxChanged() {
                const $checkbox = $('#isUndocumentedCheckbox');
                const $inputField = $('#msapCollectionNumber');
                const $statusLabel = $('#statusLabel');

                if ($checkbox.is(':checked')) {
                    $statusLabel.text('Collection Receipt #');
                    $inputField.prop({ required: false, readonly: true }).css('background-color', 'var(--surface-container-low)');
                } else {
                    $statusLabel.html('Collection Receipt # <span class="text-error">*</span>');
                    $inputField.prop({ required: true, readonly: false }).css('background-color', 'transparent');
                }
            }

            function loadBillings(cId, colId) {
                table.clear().draw();
                $.ajax({
                    url: '@Url.Action("GetUncollectedBillingsForTable", "Collection", new { area = "User" })',
                    type: 'GET',
                    data: { customerId: cId, collectionId: colId },
                    success: function (response) {
                        if (response.success) {
                            table.rows.add(response.data).draw();
                        }
                    }
                });
            }

            function updateTotals() {
                let grossTotal = 0, ewtTotal = 0, netTotal = 0;
                const $hiddenSelect = $('#hiddenBillingsSelect');
                $hiddenSelect.empty();

                $('.bill-checkbox:checked').each(function() {
                    const id = $(this).val();
                    const gross = parseFloat($(this).data('gross'));
                    const ewt = parseFloat($(this).data('ewt'));
                    const net = parseFloat($(this).data('net'));

                    grossTotal += gross;
                    ewtTotal += ewt;
                    netTotal += net;

                    $hiddenSelect.append(`<option value="${id}" selected>${id}</option>`);
                });

                $('#billingsTotal').text(`₱${formatNumber(grossTotal)}`);
                $('#ewtTotalDisplay').text(`₱${formatNumber(ewtTotal)}`);
                $('#netAmountDisplay').text(`₱${formatNumber(netTotal)}`);
                
                $('#ewt').val(ewtTotal.toFixed(2));
                
                calculateManualTotal();
            }

            function areYouSureToUpdate(event) {
                event.preventDefault();
                const form = document.getElementById("myForm");
                if (!form.checkValidity()) { form.reportValidity(); return; }

                // Clear any existing hidden billing payments
                $('input[name^="BillingPayments"]').remove();

                // Append new hidden inputs for BillingPayments
                let index = 0;
                $('.bill-checkbox:checked').each(function() {
                    const id = $(this).val();
                    const net = parseFloat($(this).data('net'));
                    $(form).append(`<input type="hidden" name="BillingPayments[${index}].BillingId" value="${id}" />`);
                    $(form).append(`<input type="hidden" name="BillingPayments[${index}].AmountToPay" value="${net.toFixed(2)}" />`);
                    index++;
                });
                
                const netToMatch = parseFloat($('#netAmountDisplay').text().replace('₱', '').replace(/,/g, '')) || 0;
                const totalInput = parseFloat($('#amount').val()) || 0;
                
                if (netToMatch > 0 && Math.abs(totalInput - netToMatch) > 0.01) {
                    Swal.fire({ 
                        title: "Amount Mismatch", 
                        text: "The total payment input doesn't match the selected billings net amount. Do you want to proceed?", 
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonText: "Yes, proceed"
                    }).then(result => { if (result.isConfirmed) form.submit(); });
                } else {
                    Swal.fire({ 
                        title: "Update Collection?", 
                        text: "Review all details before proceeding.", 
                        icon: "question", 
                        showCancelButton: true, 
                        confirmButtonText: "Yes, update" 
                    }).then(result => { if (result.isConfirmed) form.submit(); });
                }
            }
        });
    </script>
}
