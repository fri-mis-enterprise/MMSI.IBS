@model IBS.Models.MSAP.Billing

@{
    ViewData["Title"] = "Billing - Preview";
    ViewData["IsFullWidth"] = true;
}

<style>
    .billing-statement {
        background-color: white;
        color: black;
        padding: 1.25rem;
        font-family: 'Inter', sans-serif;
    }

    .billing-statement b { font-weight: 700; }

    .statement-table {
        width: 100%;
        border-collapse: collapse;
    }

    .statement-table th, .statement-table td {
        padding: 2px 6px;
    }

    .border-bottom-dark { border-bottom: 1px solid black; }
    .border-top-dark { border-top: 1px solid black; }
    .border-dark { border: 1px solid black; }

    @@media print {
        @@page {
            margin: 0.3in 0.4in;
        }
        .modern-layout { background: white !important; }
        .modern-container { padding: 0 !important; margin: 0 !important; }
        .flex-stack, .buttons-row { display: none !important; }
        .modern-card { border: none !important; box-shadow: none !important; border-radius: 0 !important; margin: 0 !important; padding: 0 !important; }
        .billing-statement { padding: 0 !important; margin: 0 !important; }
        body { margin: 0; padding: 0; }
        .no-print { display: none !important; }
    }
</style>

<div class="modern-layout">
    <main class="modern-container">
        <!-- Header Section (No Print) -->
        <div class="flex-stack no-print">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label">MSAP</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <a class="modern-label" style="text-decoration:none;" asp-action="Index">Billing</a>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">@Model.MsapBillingNumber</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">Preview</span>
                </div>
                <h1 class="modern-headline-lg">Billing Statement Preview</h1>
            </div>
            <div class="flex gap-2">
                <button onclick="window.print()" class="modern-btn-primary">
                    <span class="material-symbols-outlined">print</span> PRINT STATEMENT
                </button>
                <a asp-action="Print" asp-route-id="@Model.MsapBillingId" class="modern-btn-secondary">
                    <span class="material-symbols-outlined">terminal</span> DOT MATRIX
                </a>
                <a asp-action="Index" class="modern-btn-secondary">
                    <span class="material-symbols-outlined">arrow_back</span> BACK
                </a>
            </div>
        </div>

        <div class="modern-card">
            <div class="billing-statement">
                <!-- Document Header -->
                <div class="flex justify-between items-start mb-2">
                    <div style="max-width: 60%;">
                        <h3 class="font-bold" style="font-size: 20px; margin-bottom: 4px;">MALAYAN MARITIME SERVICES INC.</h3>
                        <p class="text-xs opacity-70">
                            Office Address 14th Floor Jollibee Centre, San Miguel Ave., Pasig City<br/>
                            Phone No: 633-4302 * 633-9472 * 634-4904<br/>
                            Business Office: 10 JP LAUREL AVE, SASA, DAVAO CITY<br/>
                            Mobile No: +639178202692
                        </p>
                    </div>
                    <div class="text-right">
                        <p class="text-error font-bold" style="font-size: 16px;">BILLING STATEMENT NO. @Model.MsapBillingNumber</p>
                    </div>
                </div>

                <!-- Entity Details -->
                <table class="statement-table mb-2" style="font-size: 13px;">
                    <tbody>
                        <tr>
                            <td style="width: 120px;"><b>BILLED TO:</b></td>
                            <td class="border-bottom-dark"><b>@(Model.PrincipalId != null ? Model.Principal?.PrincipalName : Model.Customer?.CustomerName)</b></td>
                            <td style="width: 40px;"></td>
                            <td style="width: 80px;"><b>DATE:</b></td>
                            <td class="border-bottom-dark">@Model.Date.ToString("MMM dd, yyyy")</td>
                        </tr>
                        <tr>
                            <td><b>ADDRESS:</b></td>
                            <td class="border-bottom-dark">@Model.AddressLine1</td>
                            <td></td>
                            <td><b>TIN:</b></td>
                            <td class="border-bottom-dark">@(Model.PrincipalId != null ? Model.Principal?.TIN : Model.Customer?.CustomerTin)</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td class="border-bottom-dark">@Model.AddressLine2</td>
                            <td></td>
                            <td><b>BUS. STYLE:</b></td>
                            <td class="border-bottom-dark">@(Model.PrincipalId != null ? Model.Principal?.BusinessType : Model.Customer?.BusinessStyle)</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td class="border-bottom-dark">@Model.AddressLine3</td>
                            <td></td>
                            <td><b>TERMS:</b></td>
                            <td class="border-bottom-dark">@(Model.PrincipalId != null ? Model.Principal?.Terms : Model.Customer?.CustomerTerms)</td>
                        </tr>
                    </tbody>
                </table>

                <!-- Particulars Section -->
                <div class="border-dark text-center py-0.5 mb-2 font-bold" style="background: #f0f0f0;">
                    PARTICULARS
                </div>

                <div class="mb-2" style="font-size: 13px;">
                    <div class="flex items-center mb-1">
                        <div style="width: 160px;"><b>FOR THE SERVICE RE:</b></div>
                        <div class="flex-grow border-bottom-dark px-2 font-bold uppercase">@Model.Vessel?.VesselName @Model.Vessel?.VesselType</div>
                        <div style="width: 100px;" class="text-right px-2"><b>VOYAGE #:</b></div>
                        <div style="width: 120px;" class="border-bottom-dark px-2">@Model.VoyageNumber</div>
                    </div>
                    <div class="flex items-center">
                        <div style="width: 160px;"></div>
                        <div class="flex-grow border-bottom-dark px-2 uppercase">AT @Model.Terminal?.Port?.PortName</div>
                        <div style="width: 220px;"></div>
                    </div>
                </div>

                <!-- Items Table -->
                <table class="statement-table mb-3" style="font-size: 12px; table-layout: fixed; border: none;">
                    <thead>
                        <tr class="border-dark" style="background: #f0f0f0;">
                            <th class="border-dark text-center" style="width: 80px;">DATE</th>
                            <th class="border-dark text-center">NATURE OF SERVICE</th>
                            <th class="border-dark text-center" style="width: 100px;">TIME START</th>
                            <th class="border-dark text-center" style="width: 100px;">TIME END</th>
                            <th class="border-dark text-center" style="width: 80px;">HOURS</th>
                            <th class="border-dark text-center" style="width: 90px;">RATE</th>
                            <th class="border-dark text-center" style="width: 100px;">AMOUNT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tugboat in Model.UniqueTugboats!)
                        {
                            <tr>
                                <td colspan="7" class="pt-1.5 pb-0.5"><b>NAME OF TUGBOAT: @tugboat</b></td>
                            </tr>
                            @foreach (var dt in Model.PaidDispatchTickets!.Where(dt => dt.Tugboat?.TugboatName == tugboat))
                            {
                                <tr>
                                    <td class="text-center">@dt.Date.ToString("dd-MMM")</td>
                                    <td>@dt.Service?.ServiceName</td>
                                    <td class="text-center">@dt.DateLeft?.ToString("MM/dd") @dt.TimeLeft</td>
                                    <td class="text-center">@dt.DateArrived?.ToString("MM/dd") @dt.TimeArrived</td>
                                    <td class="text-center">@dt.TotalHours.ToString("N2")</td>
                                    <td class="text-right">@dt.DispatchRate.ToString("N2")</td>
                                    <td class="text-right">@dt.DispatchNetRevenue.ToString("N2")</td>
                                </tr>
                            }
                        }

                        @if (Model.PaidDispatchTickets!.Any(dt => dt.BAFNetRevenue > 0))
                        {
                            <tr>
                                <td colspan="7" class="pt-2 pb-0.5 font-bold">BUNKER ADJUSTMENT FACTORS</td>
                            </tr>
                            @foreach (var dt in Model.PaidDispatchTickets!.Where(dt => dt.BAFNetRevenue > 0))
                            {
                                <tr>
                                    <td class="text-center">@dt.Date.ToString("dd-MMM")</td>
                                    <td>@dt.Service?.ServiceName (BAF)</td>
                                    <td class="text-center">@dt.DateLeft?.ToString("MM/dd") @dt.TimeLeft</td>
                                    <td class="text-center">@dt.DateArrived?.ToString("MM/dd") @dt.TimeArrived</td>
                                    <td class="text-center">@dt.TotalHours.ToString("N2")</td>
                                    <td class="text-right">@dt.BAFRate.ToString("N2")</td>
                                    <td class="text-right">@dt.BAFNetRevenue.ToString("N2")</td>
                                </tr>
                            }
                        }
                        <tr>
                            <td colspan="7" class="text-center py-2 opacity-40 italic">---------- NOTHING FOLLOWS ----------</td>
                        </tr>
                    </tbody>
                </table>

                <!-- Totals Section -->
                <div class="flex gap-5 border-top-dark pt-1.5" style="font-size: 11px; padding-block: 1rem;">
                    <div style="width: 60%;">
                        <p class="font-bold mb-1">Terms and Conditions:</p>
                        <div class="border p-2" style="font-size: 10px; line-height: 1.4; text-align: justify;">
                            Interest at the rate of 38% per annum will be charge on all overdue accounts and in the event of
                            judicial proceedings to enforce collections, the Customer will pay a reasonable compensation not less than
                            25% of the amount due of the Attorney's fees and expense of collection in addition to the costs of suit. Any
                            action arising out of the transaction covered by billing statement shall be brought in the appropriate courts
                            of Pasig City and/or Metro Manila.
                        </div>
                    </div>
                    <div class="flex-grow">
                        <table class="statement-table" style="font-size: 12px;">
                            @if (Model.IsVatable)
                            {
                                var vatableSales = Model.Amount / 1.12m;
                                var taxAmount = Model.Amount - vatableSales;
                                <tr>
                                    <td>SERVICE AMOUNT:</td>
                                    <td class="text-right border-bottom-dark"><b>@Model.DispatchAmount.ToString("N2")</b></td>
                                </tr>
                                <tr>
                                    <td>BUNKER ADJUSTMENT FACTOR:</td>
                                    <td class="text-right border-bottom-dark"><b>@Model.BAFAmount.ToString("N2")</b></td>
                                </tr>
                                <tr>
                                    <td>VATABLE SALES:</td>
                                    <td class="text-right border-bottom-dark"><b>@vatableSales.ToString("N2")</b></td>
                                </tr>
                                <tr>
                                    <td>VAT - EXEMPT SALES</td>
                                    <td class="text-right border-bottom-dark">0.00</td>
                                </tr>
                                <tr>
                                    <td>ZERO RATED SALES</td>
                                    <td class="text-right border-bottom-dark">0.00</td>
                                </tr>
                                <tr>
                                    <td>TOTAL SALES</td>
                                    <td class="text-right border-bottom-dark"><b>@vatableSales.ToString("N2")</b></td>
                                </tr>
                                <tr>
                                    <td>12% VAT</td>
                                    <td class="text-right border-bottom-dark"><b>@taxAmount.ToString("N2")</b></td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td>SERVICE AMOUNT:</td>
                                    <td class="text-right border-bottom-dark"><b>@Model.DispatchAmount.ToString("N2")</b></td>
                                </tr>
                                <tr>
                                    <td>BUNKER ADJUSTMENT FACTOR:</td>
                                    <td class="text-right border-bottom-dark"><b>@Model.BAFAmount.ToString("N2")</b></td>
                                </tr>
                                <tr>
                                    <td>VATABLE SALES:</td>
                                    <td class="text-right border-bottom-dark">0.00</td>
                                </tr>
                                <tr>
                                    <td>VAT - EXEMPT SALES</td>
                                    <td class="text-right border-bottom-dark">0.00</td>
                                </tr>
                                <tr>
                                    <td>ZERO RATED SALES</td>
                                    <td class="text-right border-bottom-dark"><b>@Model.Amount.ToString("N2")</b></td>
                                </tr>
                                <tr>
                                    <td>TOTAL SALES</td>
                                    <td class="text-right border-bottom-dark"><b>@Model.Amount.ToString("N2")</b></td>
                                </tr>
                                <tr>
                                    <td>12% VAT</td>
                                    <td class="text-right border-bottom-dark">0.00</td>
                                </tr>
                            }
                            <tr style="font-size: 14px;">
                                <td><b>TOTAL AMOUNT DUE:</b></td>
                                <td class="text-right" style="border-bottom: 3px double black;"><b>@Model.Amount.ToString("N2")</b></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Footer Signatures -->
                <div class="mt-3" style="font-size: 12px;">
                    <p>We hereby certify that this Billing Statement is correct and just and the payment thereof has not been received.</p>
                    <p class="font-bold mt-2">MALAYAN MARITIME SERVICES INC.</p>
                    <p class="mt-2">BY:___________________________________</p>
                </div>
            </div>
        </div>

        <!-- Sticky Footer Buttons (No Print) -->
        <div class="flex justify-end gap-2 mt-4 no-print">
            <a asp-action="Index" class="modern-btn-secondary px-5">
                <span class="material-symbols-outlined">arrow_back</span> BACK TO LIST
            </a>
            <button onclick="window.print()" class="modern-btn-primary px-5">
                <span class="material-symbols-outlined">print</span> PRINT NOW
            </button>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // No specific JS needed for preview currently
        });
    </script>
}

