@model Billing

@{
    ViewData["Title"] = "Billing - Edit";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <form id="myForm" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="MsapBillingId" id="billingId" value="@Model.MsapBillingId" type="hidden">
        <input type="hidden" asp-for="IsUndocumented" value="@Model.IsUndocumented" />

        <main class="modern-container">
            <!-- Header -->
            <div class="flex-stack">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="modern-label">MSAP</span>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <a class="modern-label" style="text-decoration:none;" asp-action="Index">Billing</a>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <span class="modern-label" style="color: var(--on-surface)">@Model.MsapBillingNumber</span>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <span class="modern-label" style="color: var(--on-surface)">Edit</span>
                    </div>
                    <h1 class="modern-headline-lg">Edit Billing: @Model.MsapBillingNumber</h1>
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="modern-btn-primary" id="submitButton">
                        <span class="material-symbols-outlined">save</span> SAVE CHANGES
                    </button>
                    <a class="modern-btn-secondary" asp-action="Index">
                        <span class="material-symbols-outlined">arrow_back</span> BACK
                    </a>
                </div>
            </div>

            <div class="modern-grid">
                <!-- Left Column: Metadata & Selection -->
                <div class="modern-col-4 flex flex-column" style="gap: 1.5rem;">
                    <!-- Customer Sidebar (Read-only during Edit) -->
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">person</span>
                            <h2 class="modern-headline-md">1. Customer Details</h2>
                        </div>
                        <div class="modern-card-body" style="gap: 1.25rem;">
                            <!-- Customer Display -->
                            <div>
                                <label class="modern-label">Customer</label>
                                <p class="modern-value-lg text-primary">@(Model.Customers?.FirstOrDefault(c => c.Value == Model.CustomerId.ToString())?.Text ?? "N/A")</p>
                                <input type="hidden" asp-for="CustomerId" id="CustomerId" value="@Model.CustomerId" />
                            </div>

                            <!-- Principal Related (Conditional Rendering) -->
                            <div id="PrincipalMasterContainer" style="display: @(ViewData["HasPrincipal"] as bool? == true ? "block" : "none")">
                                <!-- Bill to Principal Toggle -->
                                <div id="PrincipalCheckboxContainer" class="bg-surface-container-low p-3 rounded-md border border-outline-variant">
                                    <div class="flex items-center gap-3">
                                        <input type="checkbox" id="UsePrincipalCheckbox" class="form-check-input" style="width: 18px; height: 18px; cursor: pointer;" @(Model.PrincipalId.HasValue ? "checked" : "")>
                                        <label class="modern-label mb-0 cursor-pointer" for="UsePrincipalCheckbox">BILL TO PRINCIPAL</label>
                                    </div>
                                </div>

                                <!-- Principal Selection -->
                                <div id="PrincipalSection" class="relative border-t border-outline-variant pt-3 mt-3" style="display: @(Model.PrincipalId.HasValue ? "block" : "none")">
                                    <label class="modern-label">Principal Search</label>
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute" style="left: 12px; top: 50%; transform: translateY(-50%); color: var(--on-surface-variant); font-size: 20px;">corporate_fare</span>
                                        <input type="text" id="PrincipalSearch" class="modern-input" style="padding-left: 40px;" placeholder="Search principals..." value="@(Model.CustomerPrincipal?.FirstOrDefault(p => p.Value == Model.PrincipalId?.ToString())?.Text ?? "")" autocomplete="off">
                                    </div>
                                    <input type="hidden" asp-for="PrincipalId" id="PrincipalId" value="@Model.PrincipalId" />
                                    <div id="PrincipalSearchResults" class="modern-dropdown-menu w-full" style="max-height: 200px; overflow-y: auto;"></div>
                                    
                                    <div id="BilledToContainer" class="mt-3" style="display: @(Model.PrincipalId.HasValue ? "block" : "none")">
                                        <label class="modern-label">Target Account</label>
                                        <div class="radio-group">
                                            <input type="radio" class="radio-tab-input" asp-for="BilledTo" value="LOCAL" id="billLocal">
                                            <label class="radio-tab-label" for="billLocal">LOCAL</label>

                                            <input type="radio" class="radio-tab-input" asp-for="BilledTo" value="PRINCIPAL" id="billPrincipal">
                                            <label class="radio-tab-label" for="billPrincipal">PRINCIPAL</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Customer Metadata -->
                            <div id="CustomerDetailsSection" class="border-t border-outline-variant pt-3" style="gap: 1rem; display: flex; flex-direction: column;">
                                <div>
                                    <p class="modern-label">Address</p>
                                    <p id="CustomerAddress" class="modern-value-md">@(ViewData["CustomerAddress"] ?? "-")</p>
                                </div>
                                <div class="modern-grid-compact">
                                    <div class="modern-col-6">
                                        <p class="modern-label">TIN</p>
                                        <p id="CustomerTIN" class="modern-value-md font-bold">@(ViewData["CustomerTIN"] ?? "-")</p>
                                    </div>
                                    <div class="modern-col-6">
                                        <p class="modern-label">Terms</p>
                                        <p id="CustomerTerms" class="modern-value-md font-bold">@(ViewData["CustomerTerms"] ?? "-")</p>
                                    </div>
                                </div>
                                <div class="modern-grid-compact">
                                    <div class="modern-col-6">
                                        <p class="modern-label">VAT Type</p>
                                        <p id="CustomerVatType" class="modern-value-md">@(ViewData["CustomerVatType"] ?? "-")</p>
                                    </div>
                                    <div class="modern-col-6">
                                        <p class="modern-label">Doc Type</p>
                                        <p id="CustomerType" class="modern-value-md">@(ViewData["CustomerType"] ?? "-")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Operation Configuration -->
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">settings</span>
                            <h2 class="modern-headline-md">2. Billing Details</h2>
                        </div>
                        <div class="modern-card-body" style="gap: 1rem;">
                            <div>
                                <label class="modern-label">Billing #</label>
                                <input asp-for="MsapBillingNumber" type="text" class="modern-input" readonly style="background-color: var(--surface-container-low)">
                            </div>

                            <div class="modern-grid-compact">
                                <div class="modern-col-6">
                                    <label class="modern-label">Tax Status</label>
                                    <div class="flex items-center gap-2 border border-outline-variant rounded-md px-3" style="height: 38px;">
                                        <input asp-for="IsVatable" type="checkbox" class="form-check-input" id="isVatableToggle">
                                        <span class="text-xs font-bold opacity-70">VATABLE</span>
                                    </div>
                                </div>
                                <div class="modern-col-6">
                                    <label class="modern-label">Date</label>
                                    <input asp-for="Date" type="date" class="modern-input" value="@Model.Date.ToString("yyyy-MM-dd")">
                                </div>
                            </div>

                            <div class="modern-grid-compact border-t border-outline-variant pt-3">
                                <div class="modern-col-12">
                                    <label class="modern-label">Voyage #</label>
                                    <input asp-for="VoyageNumber" type="text" class="modern-input" id="VoyageNumber" required>
                                </div>
                            </div>

                            <div class="border-t border-outline-variant pt-3 flex flex-column" style="gap: 1rem;">
                                <div>
                                    <label class="modern-label">Port</label>
                                    <select asp-for="PortId" asp-items="@Model.Ports" id="PortSelect" class="js-modern-select" data-placeholder="Select Port..." data-searchable="true">
                                        <option value="">-- Select Port --</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="modern-label">Terminal</label>
                                    <select asp-for="TerminalId" asp-items="@Model.Terminals" id="TerminalSelect" class="js-modern-select" data-placeholder="Select Terminal..." data-searchable="true">
                                        <option value="">-- Select Terminal --</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="modern-label">Vessel</label>
                                    <select asp-for="VesselId" asp-items="@Model.Vessels" class="js-modern-select" data-placeholder="Select Vessel..." data-searchable="true">
                                        <option value="">-- Select Vessel --</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="modern-label">AP Other Tug</label>
                                    <input asp-for="ApOtherTug" step="0.01" type="number" class="modern-input" min="0" placeholder="0.00">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Data Entry -->
                <div class="modern-col-8 flex flex-column" style="gap: 1.5rem;">
                    <div class="modern-card">
                        <div class="modern-card-header-info">
                            <span class="material-symbols-outlined">receipt_long</span>
                            <h2 class="modern-headline-md">3. Job Order & Tickets Selection</h2>
                        </div>
                        <div class="modern-card-body">
                            <div asp-validation-summary="ModelOnly" class="text-error mb-2"></div>

                            <!-- Job Order Selection -->
                            <div class="mb-4">
                                <div class="flex items-center justify-between mb-1">
                                    <label class="modern-label mb-0">Add More Tickets (Search Job Order)</label>
                                    <div class="flex items-center gap-2">
                                        <input type="checkbox" id="legacyToggle" class="form-check-input" style="width: 16px; height: 16px; cursor: pointer;">
                                        <label for="legacyToggle" class="text-xs font-bold opacity-70 cursor-pointer">LEGACY (NO JO)</label>
                                    </div>
                                </div>
                                <div class="relative" id="jobOrderSearchContainer">
                                    <div class="relative">
                                        <span class="material-symbols-outlined absolute" style="left: 12px; top: 50%; transform: translateY(-50%); color: var(--on-surface-variant); font-size: 20px;">tag</span>
                                        <input type="text" id="JobOrderSearch" class="modern-input" style="padding-left: 40px;" placeholder="Search job order number..." autocomplete="off">
                                    </div>
                                    <input type="hidden" asp-for="JobOrderId" id="JobOrderId" />
                                    <div id="JobOrderSearchResults" class="modern-dropdown-menu w-full" style="max-height: 250px; overflow-y: auto;"></div>
                                </div>
                                <div id="legacyNotice" class="p-3 bg-surface-container-low rounded-md border border-outline-variant flex items-center gap-2" style="display: none;">
                                    <span class="material-symbols-outlined text-warning">info</span>
                                    <p class="text-xs mb-0">Legacy mode enabled. Click the button below to load all unbilled tickets without a Job Order.</p>
                                    <button type="button" class="modern-btn-secondary py-1 px-3 ml-auto" style="height: 28px; font-size: 10px;" id="loadLegacyTicketsBtn">LOAD TICKETS</button>
                                </div>
                            </div>

                            <!-- Tickets Table -->
                            <div class="modern-table-container border border-outline-variant">
                                <table id="ticketsTable" class="modern-table">
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="width: 48px;">
                                                <input type="checkbox" id="selectAllTickets" class="form-check-input" style="width: 18px; height: 18px; cursor: pointer;">
                                            </th>
                                            <th>DISPATCH #</th>
                                            <th>TUGBOAT</th>
                                            <th>SERVICE</th>
                                            <th class="text-center">HOURS</th>
                                            <th class="text-right">NET AMOUNT</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="text-muted">
                                            <td colspan="6" class="text-center py-5">
                                                <span class="material-symbols-outlined opacity-20" style="font-size: 48px;">info</span>
                                                <p class="mt-2">Loading billed tickets...</p>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Hidden select for form submission -->
                            <select asp-for="ToBillDispatchTickets" id="DispatchTicketSelect" name="ToBillDispatchTickets" multiple="multiple" style="display: none;">
                                @if (Model.ToBillDispatchTickets != null)
                                {
                                    foreach (var ticketId in Model.ToBillDispatchTickets)
                                    {
                                        <option value="@ticketId" selected="selected">@ticketId</option>
                                    }
                                }
                            </select>

                            <!-- Financial Summary Card (Calculated Totals) -->
                            <div class="financial-summary-card mt-4">
                                <div class="financial-item">
                                    <span class="financial-label">Total Dispatch</span>
                                    <span class="financial-value primary">₱<span id="DispatchAmountTotal">0.00</span></span>
                                </div>
                                <div class="financial-divider"></div>
                                <div class="financial-item">
                                    <span class="financial-label">Total BAF</span>
                                    <span class="financial-value primary">₱<span id="BAFAmountTotal">0.00</span></span>
                                </div>
                                <div class="financial-divider"></div>
                                <div class="financial-item">
                                    <span class="financial-label">Grand Total</span>
                                    <span class="financial-value secondary">₱<span id="OverallTotal">0.00</span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const currentCustomerId = $("#CustomerId").val();
            const billingId = $("#billingId").val();
            setupEventListeners();
            fillDataOnStartup();

            function setupEventListeners() {
                $("#UsePrincipalCheckbox").on("change", handleUsePrincipalChange);
                $("#PortSelect").on("change", handlePortChange);
                $("#legacyToggle").on("change", handleLegacyToggleChange);
                $("#loadLegacyTicketsBtn").on("click", fetchTicketsByCustomer);
                $("#submitButton").on("click", areYouSureToBill);
                $(window).on('scroll resize', () => $('.modern-dropdown-menu.show').removeClass('show'));
            }

            function handleLegacyToggleChange() {
                const isChecked = $(this).is(":checked");
                if (isChecked) {
                    $("#jobOrderSearchContainer").hide();
                    $("#legacyNotice").show();
                } else {
                    $("#jobOrderSearchContainer").show();
                    $("#legacyNotice").hide();
                }
            }

            async function fetchTicketsByCustomer() {
                if (!currentCustomerId) return;
                const $btn = $("#loadLegacyTicketsBtn");
                $btn.prop("disabled", true).text("LOADING...");
                
                try {
                    const res = await fetch(`@Url.Action("GetDispatchTicketsByCustomer", "Billing", new { area = "User" })?customerId=${encodeURIComponent(currentCustomerId)}`);
                    const response = await res.json();
                    if (response.success) {
                        // Merge with existing tickets
                        let existingIds = [];
                        $ticketsTableBody.find('tr[data-ticket-id]').each(function() {
                            existingIds.push($(this).data('ticket-id').toString());
                        });

                        let added = 0;
                        response.tickets.forEach(ticket => {
                            if (!existingIds.includes(ticket.dispatchTicketId.toString())) {
                                $ticketsTableBody.append(`
                                    <tr data-ticket-id="${ticket.dispatchTicketId}" data-dispatch-amount="${ticket.dispatchAmount}" data-baf-amount="${ticket.bafAmount}">
                                        <td class="text-center"><input type="checkbox" class="form-check-input ticket-checkbox" value="${ticket.dispatchTicketId}" checked style="width: 18px; height: 18px; cursor: pointer;"></td>
                                        <td class="font-bold">${ticket.dispatchNo}</td>
                                        <td>${ticket.tugboat}</td>
                                        <td>${ticket.service}</td>
                                        <td class="text-center">${ticket.duration.toFixed(2)}</td>
                                        <td class="text-right font-bold">₱${formatNumber(ticket.totalAmount)}</td>
                                    </tr>
                                `);
                                if (!$dispatchSelect.find(`option[value="${ticket.dispatchTicketId}"]`).length) {
                                    $dispatchSelect.append($('<option>').val(ticket.dispatchTicketId).text(ticket.dispatchNo).prop('selected', true));
                                }
                                added++;
                            }
                        });
                        updateTotals();
                        if (added > 0) toastr.success(`Added ${added} tickets.`);
                        else toastr.info("No new tickets found.");
                    }
                } catch {
                    Swal.fire('Error', 'Failed to load tickets', 'error');
                } finally {
                    $btn.prop("disabled", false).text("LOAD TICKETS");
                }
            }

            function positionDropdown($input, $results) {
                const rect = $input[0].getBoundingClientRect();
                $results.css({
                    'position': 'fixed',
                    'top': (rect.bottom + 4) + 'px',
                    'left': rect.left + 'px',
                    'width': rect.width + 'px',
                    'z-index': '9999'
                });
            }

            async function fillDataOnStartup() {
                // Initialize "Billed To" radio
                const initialBilledTo = '@Model.BilledTo';
                if (initialBilledTo === 'PRINCIPAL') $("#billPrincipal").prop("checked", true);
                else $("#billLocal").prop("checked", true);

                // Initialize Job Order if available
                const initialJobOrderName = '@(Model.JobOrder?.JobOrderNumber ?? "")';
                const initialJobOrderId = '@Model.JobOrderId';
                if (initialJobOrderName) {
                    $("#JobOrderSearch").val(initialJobOrderName);
                    $("#JobOrderId").val(initialJobOrderId);
                }

                // Load already billed tickets into the table
                if (currentCustomerId && billingId) {
                    try {
                        const res = await fetch('@Url.Action("GetDispatchTickets", "Billing", new { area = "User" })', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: `dispatchTicketIds=${$("#DispatchTicketSelect").val().join('&dispatchTicketIds=')}`
                        });
                        const data = await res.json();
                        renderTicketsTable(data.data.map(t => ({
                            dispatchTicketId: t.dispatchTicketId,
                            dispatchNo: t.dispatchNumber,
                            tugboat: t.tugboat?.tugboatName || 'N/A',
                            service: t.service?.serviceName || 'N/A',
                            duration: t.totalHours,
                            dispatchAmount: t.dispatchNetRevenue,
                            bafAmount: t.bafNetRevenue,
                            totalAmount: t.totalBilling
                        })));
                    } catch (e) { console.error('Error loading initial tickets', e); }
                }
            }

            function handleUsePrincipalChange() {
                const isChecked = $("#UsePrincipalCheckbox").is(":checked");
                if (isChecked) {
                    $("#PrincipalSection").show();
                    $("#BilledToContainer").show();
                    setTimeout(() => $("#PrincipalSearch").focus(), 100);
                } else {
                    $("#PrincipalSection").hide();
                    $("#PrincipalSearch").val("");
                    $("#PrincipalId").val("");
                    $("#BilledToContainer").hide();
                    $("#billLocal").prop("checked", true);
                }
            }

            // ── Principal search ─────────────────────────────────────────────
            let principalSearchTimeout;
            const $principalSearch = $("#PrincipalSearch");
            const $principalResults = $("#PrincipalSearchResults");
            const $principalId = $("#PrincipalId");

            async function performPrincipalSearch(searchTerm) {
                if (!currentCustomerId) return;
                try {
                    const params = new URLSearchParams({ customerId: currentCustomerId });
                    params.set('term', searchTerm);
                    const res = await fetch(`@Url.Action("SearchPrincipals", "Billing", new { area = "User" })?${params}`);
                    const data = await res.json();
                    $principalResults.empty();
                    if (Array.isArray(data) && data.length > 0) {
                        data.forEach(item => {
                            $principalResults.append(
                                $('<a href="#" class="modern-dropdown-item">')
                                    .data('principal', item)
                                    .html(`<span>${item.name}</span>`)
                            );
                        });
                    } else {
                        $principalResults.append($('<div class="p-3 text-center italic opacity-60 text-xs">No principals found</div>'));
                    }
                    positionDropdown($principalSearch, $principalResults);
                    $principalResults.addClass('show');
                } catch {
                    $principalResults.empty().removeClass('show');
                }
            }

            $principalSearch.on('input', function () {
                clearTimeout(principalSearchTimeout);
                const searchTerm = $(this).val().trim();
                if (searchTerm.length === 0) $principalId.val('');
                principalSearchTimeout = setTimeout(() => performPrincipalSearch(searchTerm), 150);
            });

            $principalSearch.on('focus', function () {
                if (currentCustomerId) performPrincipalSearch($(this).val().trim());
            });

            $principalResults.on('click', '.modern-dropdown-item', function (e) {
                e.preventDefault();
                const principal = $(this).data('principal');
                $principalSearch.val(principal.name);
                $principalId.val(principal.value);
                $principalResults.empty().removeClass('show');

                fetch('@Url.Action("GetPrincipalDetails", "Billing", new { area = "User" })?principalId=' + principal.value)
                    .then(r => r.json())
                    .then(data => {
                        $("#CustomerAddress").text(data.address || '-');
                        $("#CustomerTIN").text(data.tinNo || '-');
                        $("#CustomerTerms").text(data.terms || '-');
                    });
            });

            // ── Job Order search ─────────────────────────────────────────────
            let jobOrderSearchTimeout;
            const $jobOrderSearch = $("#JobOrderSearch");
            const $jobOrderResults = $("#JobOrderSearchResults");
            const $jobOrderId = $("#JobOrderId");
            const $ticketsTableBody = $("#ticketsTable tbody");
            const $dispatchSelect = $("#DispatchTicketSelect");

            async function performJobOrderSearch(searchTerm) {
                if (!currentCustomerId) return;
                try {
                    const res = await fetch(`@Url.Action("SearchJobOrders", "Billing", new { area = "User" })?customerId=${encodeURIComponent(currentCustomerId)}&term=${encodeURIComponent(searchTerm)}`);
                    const data = await res.json();
                    $jobOrderResults.empty();
                    if (Array.isArray(data) && data.length > 0) {
                        data.forEach(item => {
                            $jobOrderResults.append(
                                $('<a href="#" class="modern-dropdown-item">')
                                    .data('jobOrder', item)
                                    .html(`<div><p class="font-bold">${item.name}</p><p class="text-xs opacity-60">${item.description || ''}</p></div>`)
                            );
                        });
                    } else {
                        $jobOrderResults.append($('<div class="p-3 text-center italic opacity-60 text-xs">No job orders found</div>'));
                    }
                    positionDropdown($jobOrderSearch, $jobOrderResults);
                    $jobOrderResults.addClass('show');
                } catch {
                    $jobOrderResults.empty().removeClass('show');
                }
            }

            $jobOrderSearch.on('input', function () {
                clearTimeout(jobOrderSearchTimeout);
                const searchTerm = $(this).val().trim();
                jobOrderSearchTimeout = setTimeout(() => performJobOrderSearch(searchTerm), 150);
            });

            $jobOrderSearch.on('focus click', function () {
                if (currentCustomerId) performJobOrderSearch($(this).val().trim());
            });

            $jobOrderResults.on('click', '.modern-dropdown-item', async function (e) {
                e.preventDefault();
                const jobOrder = $(this).data('jobOrder');
                $jobOrderSearch.val(jobOrder.name);
                $jobOrderId.val(jobOrderId.value);
                $jobOrderResults.empty().removeClass('show');
                try {
                    const res = await fetch(`@Url.Action("GetDispatchTicketsByJobOrder", "Billing", new { area = "User" })?jobOrderId=${encodeURIComponent(jobOrder.value)}`);
                    const response = await res.json();

                    if (response.success) {
                         // Merge with existing tickets in the table
                        let existingIds = [];
                        $ticketsTableBody.find('tr[data-ticket-id]').each(function() {
                            existingIds.push($(this).data('ticket-id').toString());
                        });

                        response.tickets.forEach(ticket => {
                            if (!existingIds.includes(ticket.dispatchTicketId.toString())) {
                                $ticketsTableBody.append(`
                                    <tr data-ticket-id="${ticket.dispatchTicketId}" data-dispatch-amount="${ticket.dispatchAmount}" data-baf-amount="${ticket.bafAmount}">
                                        <td class="text-center"><input type="checkbox" class="form-check-input ticket-checkbox" value="${ticket.dispatchTicketId}" checked style="width: 18px; height: 18px; cursor: pointer;"></td>
                                        <td class="font-bold">${ticket.dispatchNo}</td>
                                        <td>${ticket.tugboat}</td>
                                        <td>${ticket.service}</td>
                                        <td class="text-center">${ticket.duration.toFixed(2)}</td>
                                        <td class="text-right font-bold">₱${formatNumber(ticket.totalAmount)}</td>
                                    </tr>
                                `);
                                if (!$dispatchSelect.find(`option[value="${ticket.dispatchTicketId}"]`).length) {
                                    $dispatchSelect.append($('<option>').val(ticket.dispatchTicketId).text(ticket.dispatchNo).prop('selected', true));
                                }
                            }
                        });
                        updateTotals();
                    }
                } catch {
                    Swal.fire('Error', 'Failed to load tickets', 'error');
                }
            });

            function renderTicketsTable(tickets) {
                $ticketsTableBody.empty();
                if (!tickets?.length) {
                    $ticketsTableBody.html('<tr><td colspan="6" class="text-center py-5 opacity-60 italic">No tickets available</td></tr>');
                    updateTotals();
                    return;
                }
                tickets.forEach(ticket => {
                    $ticketsTableBody.append(`
                        <tr data-ticket-id="${ticket.dispatchTicketId}" data-dispatch-amount="${ticket.dispatchAmount}" data-baf-amount="${ticket.bafAmount}">
                            <td class="text-center"><input type="checkbox" class="form-check-input ticket-checkbox" value="${ticket.dispatchTicketId}" checked style="width: 18px; height: 18px; cursor: pointer;"></td>
                            <td class="font-bold">${ticket.dispatchNo}</td>
                            <td>${ticket.tugboat}</td>
                            <td>${ticket.service}</td>
                            <td class="text-center">${ticket.duration.toFixed(2)}</td>
                            <td class="text-right font-bold">₱${formatNumber(ticket.totalAmount)}</td>
                        </tr>
                    `);
                });
                updateTotals();
            }

            $ticketsTableBody.on('change', '.ticket-checkbox', function () {
                const ticketId = $(this).val();
                const $option = $dispatchSelect.find(`option[value="${ticketId}"]`);
                if ($(this).is(':checked')) {
                    if (!$option.length) $dispatchSelect.append($('<option>').val(ticketId).prop('selected', true));
                    else $option.prop('selected', true);
                } else {
                    $option.prop('selected', false);
                }
                updateTotals();
            });

            $('#selectAllTickets').on('change', function () {
                $ticketsTableBody.find('.ticket-checkbox').prop('checked', $(this).is(':checked')).trigger('change');
            });

            function updateTotals() {
                let dispatch = 0, baf = 0;
                $ticketsTableBody.find('.ticket-checkbox:checked').each(function () {
                    const $row = $(this).closest('tr');
                    dispatch += parseFloat($row.data('dispatch-amount')) || 0;
                    baf += parseFloat($row.data('baf-amount')) || 0;
                });
                const count = $ticketsTableBody.find('.ticket-checkbox:checked').length;
                $('#DispatchAmountTotal').text(formatNumber(dispatch));
                $('#BAFAmountTotal').text(formatNumber(baf));
                $('#OverallTotal').text(formatNumber(dispatch + baf));
                $('#selectedTicketCount').text(`${count} selected`);
            }

            // ── Global click ────────────────────────────────────────────────
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#PrincipalSearch, #PrincipalSearchResults, #JobOrderSearch, #JobOrderSearchResults').length) {
                    $('.modern-dropdown-menu').removeClass('show');
                }
            });

            // ── Port → Terminal cascade ──────────────────────────────────────
            async function handlePortChange() {
                try {
                    const res = await fetch(`@Url.Action("ChangeTerminal", "DispatchTicket", new { area = "User" })?portId=${encodeURIComponent($("#PortSelect").val())}`);
                    const data = await res.json();
                    const $terminalSelect = $("#TerminalSelect");
                    $terminalSelect.empty().append('<option value="">Select Terminal</option>');
                    if (Array.isArray(data)) data.forEach(item => $terminalSelect.append($('<option>').val(item.value).text(item.text)));
                    $terminalSelect.trigger('change');
                } catch {
                    console.error('Failed to load terminals');
                }
            }

            // ── Submit ───────────────────────────────────────────────────────
            function areYouSureToBill(event) {
                event.preventDefault();
                const form = document.getElementById("myForm");
                if (!form.checkValidity()) { form.reportValidity(); return; }
                if (!$("#DispatchTicketSelect").val()?.length) {
                    Swal.fire({ title: "No Tickets Selected", text: "Please select at least one dispatch ticket to bill.", icon: "warning" });
                    return;
                }
                Swal.fire({ title: "Save changes?", text: "Proceed with updating this billing?", icon: "question", showCancelButton: true, confirmButtonText: "Yes, save" })
                    .then(result => { if (result.isConfirmed) submitEditForm(); });
            }

            async function submitEditForm() {
                try {
                    const res = await fetch('@Url.Action("Edit", "Billing", new { area = "User" })', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: new URLSearchParams(new FormData(document.getElementById('myForm'))).toString()
                    });
                    const response = await res.json();
                    if (response.success) {
                        Swal.fire({ title: "Success!", text: response.message, icon: "success" })
                            .then(() => response.redirectUrl ? window.location.href = response.redirectUrl : location.reload());
                    } else {
                        Swal.fire({ title: "Error", text: response.message || "Failed to update billing.", icon: "error" });
                    }
                } catch {
                    Swal.fire({ title: "Error", text: "An error occurred while updating the billing.", icon: "error" });
                }
            }
        });
    </script>
}