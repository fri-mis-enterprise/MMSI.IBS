@model IEnumerable<IBS.Models.MSAP.Billing>

@{
    ViewData["Title"] = "Billing Statements";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <main class="modern-container">
        <!-- Header Section -->
        <div class="flex-stack">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label" style="color: var(--on-surface-variant)">MSAP</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">Billing</span>
                </div>
                <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2">
                <a asp-action="Create" class="modern-btn-primary">
                    <span class="material-symbols-outlined">add_circle</span>
                    CREATE BILLING
                </a>
            </div>
        </div>

        <!-- Filter Group -->
        <div class="flex flex-wrap gap-2">
            <button id="filterAll" class="modern-btn-secondary active">ALL</button>
            <button id="filterForPosting" class="modern-btn-secondary">FOR POSTING</button>
            <button id="filterForCollection" class="modern-btn-secondary">FOR COLLECTION</button>
            <button id="filterCollected" class="modern-btn-secondary">COLLECTED</button>
        </div>

        <!-- Table Card -->
        <div class="modern-card">
            <div class="modern-card-header-action">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">receipt_long</span>
                    <h2 class="modern-headline-md">Billing List</h2>
                </div>
            </div>
            <div class="modern-card-body">
                <table class="modern-table" id="paginatedTable">
                    <thead>
                        <tr>
                            <th>DATE</th>
                            <th>BILLING #</th>
                            <th>AMOUNT</th>
                            <th>CUSTOMER</th>
                            <th>PORT - TERMINAL</th>
                            <th>VESSEL</th>
                            <th class="text-center">STATUS</th>
                            <th class="text-center">ACTIONS</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </main>
</div>

<style>
    .modern-btn-secondary.active {
        background-color: var(--primary);
        color: white;
        border-color: var(--primary);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            const previewUrl = '@Url.Action("Preview", "Billing")';
            const editUrl = '@Url.Action("Edit", "Billing")';

            // Get status from URL on load
            const urlParams = new URLSearchParams(window.location.search);
            const statusFilter = urlParams.get('status') || '';

            let table = $('#paginatedTable').DataTable({
                dom: '<"flex-stack mb-2"lf><"modern-table-container"t><"flex-stack mt-2"ip>',
                "order": [[1, 'asc']],
                "columnDefs": [
                    { "orderable": false, "targets": [7] }
                ],
                "processing": true,
                "serverSide": true,
                "pageLength": 25,
                "language": {
                    "search": "",
                    "searchPlaceholder": "Search records...",
                    "lengthMenu": "_MENU_ per page",
                    "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                },
                "ajax": {
                    "url": "@Url.Action("GetBillingList", "Billing", new { area = "User" })",
                    "type": "POST",
                    "data": function (d) {
                        return $.extend({}, d, {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        });
                    }
                },
                "columns": [
                    { "data": "date" },
                    {
                        "data": "msapBillingNumber",
                        "render": function(data, type, row) {
                            return `<span class="font-bold">${data}</span>`;
                        }
                    },
                    {
                        "data": "amount",
                        "className": "text-right",
                        "render": function(data, type, row) {
                            return `<span class="font-bold">₱${formatNumber(data)}</span>`;
                        }
                    },
                    { "data": "customer.customerName" },
                    {
                        "data": null,
                        "orderable": false,
                        "render": function (data, type, row) {
                            const portName = row.terminal?.port?.portName ?? "";
                            const terminalName = row.terminal?.terminalName ?? "";
                            return portName || terminalName ? `${portName} - ${terminalName}` : "";
                        }
                    },
                    { "data": "vessel.vesselName" },
                    {
                        "data": "status",
                        "className": "text-center",
                        "render": function(data, type, row) {
                            let statusClass = "status-open";
                            if (data === "@SD.BillingStatus.ForPosting") statusClass = "status-tariff";
                            if (data === "@SD.BillingStatus.ForCollection") statusClass = "status-approval";
                            if (data === "@SD.BillingStatus.Collected") statusClass = "status-closed";
                            return `<span class="modern-badge ${statusClass}">${data}</span>`;
                        }
                    },
                    {
                        "data": null,
                        "orderable": false,
                        "className": "text-center",
                        "render": function(data, type, row) {
                            const postUrl = '@Url.Action("Post", "Billing")';

                            if (row.status === "@SD.BillingStatus.ForPosting") {
                                return `
                                    <div class="relative inline-block text-left dropdown-container">
                                        <button type="button" class="modern-btn-dropdown dropdown-trigger">
                                            POST <span class="material-symbols-outlined" style="font-size:16px">arrow_drop_down</span>
                                        </button>
                                        <div class="modern-dropdown-menu dropdown-menu">
                                            <a class="modern-dropdown-item" href="${postUrl}?id=${row.msapBillingId}">
                                                <span class="material-symbols-outlined">send</span> Post to Books
                                            </a>
                                            <a class="modern-dropdown-item" href="${editUrl}?id=${row.msapBillingId}">
                                                <span class="material-symbols-outlined">edit</span> Edit
                                            </a>
                                            <a class="modern-dropdown-item text-error" href="javascript:void(0)" onclick="confirmDelete(${row.msapBillingId})">
                                                <span class="material-symbols-outlined">delete</span> Delete
                                            </a>
                                        </div>
                                    </div>`;
                            } else if (row.status === "@SD.BillingStatus.ForCollection") {
                                return `
                                    <div class="relative inline-block text-left dropdown-container">
                                        <button type="button" class="modern-btn-dropdown dropdown-trigger">
                                            ACTIONS <span class="material-symbols-outlined" style="font-size:16px">arrow_drop_down</span>
                                        </button>
                                        <div class="modern-dropdown-menu dropdown-menu">
                                            <a class="modern-dropdown-item" href="${previewUrl}?id=${row.msapBillingId}">
                                                <span class="material-symbols-outlined">visibility</span> View Details
                                            </a>
                                            <a class="modern-dropdown-item" href="${editUrl}?id=${row.msapBillingId}">
                                                <span class="material-symbols-outlined">edit</span> Edit Billing
                                            </a>
                                        </div>
                                    </div>`;
                            } else {
                                return `<a class="modern-btn-secondary" style="padding: 4px 12px; font-size: 11px;" href="${previewUrl}?id=${row.msapBillingId}">
                                            <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span> VIEW
                                        </a>`;
                            }
                        }
                    }
                ],
                "initComplete": function(settings, json) {
                    if (statusFilter) {
                        this.api().column(6).search(statusFilter).draw();
                        updateFilterButtons(statusFilter);
                    }
                }
            });

            // Dropdown toggle logic
            $(document).on('click', '.dropdown-trigger', function(e) {
                e.stopPropagation();
                const $trigger = $(this);
                const $menu = $trigger.siblings('.modern-dropdown-menu');

                $('.modern-dropdown-menu').not($menu).removeClass('show');
                $menu.toggleClass('show');

                if ($menu.hasClass('show')) {
                    const rect = $trigger[0].getBoundingClientRect();
                    const menuWidth = $menu.outerWidth();

                    $menu.css({
                        'position': 'fixed',
                        'top': (rect.bottom + 4) + 'px',
                        'left': (rect.right - menuWidth) + 'px',
                        'z-index': '9999'
                    });

                    const menuHeight = $menu.outerHeight();
                    if (rect.bottom + menuHeight > window.innerHeight) {
                        $menu.css('top', (rect.top - menuHeight - 4) + 'px');
                    }
                }
            });

            $(document).on('click', function() {
                $('.modern-dropdown-menu').removeClass('show');
            });

            function updateUrl(status) {
                const url = new URL(window.location);
                if (status) {
                    url.searchParams.set('status', status);
                } else {
                    url.searchParams.delete('status');
                }
                window.history.replaceState({}, '', url);
            }

            function updateFilterButtons(status) {
                $('.modern-btn-secondary').removeClass('active');
                if (!status) $('#filterAll').addClass('active');
                else if (status === "@SD.BillingStatus.ForPosting") $('#filterForPosting').addClass('active');
                else if (status === "@SD.BillingStatus.ForCollection") $('#filterForCollection').addClass('active');
                else if (status === "@SD.BillingStatus.Collected") $('#filterCollected').addClass('active');
            }

            $('#filterAll').on('click', function() {
                table.columns(6).search('').draw();
                updateUrl('');
                updateFilterButtons('');
            });

            $('#filterForPosting').on('click', function() {
                const status = "@SD.BillingStatus.ForPosting";
                table.columns(6).search(status).draw();
                updateUrl(status);
                updateFilterButtons(status);
            });

            $('#filterForCollection').on('click', function() {
                const status = "@SD.BillingStatus.ForCollection";
                table.columns(6).search(status).draw();
                updateUrl(status);
                updateFilterButtons(status);
            });

            $('#filterCollected').on('click', function() {
                const status = "@SD.BillingStatus.Collected";
                table.columns(6).search(status).draw();
                updateUrl(status);
                updateFilterButtons(status);
            });
        });

        function confirmDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "This will delete the draft billing and return all dispatch tickets to the queue.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ba1a1a',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("Delete", "Billing")?id=' + id;
                }
            });
        }
    </script>
}


