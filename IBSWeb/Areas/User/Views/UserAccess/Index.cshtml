@{
    ViewData["Title"] = "User Access Management";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <main class="modern-container">
        <!-- Header Section -->
        <div class="flex-stack">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label" style="color: var(--on-surface-variant)">GENERAL</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">User Access</span>
                </div>
                <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2">
                <a asp-area="User" asp-controller="UserAccess" asp-action="Create" class="modern-btn-primary">
                    <span class="material-symbols-outlined">add_circle</span>
                    CREATE NEW
                </a>
            </div>
        </div>

        <!-- Table Card -->
        <div class="modern-card">
            <div class="modern-card-header-action flex justify-between items-center w-full">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">security</span>
                    <h2 class="modern-headline-md">Access List</h2>
                </div>
            </div>
            <div class="modern-card-body">
                <table class="modern-table" id="userAccessTable">
                    <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Username</th>
                        <th class="text-center">Actions</th>
                    </tr>
                    </thead>
                </table>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const editUrl = '@Url.Action("Edit", "UserAccess", new { area = "User" })';

            $('#userAccessTable').DataTable(ModernTable.config({
                ajax: ModernTable.ajax("@Url.Action("GetUserAccessList", "UserAccess", new { area = "User" })"),
                columns: [
                    { data: "userId" },
                    { 
                        data: "userName",
                        render: (data) => `<span class="font-bold">${data}</span>`
                    },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: (data, type, row) => ModernTable.render.dropdown([
                            { label: 'Edit Access', icon: 'edit', url: `${editUrl}?id=${row.id}` }
                        ])
                    }
                ],
                order: [[1, 'asc']]
            }));
        });
    </script>
}
