@model IEnumerable<IBS.Models.MSAP.DispatchTicket>

@{
    ViewData["Title"] = "Service Requests";
    ViewData["IsFullWidth"] = true;
}

<div class="modern-layout">
    <main class="modern-container">
        <div class="flex-stack">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="modern-label" style="color: var(--on-surface-variant)">MSAP</span>
                    <span class="material-symbols-outlined text-xs">chevron_right</span>
                    <span class="modern-label" style="color: var(--on-surface)">Service Requests</span>
                </div>
                <h1 class="modern-headline-lg">@ViewData["Title"]</h1>
            </div>
            <div class="flex gap-2">
                <a asp-action="Create" class="modern-btn-primary">
                    <span class="material-symbols-outlined">add_circle</span>
                    CREATE REQUEST
                </a>
            </div>
        </div>

        <div class="flex flex-wrap gap-2">
            <button id="filterAll" class="modern-btn-secondary active">ALL</button>
            <button id="filterRequested" class="modern-btn-secondary">REQUESTED</button>
            <button id="filterDraft" class="modern-btn-secondary">DRAFT</button>
            <button id="filterCancelled" class="modern-btn-secondary" style="color: var(--error); border-color: var(--error);">
                <span class="material-symbols-outlined" style="font-size:16px; vertical-align: middle;">cancel</span> CANCELLED
            </button>
        </div>

        <div class="modern-card">
            <div class="modern-card-header-action flex justify-between items-center w-full">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">assignment</span>
                    <h2 class="modern-headline-md">Request List</h2>
                </div>
                <div class="flex items-center gap-2">
                    <label class="modern-label mb-0" style="color: var(--on-surface-variant)">Filter by Date:</label>
                    <input type="date" id="dateFilter" class="modern-input" style="height: 32px; padding: 0 12px; font-size: 0.875rem; border-radius: 6px;">
                </div>
            </div>
            <div class="modern-card-body">
                <div class="modern-table-container">
                    <table class="modern-table" id="paginatedTable">
                        <thead>
                            <tr>
                                <th data-orderable="false" class="text-center" style="width: 40px;"><input type="checkbox" id="selectAll"></th>
                                <th>Date</th>
                                <th>COS #</th>
                                <th>Ticket #</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Activity/Service</th>
                                <th>Port - Terminal</th>
                                <th>Tugboat</th>
                                <th>Customer</th>
                                <th>Vessel</th>
                                <th class="text-center">Status</th>
                                <th class="text-center" style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                    </table>
                </div>

                <div class="flex justify-end gap-2 mt-3">
                    <button class="modern-btn-primary selected-options" id="postSelected" style="display:none">
                        <span class="material-symbols-outlined">check_circle</span> POST SELECTED
                    </button>
                    <button class="modern-btn-secondary selected-options" id="cancelSelected" style="display:none; color: var(--error); border-color: var(--error);">
                        <span class="material-symbols-outlined">cancel</span> CANCEL SELECTED
                    </button>
                </div>
            </div>
        </div>
    </main>
</div>

<style>
    .modern-btn-secondary.active {
        background-color: var(--primary);
        color: white;
        border-color: var(--primary);
    }
</style>

@section Scripts {
    <script>
        const selectedRecords = new Set();

        function toggleSelectAll(selectAllCheckbox) {
            const checkboxes = document.querySelectorAll(".selectCheckbox");
            checkboxes.forEach(checkbox => {
                checkbox.checked = selectAllCheckbox.checked;
                if (selectAllCheckbox.checked) selectedRecords.add(checkbox.value);
                else selectedRecords.delete(checkbox.value);
            });
            toggleButtons();
        }

        function toggleButtons() {
            const anyChecked = selectedRecords.size > 0;
            $(".selected-options").toggle(anyChecked);
        }

        $(document).ready(function () {
            const editUrl = '@Url.Action("Edit", "ServiceRequest", new { area = "User" })';

            let table = $('#paginatedTable').DataTable(ModernTable.config({
                order: [[1, 'desc']],
                columnDefs: [
                    { orderable: false, targets: [0, 12] }
                ],
                ajax: ModernTable.ajax("@Url.Action("GetDispatchTicketLists", "ServiceRequest", new { area = "User" })"),
                columns: [
                    {
                        data: null,
                        orderable: false,
                        render: (data, type, row) => {
                            const isChecked = selectedRecords.has(String(row.dispatchTicketId)) ? 'checked' : '';
                            return (row.status !== "Cancelled" && row.status !== "Draft") 
                                ? `<div class="text-center"><input type="checkbox" class="selectCheckbox" value="${row.dispatchTicketId}" ${isChecked}></div>`
                                : `<div class="text-center"><input type="checkbox" disabled></div>`;
                        }
                    },
                    { data: "date", defaultContent: "" },
                    { data: "cosNumber", defaultContent: "" },
                    {
                        data: "dispatchNumber",
                        render: (data, type, row) => `<a href="${editUrl}?id=${row.dispatchTicketId}" class="font-bold" style="text-decoration:none; color: var(--primary)">${data}</a>`
                    },
                    {
                        data: null,
                        render: (data, type, row) => ModernTable.render.dateTime(row.dateLeft, row.timeLeft)
                    },
                    {
                        data: null,
                        render: (data, type, row) => ModernTable.render.dateTime(row.dateArrived, row.timeArrived)
                    },
                    { data: "service.serviceName", defaultContent: "" },
                    {
                        data: null,
                        orderable: false,
                        render: (data, type, row) => {
                            const portName = row.terminal?.port?.portName ?? "";
                            const terminalName = row.terminal?.terminalName ?? "";
                            return portName || terminalName ? `${portName} - ${terminalName}` : "";
                        }
                    },
                    { data: "tugboat.tugboatName", defaultContent: "" },
                    {
                        data: "customer.customerName",
                        render: (data, type, row) => row.customerId ? data : '<span class="text-xs opacity-60">(Not Assigned)</span>'
                    },
                    { data: "vessel.vesselName", defaultContent: "" },
                    {
                        data: "status",
                        className: "text-center",
                        render: (data) => {
                            let cls = data === "Requested" ? "status-approval" : data === "Draft" ? "status-tariff" : "status-closed";
                            return ModernTable.render.badge(data, cls);
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        className: "text-center",
                        render: (data, type, row) => {
                            const items = [];
                            if (row.status !== "Cancelled") {
                                items.push({ label: 'Edit', icon: 'edit', url: `${editUrl}?id=${row.dispatchTicketId}` });
                            }
                            if (row.imageSignedUrl) {
                                items.push({ label: 'View Image', icon: 'image', onclick: `ModernAlert.image('${row.imageSignedUrl}', 'Upload Preview')` });
                            }
                            if (row.videoSignedUrl) {
                                items.push({ label: 'Play Video', icon: 'play_circle', onclick: `ModernAlert.video('${row.videoSignedUrl}', 'Video Preview')` });
                            }
                            return ModernTable.render.dropdown(items);
                        }
                    }
                ]
            }));

            // Handlers
            $(document).on("click", "#selectAll", function () { toggleSelectAll(this); });
            $(document).on("change", ".selectCheckbox", function() {
                if (this.checked) selectedRecords.add(this.value);
                else selectedRecords.delete(this.value);
                toggleButtons();
                $("#selectAll").prop("checked", $(".selectCheckbox").length === $(".selectCheckbox:checked").length);
            });

            $("#postSelected").click(() => {
                ModernAlert.confirm({
                    title: "Post selected?",
                    text: "Proceed to post these requests?",
                    confirmText: "Yes, post"
                }).then((r) => {
                    if (r.isConfirmed) window.location.href = `@Url.Action("PostSelected", "ServiceRequest")?records=${encodeURIComponent(JSON.stringify(Array.from(selectedRecords)))}`;
                });
            });

            $("#cancelSelected").click(() => {
                ModernAlert.confirm({
                    title: "Cancel selected?",
                    text: "This action cannot be undone.",
                    icon: 'warning',
                    confirmText: "Yes, cancel"
                }).then((r) => {
                    if (r.isConfirmed) window.location.href = `@Url.Action("CancelSelected", "ServiceRequest")?records=${encodeURIComponent(JSON.stringify(Array.from(selectedRecords)))}`;
                });
            });

            // Filter logic
            $('.modern-btn-secondary[id^="filter"]').on('click', function() {
                const id = $(this).attr('id');
                let status = '';
                if (id === 'filterRequested') status = 'Requested';
                else if (id === 'filterDraft') status = 'Draft';
                else if (id === 'filterCancelled') status = 'Cancelled';

                table.column(11).search(status).draw();
                $('.modern-btn-secondary').removeClass('active');
                $(this).addClass('active');
            });

            // Date filter
            $('#dateFilter').on('change', function () {
                table.column(1).search($(this).val()).draw();
            });
        });
    </script>
}
