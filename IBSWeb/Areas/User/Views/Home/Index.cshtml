@using Microsoft.AspNetCore.Identity
@model IBS.Models.ViewModels.DashboardCountViewModel
@inject SignInManager<ApplicationUser> SignInManager

@{
    var department = ViewBag.GetUserDepartment;
    ViewData["Title"] = "Dashboard";
    var selectedCompany = string.Empty;
    var selectedStation = string.Empty;

    if (SignInManager.IsSignedIn(User))
    {
        selectedCompany = User.Claims.FirstOrDefault(c => c.Type == "Company")?.Value;
        selectedStation = User.Claims.FirstOrDefault(c => c.Type == "StationCode")?.Value;
    }
}

@if (!User.Identity!.IsAuthenticated)
{
    <div class="container">
        <div class="row justify-content-center my-5">
            <div class="col-lg-8 text-center">
                <h1 class="display-4 text-primary fw-bold">Welcome to Our Integrated Business System</h1>
                <p class="fs-5 text-muted">Effortlessly manage and optimize your business tasks.</p>
                <a class="btn btn-primary btn-lg px-4 py-3 mt-4" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="">
                    Login <i class="bi bi-box-arrow-in-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
}
else
{
    if (selectedCompany == "MMSI" && !User.IsInRole("PortCoordinator"))
    {
        <!-- Classic Dashboard (Visible when body does not have mnav-enabled class) -->
        <div class="classic-dashboard-view container">
            <div class="row justify-content-center my-5">
                <div class="col-lg-8 text-center">
                    <h1 class="display-4 text-primary fw-bold">Welcome to Our Integrated Business System</h1>
                    <p class="fs-5 text-muted">Effortlessly manage and optimize your business tasks.</p>
                    <div class="mt-5">
                        <h2 class="fw-semibold text-secondary mb-4">Tasks Overview</h2>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <a href="@Url.Action("Index", "ServiceRequest", new { area = "User", filterType = "ForPosting" })" class="text-decoration-none">
                                    <div class="card shadow-sm h-100 border-0">
                                        <div class="card-body text-center">
                                            <h5 class="card-title text-dark fw-semibold">
                                                <i class="bi bi-tools me-2 text-primary"></i>Service Request for Posting
                                            </h5>
                                            <p class="card-text display-6 text-primary fw-bold">@Model.MsapServiceRequestForPosting.ToString("N0")</p>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-4">
                                <a href="@Url.Action("Index", "DispatchTicket", new { area = "User", filterType = "ForTariff" })" class="text-decoration-none">
                                    <div class="card shadow-sm h-100 border-0">
                                        <div class="card-body text-center">
                                            <h5 class="card-title text-dark fw-semibold">
                                                <i class="bi bi-ticket-perforated-fill me-2 text-primary"></i>Dispatch Ticket for Tariff
                                            </h5>
                                            <p class="card-text display-6 text-primary fw-bold">@Model.MsapDispatchTicketForTariff.ToString("N0")</p>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-4">
                                <a href="@Url.Action("Index", "DispatchTicket", new { area = "User", filterType = "ForApproval" })" class="text-decoration-none">
                                    <div class="card shadow-sm h-100 border-0">
                                        <div class="card-body text-center">
                                            <h5 class="card-title text-dark fw-semibold">
                                                <i class="bi bi-hand-thumbs-up-fill me-2 text-primary"></i>Dispatch Ticket Tariff for Approval
                                            </h5>
                                            <p class="card-text display-6 text-primary fw-bold">@Model.MsapDispatchTicketForApproval.ToString("N0")</p>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-4">
                                <a href="@Url.Action("Index", "DispatchTicket", new { area = "User", filterType = "ForBilling" })" class="text-decoration-none">
                                    <div class="card shadow-sm h-100 border-0">
                                        <div class="card-body text-center">
                                            <h5 class="card-title text-dark fw-semibold">
                                                <i class="bi bi-receipt me-2 text-primary"></i>Dispatch Ticket for Billing
                                            </h5>
                                            <p class="card-text display-6 text-primary fw-bold">@Model.MsapDispatchTicketForBilling.ToString("N0")</p>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-4">
                                <a href="@Url.Action("Index", "Billing", new { area = "User", filterType = "ForCollection" })" class="text-decoration-none">
                                    <div class="card shadow-sm h-100 border-0">
                                        <div class="card-body text-center">
                                            <h5 class="card-title text-dark fw-semibold">
                                                <i class="bi bi-cash-coin me-2 text-primary"></i>Billing for Collection
                                            </h5>
                                            <p class="card-text display-6 text-primary fw-bold">@Model.MsapBillingForCollection.ToString("N0")</p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modern Dashboard (Visible when body has mnav-enabled class) -->
        <div class="modern-dashboard-view">
            <div class="dashboard-container">
                <!-- Banner welcome header -->
                <div class="dashboard-banner">
                    <div class="banner-welcome">
                        <h1>Good Day, <span id="modernUserName">@User.Identity?.Name</span></h1>
                        <p>Welcome to MSAP - MMSI Sales and Accounting Program. Here is your operational and financial intelligence overview.</p>
                    </div>
                    <div class="banner-date">
                        <span class="material-symbols-outlined">calendar_today</span>
                        <span id="modernCurrentDate"></span>
                    </div>
                </div>

                <!-- Attention Required Alert Bar (Hidden by default, shown by JS if alerts exist) -->
                <div id="attention-bar" class="attention-bar" style="display: none;">
                    <div class="attention-title">
                        <span class="material-symbols-outlined">warning</span>
                        <span>AWAITING ACTION:</span>
                    </div>
                    <div id="attention-badge-list" class="attention-badge-list"></div>
                </div>

                <!-- KPI Stats Grid -->
                <div class="dashboard-kpi-grid">
                    <!-- Job Orders Card -->
                    <a href="@Url.Action("Index", "JobOrder", new { area = "User" })" class="kpi-card">
                        <div class="kpi-card-header">
                            <h3 class="kpi-title">Job Orders</h3>
                            <div class="kpi-icon-wrap">
                                <span class="material-symbols-outlined">assignment</span>
                            </div>
                        </div>
                        <div class="kpi-value-row">
                            <span id="jo-total-value" class="kpi-value">0</span>
                        </div>
                        <div class="kpi-divider"></div>
                        <div class="kpi-status-list">
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #10b981;"></span>
                                    <span>Open</span>
                                </div>
                                <span id="jo-open-count" class="status-count">0</span>
                            </div>
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #64748b;"></span>
                                    <span>Closed</span>
                                </div>
                                <span id="jo-closed-count" class="status-count">0</span>
                            </div>
                        </div>
                    </a>

                    <!-- Dispatch Tickets Card -->
                    <a href="@Url.Action("Index", "DispatchTicket", new { area = "User" })" class="kpi-card">
                        <div class="kpi-card-header">
                            <h3 class="kpi-title">Dispatch Tickets</h3>
                            <div class="kpi-icon-wrap">
                                <span class="material-symbols-outlined">local_shipping</span>
                            </div>
                        </div>
                        <div class="kpi-value-row">
                            <span id="dt-total-value" class="kpi-value">0</span>
                        </div>
                        <div class="kpi-divider"></div>
                        <div class="kpi-status-list" style="max-height: 110px; overflow-y: auto;">
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #94a3b8;"></span>
                                    <span>Draft</span>
                                </div>
                                <span id="dt-draft-count" class="status-count">0</span>
                            </div>
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #0284c7;"></span>
                                    <span>Requested</span>
                                </div>
                                <span id="dt-requested-count" class="status-count">0</span>
                            </div>
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #ea580c;"></span>
                                    <span>Pending</span>
                                </div>
                                <span id="dt-pending-count" class="status-count">0</span>
                            </div>
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #eab308;"></span>
                                    <span>For Tariff</span>
                                </div>
                                <span id="dt-tariff-count" class="status-count">0</span>
                            </div>
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #8b5cf6;"></span>
                                    <span>For Approval</span>
                                </div>
                                <span id="dt-approval-count" class="status-count">0</span>
                            </div>
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #ef4444;"></span>
                                    <span>Disapproved</span>
                                </div>
                                <span id="dt-disapproved-count" class="status-count">0</span>
                            </div>
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #3b82f6;"></span>
                                    <span>For Billing</span>
                                </div>
                                <span id="dt-billing-count" class="status-count">0</span>
                            </div>
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #10b981;"></span>
                                    <span>Billed</span>
                                </div>
                                <span id="dt-billed-count" class="status-count">0</span>
                            </div>
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #dc2626;"></span>
                                    <span>Cancelled</span>
                                </div>
                                <span id="dt-cancelled-count" class="status-count">0</span>
                            </div>
                        </div>
                    </a>

                    <!-- Billings Card -->
                    <a href="@Url.Action("Index", "Billing", new { area = "User" })" class="kpi-card">
                        <div class="kpi-card-header">
                            <h3 class="kpi-title">Billings</h3>
                            <div class="kpi-icon-wrap">
                                <span class="material-symbols-outlined">receipt_long</span>
                            </div>
                        </div>
                        <div class="kpi-value-row">
                            <span id="b-total-value" class="kpi-value">0</span>
                        </div>
                        <div class="kpi-divider"></div>
                        <div class="kpi-status-list">
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #3b82f6;"></span>
                                    <span>For Posting</span>
                                </div>
                                <span id="b-posting-count" class="status-count">0</span>
                            </div>
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #ea580c;"></span>
                                    <span>For Collection</span>
                                </div>
                                <span id="b-collection-count" class="status-count">0</span>
                            </div>
                            <div id="b-collected-item" class="kpi-status-item" style="cursor: pointer; position: relative;" title="Click to toggle Count/Amount">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #10b981;"></span>
                                    <span>Collected</span>
                                    <span class="material-symbols-outlined" style="font-size: 14px; margin-left: 4px; opacity: 0.6; vertical-align: middle;">swap_horiz</span>
                                </div>
                                <span id="b-collected-count" class="status-count">0</span>
                            </div>
                        </div>
                    </a>

                    <!-- Collections Card -->
                    <a href="@Url.Action("Index", "Collection", new { area = "User" })" class="kpi-card">
                        <div class="kpi-card-header">
                            <h3 class="kpi-title">Collections</h3>
                            <div class="kpi-icon-wrap">
                                <span class="material-symbols-outlined">payments</span>
                            </div>
                        </div>
                        <div class="kpi-value-row">
                            <span id="c-total-value" class="kpi-value">0</span>
                        </div>
                        <div class="kpi-divider"></div>
                        <div class="kpi-status-list">
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #10b981;"></span>
                                    <span>Active</span>
                                </div>
                                <span id="c-active-count" class="status-count">0</span>
                            </div>
                            <div class="kpi-status-item">
                                <div class="status-bullet">
                                    <span class="bullet-dot" style="background-color: #ef4444;"></span>
                                    <span>Voided</span>
                                </div>
                                <span id="c-voided-count" class="status-count">0</span>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Main Layout Columns -->
                <div class="dashboard-main-grid">
                    <!-- Left: Trends Chart -->
                    <div class="dashboard-section-card">
                        <h2 class="dashboard-section-title">
                            <span class="material-symbols-outlined">monitoring</span>
                            <span>Billing & Collection Trends (Last 6 Months)</span>
                        </h2>
                        <div class="chart-container">
                            <div id="trend-chart"></div>
                        </div>
                    </div>

                    <!-- Right: Quick Actions & Recent Activity -->
                    <div>
                        <!-- Quick Actions Panel -->
                        <div class="dashboard-section-card quick-actions-panel">
                            <h2 class="dashboard-section-title">
                                <span class="material-symbols-outlined">bolt</span>
                                <span>Quick Actions</span>
                            </h2>
                            <div class="quick-actions-grid">
                                <a href="@Url.Action("Create", "JobOrder", new { area = "User" })" class="action-btn">
                                    <span class="material-symbols-outlined">add_task</span>
                                    <div class="action-btn-label">New Job Order</div>
                                </a>

                                <a href="@Url.Action("Create", "Billing", new { area = "User" })" class="action-btn">
                                    <span class="material-symbols-outlined">note_add</span>
                                    <div class="action-btn-label">New Billing</div>
                                </a>
                                <a href="@Url.Action("Create", "Collection", new { area = "User" })" class="action-btn">
                                    <span class="material-symbols-outlined">account_balance_wallet</span>
                                    <div class="action-btn-label">New Collection</div>
                                </a>
                            </div>
                        </div>

                        <!-- Recent Operations Activity -->
                        <div class="dashboard-section-card">
                            <h2 class="dashboard-section-title">
                                <span class="material-symbols-outlined">history</span>
                                <span>Recent Operations Activity</span>
                            </h2>
                            <div id="activity-feed-list" class="activity-feed-list">
                                <div class="text-center text-muted py-4">Loading activities...</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container text-center my-5">
            <h1 class="display-4 text-primary fw-bold">Welcome to Our Integrated Business System</h1>
            <p class="fs-5 text-muted">Effortlessly manage and optimize your business tasks.</p>
        </div>
    }
}

<style>
    .classic-dashboard-view .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background-color: #fff;
        border-radius: 0.75rem;
    }

    .classic-dashboard-view .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .classic-dashboard-view .card-title {
        font-size: 1.25rem;
        font-weight: 600;
    }

    .classic-dashboard-view .card-text {
        font-size: 2rem;
    }
</style>

@section Styles {
    <link rel="stylesheet" href="~/css/modern-dashboard.css" asp-append-version="true" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="~/js/modern-dashboard.js" asp-append-version="true"></script>
}
